.TH tustrings n 0.23.0 tclutils "Tcl Library Procedures"
.SH NAME
tustrings \-  tclutils::tustrings  extracts printable ASCII strings from binary data.
.SH SYNOPSIS
.PP
.nf
package require tclutils::tustrings
.fi
.SH COMMANDS
.PP
.nf
::tclutils::tustrings::extract data ?options?
::tclutils::tustrings::file filename ?options?
.fi
.SH OPTIONS
.IP
\fB\-minlength n\fR, default \fB4\fR
.SH EXAMPLE
.PP
.nf
set strings [::tclutils::tustrings::file test.pdf \-minlength 6]
.fi

