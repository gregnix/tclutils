.TH tusplit n 0.23.0 tclutils "Tcl Library Procedures"
.SH NAME
tusplit \- Split files or strings into smaller parts.
.SH SYNOPSIS
.PP
.nf
package require tclutils::tusplit
.fi
.SH LINE SPLITTING
.PP
.nf
set files [::tclutils::tusplit::file input.txt \-lines 1000 \-outdir parts \-prefix part \-suffix .txt]
.fi
.SH BYTE SPLITTING
.PP
.nf
set files [::tclutils::tusplit::file input.bin \-bytes 1048576 \-outdir parts \-prefix chunk]
.fi
.SH COMMANDS
.IP
\fBsplitLines text ?options?\fR
.IP
\fBsplitBytes data ?options?\fR
.IP
\fBfile path ?options?\fR
.IP
\fBlines path n ?options?\fR
.IP
\fBbytes path n ?options?\fR
.PP
Options include \fB\-lines\fR, \fB\-bytes\fR, \fB\-prefix\fR, \fB\-suffix\fR, \fB\-outdir\fR, and \fB\-digits\fR.

