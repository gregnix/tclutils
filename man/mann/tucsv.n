.TH tucsv n 0.23.0 tclutils "Tcl Library Procedures"
.SH NAME
tucsv \- Small CSV helpers written in pure Tcl.
.SH SYNOPSIS
.PP
.nf
tcl::tm::path add /path/to/tclutils/lib/tm
package require tclutils::tucsv
.fi
.SH PARSE ONE LINE
.PP
.nf
set row [::tclutils::tucsv::parseLine {a,"b,c","d""e"}]
# \-> a {b,c} {d"e}
.fi
.PP
Options:
.PP
.nf
\-delimiter ,
\-quote "
\-trim 0
.fi
.SH JOIN ONE LINE
.PP
.nf
set line [::tclutils::tucsv::joinLine [list a {b,c} {d"e}]]
# \-> a,"b,c","d""e"
.fi
.PP
Options:
.PP
.nf
\-delimiter ,
\-quote "
\-alwaysQuote 0
.fi
.SH PARSE TEXT
.PP
.nf
set rows [::tclutils::tucsv::parse "name,city\enAlice,Berlin"]
# \-> {name city} {Alice Berlin}
.fi
.PP
Quoted fields may contain newlines.
.SH CONVERT ROWS TO DICTS
.PP
.nf
set rows [::tclutils::tucsv::parse "name;city\enAlice;Berlin" \-delimiter {;}]
set dictRows [::tclutils::tucsv::dicts $rows]
# \-> {name Alice city Berlin}
.fi
.SH FILES
.PP
.nf
set rows [::tclutils::tucsv::file data.csv \-delimiter {;}]
::tclutils::tucsv::writeFile out.csv $rows
.fi

