.TH tucrc n 0.23.0 tclutils "Tcl Library Procedures"
.SH NAME
tucrc \- Checksum helpers using Tcl core zlib.
.SH COMMANDS
.PP
.nf
set crc [::tclutils::tucrc::crc32 $bytes]
puts [::tclutils::tucrc::hex32 $crc]
.fi
.PP
Commands:
.IP
\fBcrc32 data ?initValue?\fR
.IP
\fBadler32 data ?initValue?\fR
.IP
\fBcrc32File path\fR
.IP
\fBadler32File path\fR
.IP
\fBhex32 value\fR

