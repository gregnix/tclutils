.TH tusort n 0.23.0 tclutils "Tcl Library Procedures"
.SH NAME
tusort \- Sort helpers similar to Unix sort, implemented in pure Tcl.
.SH SYNOPSIS
.PP
.nf
package require tclutils::tusort 0.1
.fi
.SH COMMANDS
.PP
.nf
::tclutils::tusort::sortList items ?options...?
::tclutils::tusort::text text ?options...?
::tclutils::tusort::file path ?options...?
.fi
.SH OPTIONS
.IP
\fB\-numeric 1\fR sort numerically using Tcl's real comparison
.IP
\fB\-integer 1\fR sort as integers
.IP
\fB\-real 1\fR sort as real numbers
.IP
\fB\-dictionary 1\fR dictionary\-style sorting
.IP
\fB\-nocase 1\fR case\-insensitive sorting
.IP
\fB\-reverse 1\fR reverse/decreasing order
.IP
\fB\-unique 1\fR remove duplicate values during sorting
.SH EXAMPLES
.PP
.nf
set sorted [::tclutils::tusort::sortList {banana apple cherry}]
set sorted [::tclutils::tusort::file names.txt \-dictionary 1 \-nocase 1]
set sorted [::tclutils::tusort::file numbers.txt \-numeric 1 \-reverse 1]
.fi

