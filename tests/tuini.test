package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file join [file dirname $here] lib tm]
package require tclutils::tuini 0.2

set ini "global1 = g1\n; a comment\n# another\n\[server\]\nhost = localhost\nport = 8080\n\n\[db\]\nname=test\n"

test tuini-1.1 {sections and global key} -body {
    set d [::tclutils::tuini::parse $ini]
    list [::tclutils::tuini::sections $d] [::tclutils::tuini::get $d "" global1]
} -result {{{} server db} g1}

test tuini-1.2 {get a section value} -body {
    ::tclutils::tuini::get [::tclutils::tuini::parse $ini] server host
} -result localhost

test tuini-1.3 {keys of a section} -body {
    ::tclutils::tuini::keys [::tclutils::tuini::parse $ini] server
} -result {host port}

test tuini-1.4 {has} -body {
    set d [::tclutils::tuini::parse $ini]
    list [::tclutils::tuini::has $d db name] [::tclutils::tuini::has $d db missing]
} -result {1 0}

test tuini-1.5 {comments are dropped} -body {
    set d [::tclutils::tuini::parse $ini]
    expr {[::tclutils::tuini::has $d "" "; a comment"] ? "bad" : "ok"}
} -result ok

test tuini-1.6 {round-trip parse -> toIni -> parse} -body {
    set a [::tclutils::tuini::parse $ini]
    set b [::tclutils::tuini::parse [::tclutils::tuini::toIni $a]]
    expr {$a eq $b}
} -result 1

test tuini-1.7 {setValue adds a key} -body {
    set d [::tclutils::tuini::parse $ini]
    set d [::tclutils::tuini::setValue $d server timeout 30]
    ::tclutils::tuini::get $d server timeout
} -result 30

test tuini-1.8 {get default for missing} -body {
    ::tclutils::tuini::get [::tclutils::tuini::parse $ini] db missing "N/A"
} -result N/A

test tuini-2.1 {addSection / removeSection} -body {
    set d [::tclutils::tuini::parse "\[a\]\nx=1\n"]
    set d [::tclutils::tuini::addSection $d b]
    set has1 [::tclutils::tuini::sections $d]
    set d [::tclutils::tuini::removeSection $d a]
    list $has1 [::tclutils::tuini::sections $d]
} -result {{a b} b}

test tuini-2.2 {removeKey} -body {
    set d [::tclutils::tuini::parse "\[a\]\nx=1\ny=2\n"]
    set d [::tclutils::tuini::removeKey $d a x]
    ::tclutils::tuini::keys $d a
} -result y

# --- 0.2: refuse what INI cannot hold ---------------------------------------

test tuini-3.1 {setValue refuses a line break in the value} -body {
    list [catch {::tclutils::tuini::setValue {} S k "Zeile1\nZeile2"} m] \
        $::errorCode $m
} -result {1 {TCLUTILS TUINI VALUE} {value of S.k: no line breaks in INI}}

test tuini-3.2 {toIni refuses a line break in a hand-built dict} -body {
    set d [dict create S [dict create k "a\rb"]]
    list [catch {::tclutils::tuini::toIni $d} m] $::errorCode
} -result {1 {TCLUTILS TUINI VALUE}}

test tuini-3.3 {keys that would read back differently are refused} -body {
    lmap k {a=b {;x} #x {[x} { x} {x }} {
        catch {::tclutils::tuini::setValue {} S $k v}
    }
} -result {1 1 1 1 1 1}

test tuini-3.4 {section names that would read back differently are refused} -body {
    lmap s {a\]b " a" "a " "a\nb"} {
        list [catch {::tclutils::tuini::addSection {} $s}] \
            [catch {::tclutils::tuini::setValue {} $s k v}]
    }
} -result {{1 1} {1 1} {1 1} {1 1}}

test tuini-3.5 {what parse returns, toIni writes back unchanged} -body {
    set t "g = 1\n\[B\u00fcro\]\nname = J\u00f6rg \nname = Zweite\nort=M\u00fcnchen\n\[leer\]\n"
    set a [::tclutils::tuini::parse $t]
    expr {[::tclutils::tuini::parse [::tclutils::tuini::toIni $a]] eq $a}
} -result 1

test tuini-3.6 {a key twice: the last value wins; outer blanks dropped} -body {
    set d [::tclutils::tuini::parse "\[S\]\nname = J\u00f6rg \nname = Zweite\nx =  a b  \n"]
    list [::tclutils::tuini::get $d S name] [::tclutils::tuini::get $d S x]
} -result {Zweite {a b}}

test tuini-3.7 {ordinary keys and values still pass} -body {
    set d [::tclutils::tuini::setValue {} "" "Pfad.\u00c4-1" "a = b; #c \[d\]"]
    ::tclutils::tuini::get [::tclutils::tuini::parse [::tclutils::tuini::toIni $d]] "" "Pfad.\u00c4-1"
} -result {a = b; #c [d]}

cleanupTests
