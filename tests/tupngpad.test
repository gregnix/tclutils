package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
catch {tcl::tm::path add [file normalize [file join $here .. .. tclutils lib tm]]}
package require tclutils::tupngpad
package require tclutils::tupng

# packed RGBA: WxH transparent with one opaque block
proc blk {W H bx by bw bh {r 200} {g 0} {b 0}} {
    set out {}
    for {set y 0} {$y < $H} {incr y} {
        for {set x 0} {$x < $W} {incr x} {
            if {$x >= $bx && $x < $bx+$bw && $y >= $by && $y < $by+$bh} {
                lappend out $r $g $b 255
            } else { lappend out 0 0 0 0 }
        }
    }
    return [binary format cu* $out]
}
proc px {png x y} {
    set d [::tclutils::tupng::decode $png]
    set W [dict get $d width]
    binary scan [dict get $d rgba] "x[expr {($y*$W+$x)*4}] cu cu cu cu" r g b a
    return [format "#%02x%02x%02x/a%d" $r $g $b $a]
}

test tupngpad-1.1 {bbox of content} -body {
    ::tclutils::tupngpad::bbox [blk 14 12 4 3 6 4] 14 12
} -result {4 3 9 6}

test tupngpad-1.2 {bbox of fully transparent image is empty} -body {
    ::tclutils::tupngpad::bbox [blk 8 8 0 0 0 0] 8 8
} -result {}

test tupngpad-1.3 {trim crops to content size} -body {
    lassign [::tclutils::tupngpad::trim [blk 14 12 4 3 6 4] 14 12] _ w h
    list $w $h
} -result {6 4}

test tupngpad-2.1 {padTo: size, opaque bg corner, centred content} -body {
    lassign [::tclutils::tupngpad::trim [blk 14 12 4 3 6 4 10 20 30] 14 12] rgba w h
    set png [::tclutils::tupngpad::padTo $rgba $w $h 18 16 -background white]
    set d [::tclutils::tupng::decode $png]
    list [dict get $d width] [dict get $d height] \
        [px $png 0 0] [px $png 9 8]
} -result {18 16 #ffffff/a255 #0a141e/a255}

test tupngpad-3.1 {batch: uniform size, all opaque, margin honoured} -setup {
    set dir [makeDirectory pin]
    set odir [makeDirectory pout]
    foreach {n W H bw bh} {a 14 12 6 4  b 18 16 10 8} {
        set png [::tclutils::tupng::encodeRGBARaw [blk $W $H 2 2 $bw $bh] $W $H]
        set fid [open [file join $dir $n.png] w]
        fconfigure $fid -translation binary; puts -nonewline $fid $png; close $fid
    }
} -body {
    set res [::tclutils::tupngpad::batch \
        [glob [file join $dir *.png]] $odir -margin 4 -background white]
    set sizes {}
    foreach {in out} [dict get $res files] {
        set d [::tclutils::tupng::readPNG $out]
        lappend sizes [list [dict get $d width] [dict get $d height]]
    }
    list [dict get $res size] [lsort -unique $sizes]
} -cleanup { removeDirectory pin; removeDirectory pout } -result {{18 16} {{18 16}}}

# --- 0.2: option checks, alpha kept on a transparent background ----------
test tupngpad-4.1 {padTo: unknown -align -> COMMON VALUE} -body {
    catch {::tclutils::tupngpad::padTo [blk 2 2 0 0 2 2] 2 2 4 4 -align middle} e o
    list [dict get $o -errorcode] [string match {*Known: center nw*} $e]
} -result {{TCLUTILS COMMON VALUE -align} 1}

test tupngpad-4.2 {batch: -trim not boolean -> TUPNGPAD TRIM} -body {
    catch {::tclutils::tupngpad::batch {} [file join [temporaryDirectory] x] \
        -trim maybe} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNGPAD TRIM}

test tupngpad-4.3 {batch: -square not boolean -> TUPNGPAD SQUARE} -body {
    catch {::tclutils::tupngpad::batch {} [file join [temporaryDirectory] x] \
        -square 2x} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNGPAD SQUARE}

test tupngpad-4.4 {batch: unknown -align -> COMMON VALUE, before reading} -body {
    catch {::tclutils::tupngpad::batch {/nonexistent/a.png} \
        [file join [temporaryDirectory] x] -align middle} e o
    dict get $o -errorcode
} -result {TCLUTILS COMMON VALUE -align}

test tupngpad-4.5 {batch: bad -size -> TUPNGPAD SIZE} -body {
    lmap sz {{10} {0 5} {a 5} {5 5 5}} {
        catch {::tclutils::tupngpad::batch {} \
            [file join [temporaryDirectory] x] -size $sz} e o
        dict get $o -errorcode
    }
} -result [lrepeat 4 {TCLUTILS TUPNGPAD SIZE}]

test tupngpad-4.6 {padTo: half-transparent pixel stays so on transparent bg} -body {
    set png [::tclutils::tupngpad::padTo [binary format cu* {255 0 0 128}] \
        1 1 1 1 -background transparent]
    binary scan [dict get [::tclutils::tupng::decode $png] rgba] cu* px
    set px
} -result {255 0 0 128}

test tupngpad-4.7 {padTo: half-transparent pixel blends on white} -body {
    set png [::tclutils::tupngpad::padTo [binary format cu* {255 0 0 128}] \
        1 1 1 1]
    binary scan [dict get [::tclutils::tupng::decode $png] rgba] cu* px
    set px
} -result {255 127 127 255}


test tupngpad-4.8 {a failed write leaves the old file} -setup {
    set dir [makeDirectory pin48]
    set odir [makeDirectory pout48]
    set png [::tclutils::tupng::encodeRGBARaw [blk 2 2 0 0 2 2] 2 2]
    set inf [file join $dir a.png]
    set ch [open $inf w]; fconfigure $ch -translation binary
    puts -nonewline $ch $png; close $ch
    set f [file join $odir a.png]
    set ch [open $f w]; puts -nonewline $ch PRECIOUS; close $ch
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {
        ::tclutils::tupngpad::batch [list $inf] $odir -trim 0
    }]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeDirectory pin48
    removeDirectory pout48
} -result {1 PRECIOUS 0 0}

cleanupTests
