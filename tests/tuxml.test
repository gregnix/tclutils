package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuxml 0.1

test tuxml-1.1 {escape text} -body {
    ::tclutils::tuxml::escape {A&B < C > D}
} -result {A&amp;B &lt; C &gt; D}

test tuxml-1.2 {escape attribute quotes} -body {
    ::tclutils::tuxml::escape {"A&B"} -quotes 1
} -result {&quot;A&amp;B&quot;}

test tuxml-1.3 {unescape predefined and numeric entities} -body {
    ::tclutils::tuxml::unescape {A&amp;B &#x41;&#66;}
} -result {A&B AB}

test tuxml-1.4 {tag builds empty element} -body {
    ::tclutils::tuxml::tag item [dict create id 5 name {A&B}]
} -result {<item id="5" name="A&amp;B"/>}

test tuxml-1.5 {textElement escapes content} -body {
    ::tclutils::tuxml::textElement title {} {A < B}
} -result {<title>A &lt; B</title>}

test tuxml-1.6 {invalid name raises error} -body {
    catch {::tclutils::tuxml::tag {1bad}}
} -result 1

cleanupTests
