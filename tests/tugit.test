package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tugit

namespace eval M { namespace import ::tclutils::tugit::* }

proc nnodes {m} { llength [dict get $m nodes] }
proc nedges {m} { llength [dict get $m edges] }
proc ids {m} { lmap n [dict get $m nodes] { dict get $n id } }
proc nodeById {m id} {
    foreach n [dict get $m nodes] { if {[dict get $n id] eq $id} { return $n } }
    return {}
}
proc inEdges {m id} {
    set k 0
    foreach e [dict get $m edges] { if {[dict get $e to] eq $id} { incr k } }
    return $k
}
proc epairs {m} { lmap e [dict get $m edges] { list [dict get $e from] [dict get $e to] } }

# --- commits -----------------------------------------------------------------

test tugit-1.1 {two commits: chained on the default branch} -body {
    set m [M::parse "gitGraph\n  commit\n  commit"]
    list [nnodes $m] [nedges $m]
} -result {2 1}

test tugit-1.2 {first commit has no parent} -body {
    inEdges [M::parse "gitGraph\n  commit"] c1
} -result 0

test tugit-1.3 {explicit id and tag form the node id and label} -body {
    set m [M::parse "gitGraph\n  commit id: \"A1\" tag: \"v1\""]
    set n [nodeById $m A1]
    list [dict get $n id] [dict get $n label]
} -result {A1 {A1 [v1]}}

# --- branches / merges -------------------------------------------------------

test tugit-2.1 {branch commits parent off the branch point} -body {
    # c1 on main ; branch dev (from c1) ; commit c2 on dev
    epairs [M::parse "gitGraph\n  commit\n  branch dev\n  commit"]
} -result {{c1 c2}}

test tugit-2.2 {merge commit has two parents} -body {
    # c1 on main ; branch dev ; c2 on dev ; checkout main ; merge dev -> c3
    set m [M::parse "gitGraph\n  commit\n  branch dev\n  commit\n  checkout main\n  merge dev"]
    set mergeId [lindex [ids $m] end]
    inEdges $m $mergeId
} -result 2

test tugit-2.3 {merge node is a box, commits are rounded} -body {
    set m [M::parse "gitGraph\n  commit\n  branch dev\n  commit\n  checkout main\n  merge dev"]
    list [dict get [nodeById $m c1] shape] [dict get [nodeById $m [lindex [ids $m] end]] shape]
} -result {rounded box}

test tugit-2.4 {checkout switches the active branch} -body {
    # c1 main ; branch dev ; c2 dev ; checkout main ; commit c3 (parent c1)
    set m [M::parse "gitGraph\n  commit\n  branch dev\n  commit\n  checkout main\n  commit"]
    inEdges $m c3
} -result 1

# --- header / misc -----------------------------------------------------------

test tugit-3.1 {direction defaults to LR} -body {
    dict get [M::parse "gitGraph\n  commit"] meta direction
} -result LR

test tugit-3.2 {gitGraph TB: header sets TB} -body {
    dict get [M::parse "gitGraph TB:\n  commit"] meta direction
} -result TB

test tugit-3.3 {cherry-pick adds a commit node} -body {
    set m [M::parse "gitGraph\n  commit\n  cherry-pick id: \"X\""]
    nnodes $m
} -result 2

test tugit-3.4 {comments and blanks ignored} -body {
    nnodes [M::parse "gitGraph\n  %% c\n\n  commit\n  commit"]
} -result 2

test tugit-3.5 {empty source raises TUGIT EMPTY} -body {
    catch {M::parse "gitGraph"} e o
    list [lindex [dict get $o -errorcode] 1] [lindex [dict get $o -errorcode] 2]
} -result {TUGIT EMPTY}

# --- branch colours ---------------------------------------------------------

test tugit-4.1 {commits are coloured by their branch} -body {
    set m [M::parse "gitGraph\n  commit\n  branch dev\n  commit"]
    expr {[dict get [dict get [nodeById $m c1] style] fill]
          ne [dict get [dict get [nodeById $m c2] style] fill]}
} -result 1

test tugit-4.2 {a commit style carries fill and stroke} -body {
    dict keys [dict get [nodeById [M::parse "gitGraph\n  commit"] c1] style]
} -result {fill stroke}

cleanupTests
