package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
set tmDir [file join $root lib tm]
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
catch {tcl::tm::path remove $tmDir}
tcl::tm::path add $tmDir
package require tclutils::tuflow 0.4

namespace eval M { namespace import ::tclutils::tuflow::* }

proc nodeOf {m id key} {
    foreach n [dict get $m nodes] {
        if {[dict get $n id] eq $id} { return [dict get $n $key] }
    }
    return ""
}
proc edgeKey {m from to key} {
    foreach e [dict get $m edges] {
        if {[dict get $e from] eq $from && [dict get $e to] eq $to} { return [dict get $e $key] }
    }
    return ""
}

test tuflow-1.1 {header sets direction; TD maps to TB} -body {
    dict get [M::parse {flowchart TD
        A --> B}] meta direction
} -result TB

test tuflow-1.2 {graph LR keeps LR} -body {
    dict get [M::parse {graph LR
        A-->B}] meta direction
} -result LR

test tuflow-2.1 {node shapes map correctly} -body {
    set m [M::parse {flowchart LR
        A[box] --> B(round) --> C((circ)) --> D{dia}}]
    list [nodeOf $m A shape] [nodeOf $m B shape] [nodeOf $m C shape] [nodeOf $m D shape]
} -result {box rounded circle diamond}

test tuflow-2.1a {stadium, hexagon and database shapes} -body {
    set m [M::parse {flowchart LR
        A([sta]) --> B{{hex}} --> C[(db)]}]
    list [nodeOf $m A shape] [nodeOf $m B shape] [nodeOf $m C shape]
} -result {stadium hexagon cylinder}

test tuflow-2.1b {RL and BT directions pass through} -body {
    list [dict get [M::parse "graph RL\n  X --> Y"] meta direction] \
         [dict get [M::parse "graph BT\n  X --> Y"] meta direction]
} -result {RL BT}

test tuflow-2.2 {bracket text becomes the label; bare id is its own label} -body {
    set m [M::parse {graph LR
        A[Start Here] --> B}]
    list [nodeOf $m A label] [nodeOf $m B label]
} -result {{Start Here} B}

test tuflow-2.3 {quoted labels are unquoted} -body {
    nodeOf [M::parse {graph LR
        A["Quoted"] --> B}] A label
} -result Quoted

test tuflow-3.1 {pipe-label edge} -body {
    edgeKey [M::parse {graph LR
        A -->|yes| B}] A B label
} -result yes

test tuflow-3.2 {dash-text-arrow label form} -body {
    edgeKey [M::parse {graph LR
        A -- no --> B}] A B label
} -result no

test tuflow-3.3 {--- is an arrowless edge} -body {
    edgeKey [M::parse {graph LR
        A --- B}] A B arrow
} -result none

test tuflow-3.4 {dotted edge keeps arrow + dotted style} -body {
    set m [M::parse {graph LR
        A -.-> B}]
    list [edgeKey $m A B arrow] [edgeKey $m A B style]
} -result {end dotted}

test tuflow-4.1 {a chain yields N-1 edges} -body {
    llength [dict get [M::parse {graph LR
        A --> B --> C --> D}] edges]
} -result 3

test tuflow-4.2 {comments and blank lines are ignored} -body {
    set m [M::parse {%% a comment

        flowchart LR
        %% another
        A --> B}]
    llength [dict get $m nodes]
} -result 2

test tuflow-5.1 {empty source is an error} -body {
    M::parse {flowchart LR}
} -returnCodes error -match glob -result {*no nodes*}

test tuflow-5.2 {hyphen in node id is BADID, not a silent truncate} -body {
    catch {M::parse {flowchart LR
        Nwifi-3["SSID"]}} e o
    list [lindex [dict get $o -errorcode] end] \
        [string match {*Nwifi-3*} $e] \
        [string match {*letters, digits and _*} $e]
} -result {BADID 1 1}

test tuflow-5.3 {underscore in node id is legal} -body {
    nodeOf [M::parse {flowchart LR
        Nwifi_3["SSID"]}] Nwifi_3 label
} -result SSID

test tuflow-6.1 {the model renders via tudiagram (non-empty SVG)} -body {
    set m [M::parse {flowchart LR
        A[Start] --> B{Go}
        B -->|y| C(End)
        B -->|n| D
        C --> E
        D --> E}]
    expr {[string length [::tclutils::tudiagram::toSvg $m]] > 0}
} -result 1

# --- render facade -----------------------------------------------------------

test tuflow-facade-1.1 {toSvg on a graph equals tudiagram::toSvg [parse]} -body {
    set g {graph LR
        A[Start] --> B{Check}
        B -->|ok| C[Done]}
    expr {[M::toSvg $g] eq [::tclutils::tudiagram::toSvg [M::parse $g]]}
} -result 1

test tuflow-facade-1.2 {toPng on a graph equals tudiagram::toPng [parse]} -body {
    set g {graph LR
        A --> B --> C}
    expr {[M::toPng $g -scale 2] eq [::tclutils::tudiagram::toPng [M::parse $g] -scale 2]}
} -result 1

test tuflow-facade-2.1 {pie renders to SVG through the facade} -body {
    set svg [M::toSvg "pie title T\n  \"A\" : 30\n  \"B\" : 70"]
    expr {[string match {<svg*} $svg] && [regexp -all {<(polygon|path)\M} $svg] == 2}
} -result 1

test tuflow-facade-2.2 {pie renders to PNG through the facade} -body {
    binary scan [M::toPng "pie\n  \"A\" : 1\n  \"B\" : 1" -scale 2] H8 sig
    set sig
} -result 89504e47

test tuflow-facade-2.3 {facade -fontfile with a missing path is a hard FONT error} -body {
    catch {M::toPng "pie\n  \"A\" : 1" -fontfile /no/such/font/here.ttf} e o
    lindex [dict get $o -errorcode] end
} -result FONT

test tuflow-facade-3.1 {parse stays graph-only and still rejects pie} -body {
    catch {M::parse "pie\n  \"A\" : 1"} e o
    lindex [dict get $o -errorcode] end
} -result UNSUPPORTED

# --- subgraph / cluster ------------------------------------------------------

proc grpMembers {m id} {
    foreach g [dict get $m groups] {
        if {[dict get $g id] eq $id} { return [lsort [dict get $g members]] }
    }
    return "MISSING"
}
proc grpLabel {m id} {
    foreach g [dict get $m groups] {
        if {[dict get $g id] eq $id} { return [dict get $g label] }
    }
    return "MISSING"
}
proc ids {m} { lsort [lmap n [dict get $m nodes] { dict get $n id }] }
proc epairs {m} { lsort [lmap e [dict get $m edges] { list [dict get $e from] [dict get $e to] }] }

test tuflow-sg-1.1 {a subgraph becomes a group over its member nodes} -body {
    set m [M::parse "flowchart TB\n  subgraph phase1 \[Phase 1\]\n    A --> B\n  end\n  B --> C"]
    list [grpMembers $m phase1] [grpLabel $m phase1]
} -result {{A B} {Phase 1}}

test tuflow-sg-1.2 {a node outside the subgraph is not a member} -body {
    set m [M::parse "flowchart TB\n  subgraph phase1 \[Phase 1\]\n    A --> B\n  end\n  B --> C"]
    list [ids $m] [grpMembers $m phase1]
} -result {{A B C} {A B}}

test tuflow-sg-1.3 {subgraph id with no label uses the id as label} -body {
    set m [M::parse "flowchart TB\n  subgraph two\n    C --> D\n  end"]
    grpLabel $m two
} -result {two}

test tuflow-sg-1.4 {two sibling subgraphs each get their own group} -body {
    set m [M::parse "flowchart LR\n  subgraph ingest \[Ingest\]\n    I1 --> I2\n  end\n  subgraph render \[Render\]\n    R1 --> R2\n  end\n  I2 --> R1"]
    list [grpMembers $m ingest] [grpMembers $m render] [llength [dict get $m groups]]
} -result {{I1 I2} {R1 R2} 2}

test tuflow-sg-1.5 {nested subgraphs: inner members are also outer members} -body {
    set m [M::parse "flowchart TB\n  subgraph outer \[Outer\]\n    subgraph inner \[Inner\]\n      X --> Y\n    end\n    Y --> Z\n  end\n  Z --> W"]
    list [grpMembers $m outer] [grpMembers $m inner]
} -result {{X Y Z} {X Y}}

test tuflow-sg-1.6 {an edge to a subgraph id is dropped; the id is not a node} -body {
    set m [M::parse "flowchart LR\n  subgraph block \[Block\]\n    P --> Q\n  end\n  A --> block"]
    list [ids $m] [epairs $m]
} -result {{A P Q} {{P Q}}}

test tuflow-sg-1.7 {a `direction` line inside a subgraph is ignored} -body {
    set m [M::parse "flowchart LR\n  subgraph block \[Block\]\n    direction TB\n    P --> Q\n  end"]
    list [ids $m] [epairs $m] [grpMembers $m block]
} -result {{P Q} {{P Q}} {P Q}}

test tuflow-sg-1.8 {subgraphs render through the facade as a valid PNG} -body {
    binary scan [M::toPng "flowchart TB\n  subgraph g \[G\]\n    A --> B\n  end\n  B --> C"] H8 sig
    set sig
} -result 89504e47

# --- fixes 0.3 ------------------------------------------------------------------

proc edgePairs {m} {
    lmap e [dict get $m edges] {list [dict get $e from] [dict get $e to]}
}

test tuflow-fix-1.1 {bare `sankey` is rejected like sankey-beta, not a node} -body {
    catch {M::parse "sankey\nA,B,1\n"} m o
    dict get $o -errorcode
} -result {TCLUTILS TUFLOW UNSUPPORTED}
test tuflow-fix-1.2 {sankey-beta is still rejected by parse} -body {
    catch {M::parse "sankey-beta\nA,B,1\n"} m o
    dict get $o -errorcode
} -result {TCLUTILS TUFLOW UNSUPPORTED}
test tuflow-fix-2.1 {header keyword and direction ignore case} -body {
    set m [M::parse "FLOWCHART TD\nA --> B\n"]
    list [dict get $m meta direction] [lmap n [dict get $m nodes] {dict get $n id}]
} -result {TB {A B}}
test tuflow-fix-2.2 {`Graph rl` header} -body {
    dict get [M::parse "Graph rl\nA --> B\n"] meta direction
} -result RL
test tuflow-fix-3.1 {A & B --> C & D gives every pair} -body {
    edgePairs [M::parse "flowchart LR\nA & B --> C & D\n"]
} -result {{A C} {A D} {B C} {B D}}
test tuflow-fix-3.2 {& in a chain, label kept on each edge} -body {
    set m [M::parse "flowchart LR\nA -->|x| B & C --> D\n"]
    list [edgePairs $m] [lsort -unique [lmap e [dict get $m edges] {dict get $e label}]]
} -result {{{A B} {A C} {B D} {C D}} {{} x}}
test tuflow-fix-3.3 {A & B alone declares both nodes, no edge} -body {
    set m [M::parse "flowchart LR\nA\[a\] & B\n"]
    list [lmap n [dict get $m nodes] {dict get $n id}] [llength [dict get $m edges]]
} -result {{A B} 0}

test tuflow-9.1 {Unicode node ids: Büro[Amt] is a node} -body {
    set m [M::parse "flowchart LR\n    A\[Jörg\] -->|hält| B\[Büro\]\n    Büro\[Amt\]\n    Büro --> Jörg_2"]
    list [ids $m] [nodeOf $m Büro label] [epairs $m]
} -result {{A B Büro Jörg_2} Amt {{A B} {Büro Jörg_2}}}

test tuflow-9.2 {";" inside a label or an edge label does not split the statement} -body {
    set m1 [M::parse "flowchart LR\n    A\[J\u00f6rg;B\u00fcro\] --> B\[Amt\]"]
    set m2 [M::parse "flowchart LR\n    A -->|h\u00e4lt;fest| B"]
    set m3 [M::parse "flowchart LR; A-->B; B-->C"]
    list [nodeOf $m1 A label] [epairs $m1] [edgeKey $m2 A B label] [epairs $m3]
} -result [list "J\u00f6rg;B\u00fcro" {{A B}} "h\u00e4lt;fest" {{A B} {B C}}]

test tuflow-9.3 {a failed write leaves the old file, no temp file, no channel} -setup {
    set f [makeFile PRECIOUS tuflow-9.3.svg]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tclutils::tuflow::writeSvg "graph RL\n  X --> Y" $f}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tuflow-9.3.svg
} -result {1 PRECIOUS 0 0}

test tuflow-9.4 {a failed write leaves the old file, no temp file, no channel} -setup {
    set f [makeFile PRECIOUS tuflow-9.4.png]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tclutils::tuflow::writePng "graph RL\n  X --> Y" $f}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tuflow-9.4.png
} -result {1 PRECIOUS 0 0}

cleanupTests
