package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file join [file dirname $here] lib tm]
package require tclutils::tuldif 0.3

set ldif "dn: cn=Alice,dc=ex\ncn: Alice\nsn: Smith\nmail: alice@ex.com\nmail: a@ex.com\n\ndn: cn=Bob,dc=ex\ncn: Bob\n"

test tuldif-1.1 {parse entry count} -body {
    llength [::tclutils::tuldif::parse $ldif]
} -result 2

test tuldif-1.2 {dn of first entry} -body {
    ::tclutils::tuldif::dn [lindex [::tclutils::tuldif::parse $ldif] 0]
} -result {cn=Alice,dc=ex}

test tuldif-1.3 {multi-valued attribute} -body {
    ::tclutils::tuldif::get [lindex [::tclutils::tuldif::parse $ldif] 0] mail
} -result {alice@ex.com a@ex.com}

test tuldif-1.4 {attribute names in order} -body {
    ::tclutils::tuldif::attributes [lindex [::tclutils::tuldif::parse $ldif] 0]
} -result {dn cn sn mail}

test tuldif-1.5 {toDict groups values} -body {
    set d [::tclutils::tuldif::toDict [lindex [::tclutils::tuldif::parse $ldif] 0]]
    list [dict get $d cn] [llength [dict get $d mail]]
} -result {Alice 2}

test tuldif-1.6 {base64 value is decoded} -body {
    set e [lindex [::tclutils::tuldif::parse "dn: x\ndescription:: SGVsbG8=\n"] 0]
    ::tclutils::tuldif::get $e description
} -result Hello

test tuldif-1.7 {continuation lines are unfolded} -body {
    set e [lindex [::tclutils::tuldif::parse "dn: x\ncn: Hello\n World\n"] 0]
    ::tclutils::tuldif::get $e cn
} -result HelloWorld

test tuldif-1.8 {round-trip parse -> toLdif -> parse} -body {
    set a [::tclutils::tuldif::parse $ldif]
    set b [::tclutils::tuldif::parse [::tclutils::tuldif::toLdif $a]]
    expr {$a eq $b}
} -result 1

test tuldif-1.9 {non-safe value emitted and decoded as base64} -body {
    set entry [list {dn x} [list description "H\u00e4llo"]]
    set out [::tclutils::tuldif::toLdif [list $entry]]
    set roundtrip [::tclutils::tuldif::get \
        [lindex [::tclutils::tuldif::parse $out] 0] description]
    list [string match "*description:: *" $out] [expr {$roundtrip eq "H\u00e4llo"}]
} -result {1 1}

test tuldif-2.1 {addAttr / setAttr / removeAttr} -body {
    set e [list {dn cn=A} {cn A}]
    set e [::tclutils::tuldif::addAttr $e mail a@x.com]
    set v1 [::tclutils::tuldif::get $e mail]
    set e [::tclutils::tuldif::setAttr $e 2 mail b@x.com]
    set v2 [::tclutils::tuldif::get $e mail]
    set e [::tclutils::tuldif::removeAttr $e 2]
    list $v1 $v2 [::tclutils::tuldif::attributes $e]
} -result {a@x.com b@x.com {dn cn}}

test tuldif-3.1 {base64 output is the UTF-8 bytes} -body {
    set entry [list {dn x} [list cn "H\u00e4llo"]]
    ::tclutils::tuldif::toLdif [list $entry]
} -result "dn: x\ncn:: SMOkbGxv\n"

test tuldif-3.2 {base64 input is decoded as UTF-8} -body {
    set e [lindex [::tclutils::tuldif::parse "dn: x\ncn:: SMOkbGxv\n"] 0]
    expr {[::tclutils::tuldif::get $e cn] eq "H\u00e4llo"}
} -result 1

test tuldif-3.3 {characters above 255 round-trip} -body {
    set entry [list {dn x} [list cn "5 \u20ac"]]
    set out [::tclutils::tuldif::toLdif [list $entry]]
    set e [lindex [::tclutils::tuldif::parse $out] 0]
    list $out [expr {[lindex [::tclutils::tuldif::get $e cn] 0] eq "5 \u20ac"}]
} -result [list "dn: x\ncn:: NSDigqw=\n" 1]

test tuldif-3.4 {a trailing space forces base64 and survives} -body {
    set entry [list {dn x} [list cn "a "]]
    set out [::tclutils::tuldif::toLdif [list $entry]]
    set e [lindex [::tclutils::tuldif::parse $out] 0]
    list $out [::tclutils::tuldif::get $e cn]
} -result [list "dn: x\ncn:: YSA=\n" {{a }}]

test tuldif-3.5 {bytes that are not UTF-8 stay bytes} -body {
    set e [lindex [::tclutils::tuldif::parse "dn: x\nphoto:: /9g=\n"] 0]
    binary encode hex [::tclutils::tuldif::get $e photo]
} -result ffd8

test tuldif-3.6 {a change record is refused with its own code} -body {
    set text "dn: cn=A\nchangetype: modify\nreplace: mail\nmail: x\n-\n"
    catch {::tclutils::tuldif::parse $text} m o
    list [dict get $o -errorcode] $m
} -result {{TCLUTILS TULDIF CHANGETYPE} {LDIF change records are not supported (changetype: modify)}}

# --- 0.3: binary attributes ---------------------------------------------------

test tuldif-4.1 {jpegPhoto bytes are written back as the same base64} -body {
    set e [::tclutils::tuldif::parse "dn: cn=x\njpegPhoto:: AP/DvA==\n"]
    list [binary encode hex [lindex [::tclutils::tuldif::get [lindex $e 0] jpegPhoto] 0]] \
        [::tclutils::tuldif::toLdif $e]
} -result [list 00ffc3bc "dn: cn=x\njpegPhoto:: AP/DvA==\n"]

test tuldif-4.2 {a binary value that is valid UTF-8 stays bytes} -body {
    set e [::tclutils::tuldif::parse "dn: cn=x\nphoto:: w7Y=\n"]
    set v [lindex [::tclutils::tuldif::get [lindex $e 0] photo] 0]
    list [string length $v] [::tclutils::tuldif::toLdif $e]
} -result [list 2 "dn: cn=x\nphoto:: w7Y=\n"]

test tuldif-4.3 {;binary and -binary mark attributes} -body {
    set t "dn: cn=x\nuserCertificate;binary:: w7Y=\nblob:: w7Y=\n"
    set e [lindex [::tclutils::tuldif::parse $t -binary blob] 0]
    lmap p $e { string length [lindex $p 1] }
} -result {4 2 2}

test tuldif-4.4 {text stays UTF-8: cn Jörg} -body {
    ::tclutils::tuldif::toLdif [list [list {dn cn=x} {cn Jörg}]]
} -result "dn: cn=x\ncn:: SsO2cmc=\n"

test tuldif-4.5 {a binary attribute with characters above \xFF is an error} -body {
    list [catch {::tclutils::tuldif::toLdif [list [list {dn cn=x} {jpegPhoto Jörg€}]]}] $::errorCode
} -result {1 {TCLUTILS TULDIF BINARY}}

test tuldif-4.6 {wrong option} -body {
    catch {::tclutils::tuldif::parse "dn: x\n" -bin a}
    set ::errorCode
} -result {TCLUTILS TULDIF OPTION}

cleanupTests
