test tusysinfo-2.4 {system_profiler JSON of a real Mac mini} -body {
    set p [${ns}::_parseProfiler $::macJson 0]
    set d [lindex [dict get $p displays] 0]
    list [dict get $p machine] [dict get $p disks] \
         [lmap k {manufacturer vendor name productCode year week preferred present} {dict get $d $k}]
} -result {{vendor Apple model {Mac mini} version Mac18,5 modelNumber Z1UA000PKZD/A bios 20457.1.29 chip {Apple M6} memoryText {24 GB}} {{name disk3 model {APPLE SSD AP1024Z} size 994610155520 type ssd removable 0 volumes {Data, Macintosh HD}}} {ACI ASUS {ASUS VE278} 27F6 2013 22 {width 1920 height 1080 refresh 60.0} 1}}

test tusysinfo-2.4a {system_profiler: serials only with -serials 1} -body {
    set p [${ns}::_parseProfiler $::macJson 1]
    list [dict get $p machine serial] [dict get [lindex [dict get $p displays] 0] serialText]
} -result {XXXXXXXXXX 12345}

test tusysinfo-3.1 {report: sections, units, anonymized host} -body {
    set i [${ns}::collect -platform linux -root $root]
    dict set i host decoder
    set r [${ns}::report $i -anonymize 1]
    list [string match *Host:\ <host>* $r] [string match {*Total: 15.5 GiB*} $r] \
         [string match {*DP-1 *Dell DELL P2722H  27.2"  1920x1080 @ 60.0 Hz  2022*} $r] \
         [string match *decoder* $r]
} -result {1 1 1 0}

test tusysinfo-3.2 {toJson is valid JSON with numbers} -body {
    set j [${ns}::toJson [${ns}::collect -platform linux -root $root]]
    set p [::tclutils::tujson::parse $j]
    list [::tclutils::tujson::validate $j] [string match {*"total": 16694710272*} $j] \
         [dict get [lindex [dict get $p displays] 0] productCode]
} -result {1 1 A0F1}

test tusysinfo-4.1 {option errors} -body {
    list [catch {${ns}::collect -x 1} e1] [lindex $::errorCode 2] \
         [catch {${ns}::collect -sections {os gpu}} e2] $e2 \
         [catch {${ns}::collect -platform beos} e3] [lindex $::errorCode 2]
} -result {1 OPTION 1 {unknown section "gpu": must be os, cpu, memory, machine, disks, displays} 1 PLATFORM}

test tusysinfo-4.2 {macos without programs gives no sections} -body {
    lsort [dict keys [${ns}::collect -platform macos -commands 0]]
} -result {host platform}

test tusysinfo-5.1 {_run: output, missing program, time limit} -constraints unix -body {
    set t [clock milliseconds]
    lassign [${ns}::_run {echo hallo} 2000] ok out
    set r [list $ok [string trim $out] [${ns}::_run {no-such-program-x} 2000] \
               [lindex [${ns}::_run {sleep 5} 300] 0]]
    lappend r [expr {[clock milliseconds] - $t < 3000}]
} -result {1 hallo {0 {}} 0 1}

test tusysinfo-5.2 {this computer: collect runs and reports} -body {
    set i [${ns}::collect -timeout 5000]
    list [dict exists $i os name] [string match "==== *" [${ns}::report $i]]
} -result {1 1}

# Windows path with a fake registry and a fake PowerShell answer.
test tusysinfo-2.5 {windows: registry and CIM put together (fake registry)} -setup {
    set hadReg [llength [info commands ::registry]]
    if {$hadReg} { rename ::registry ::_realRegistry }
    set ::fakeReg [dict create \
        {HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion} \
            {ProductName {Windows 10 Pro} DisplayVersion 24H2 CurrentBuildNumber 26100 UBR 2314} \
        {HKEY_LOCAL_MACHINE\HARDWARE\DESCRIPTION\System\CentralProcessor\0} \
            {ProcessorNameString {Intel(R) Core(TM) i5-12400   }} \
        {HKEY_LOCAL_MACHINE\HARDWARE\DESCRIPTION\System\BIOS} \
            {SystemManufacturer {Dell Inc.} SystemProductName {OptiPlex 7000} BIOSVersion 1.20.0} \
        {HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum\DISPLAY\DEL41A2\5&2b0d6b1c&0&UID4352\Device Parameters} \
            [list EDID [edidBytes]] \
        {HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum\DISPLAY\DEL41A2\old&1&UID1\Device Parameters} \
            [list EDID [edidBytes]]]
    proc ::registry {cmd key args} {
        switch -- $cmd {
            values { if {![dict exists $::fakeReg $key]} { error "no key" }; return [dict keys [dict get $::fakeReg $key]] }
            get    { set v [dict get $::fakeReg $key]; set n [lindex $args 0]
                     if {![dict exists $v $n]} { error "no value" }; return [dict get $v $n] }
            keys   {
                set out {}
                foreach k [dict keys $::fakeReg] {
                    if {[string first "$key\\" $k] == 0} {
                        set rest [string range $k [string length $key\\] end]
                        set first [lindex [split $rest \\] 0]
                        if {$first ni $out} { lappend out $first }
                    }
                }
                if {![llength $out]} { error "no key" }
                return $out
            }
        }
    }
    # Windows has loaded the real package already (collect in 5.2): a second
    # "package provide" with another version is an error. Only shim then.
    if {[catch {package present registry}]} { package provide registry 1.3 }
    rename ${ns}::_winPowerShell ${ns}::_realPS
    proc ${ns}::_winPowerShell {timeout} {
        return {{"memory":17179869184,"disks":[{"DeviceID":"D0","Model":"KINGSTON SNV2S500G","Size":500105249280,"MediaType":"Fixed hard disk media"}],"monitors":{"InstanceName":"DISPLAY\\DEL41A2\\5&2b0d6b1c&0&UID4352_0","Status":"OK"}}}
    }
} -body {
    set i [${ns}::collect -platform windows]
    list [dict get $i os name] [dict get $i os build] [dict get $i cpu model] [dict get $i cpu logical] \
         [dict get $i memory total] [dict get $i machine model] \
         [llength [dict get $i disks]] [llength [dict get $i displays]] \
         [dict get [lindex [dict get $i displays] 0] connector] \
         [dict get [lindex [dict get $i displays] 0] present]
} -cleanup {
    # undo only what the setup got to
    catch {rename ::registry {}}
    if {$hadReg && [llength [info commands ::_realRegistry]]} {
        rename ::_realRegistry ::registry
    }
    if {[llength [info commands ${ns}::_realPS]]} {
        catch {rename ${ns}::_winPowerShell {}}
        rename ${ns}::_realPS ${ns}::_winPowerShell
    }
} -result {{Windows 11 Pro} 26100.2314 {Intel(R) Core(TM) i5-12400} 1 17179869184 {OptiPlex 7000} 1 1 DEL41A2 1}

test tusysinfo-2.6 {macos: programs put together (fake _run)} -setup {
    rename ${ns}::_run ${ns}::_realRun
    proc ${ns}::_run {cmd timeout} {
        switch -- [lindex $cmd 0] {
            sw_vers { return [list 1 "ProductName:\tmacOS\nProductVersion:\t15.1\nBuildVersion:\t24B83\n"] }
            uname   { return [list 1 "24.1.0\n"] }
            sysctl  { return [list 1 "machdep.cpu.brand_string: Apple M4\nhw.ncpu: 10\nhw.physicalcpu: 10\nhw.memsize: 17179869184\n"] }
            system_profiler {
                return [list 1 {{"SPHardwareDataType":[{"machine_name":"Mac mini","machine_model":"Mac16,10"}],"SPStorageDataType":[],"SPDisplaysDataType":[]}}]
            }
        }
        return [list 0 ""]
    }
} -body {
    set i [${ns}::collect -platform macos]
    list [dict get $i os name] [dict get $i os kernel] [dict get $i cpu] [dict get $i memory total] \
         [dict get $i machine model] [dict get $i disks] [dict get $i displays]
} -cleanup {
    rename ${ns}::_run {}
    rename ${ns}::_realRun ${ns}::_run
} -result {{macOS 15.1} 24.1.0 {model {Apple M4} logical 10 cores 10} 17179869184 {Mac mini} {} {}}

# The case from a real Windows 11 PC (GEEKOM AE8 MAX): one monitor under
# three registry instances, no WmiMonitorID answer, NVMe disk reported as
# "Fixed hard disk media", firmware placeholders.
test tusysinfo-2.7 {windows: duplicate EDIDs, NVMe as ssd, placeholders (fake registry)} -setup {
    set hadReg [llength [info commands ::registry]]
    if {$hadReg} { rename ::registry ::_realRegistry }
    set base {HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum\DISPLAY\ACI27F6}
    set ::fakeReg [dict create \
        {HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion} \
            {ProductName {Windows 10 Pro} DisplayVersion 26H2 CurrentBuildNumber 26300 UBR 9711
             CurrentMajorVersionNumber 10 CurrentMinorVersionNumber 0} \
        {HKEY_LOCAL_MACHINE\HARDWARE\DESCRIPTION\System\CentralProcessor\0} \
            {ProcessorNameString {AMD Ryzen 7 8745HS w/ Radeon 780M Graphics}} \
        {HKEY_LOCAL_MACHINE\HARDWARE\DESCRIPTION\System\BIOS} \
            {SystemManufacturer GEEKOM SystemProductName {AE8 MAX} SystemVersion {Default string}
             BaseBoardManufacturer {Default string} BaseBoardProduct {AE8 MAX}} \
        "$base\\1&a&UID1\\Device Parameters" [list EDID [edidBytes]] \
        "$base\\2&b&UID2\\Device Parameters" [list EDID [edidBytes]] \
        "$base\\3&c&UID3\\Device Parameters" [list EDID [edidBytes]]]
    proc ::registry {cmd key args} {
        switch -- $cmd {
            values { if {![dict exists $::fakeReg $key]} { error "no key" }; return [dict keys [dict get $::fakeReg $key]] }
            get    { set v [dict get $::fakeReg $key]; set n [lindex $args 0]
                     if {![dict exists $v $n]} { error "no value" }; return [dict get $v $n] }
            keys   {
                set out {}
                foreach k [dict keys $::fakeReg] {
                    if {[string first "$key\\" $k] == 0} {
                        set first [lindex [split [string range $k [string length $key\\] end] \\] 0]
                        if {$first ni $out} { lappend out $first }
                    }
                }
                if {![llength $out]} { error "no key" }
                return $out
            }
        }
    }
    # Windows has loaded the real package already (collect in 5.2): a second
    # "package provide" with another version is an error. Only shim then.
    if {[catch {package present registry}]} { package provide registry 1.3 }
    rename ${ns}::_winPowerShell ${ns}::_realPS
    proc ${ns}::_winPowerShell {timeout} {
        return {{"memory":29832380416,"cores":8,"disks":[{"DeviceID":"\\\\.\\PHYSICALDRIVE0","Model":"KINGSTON OM8PGP41024N-A0","Size":1024203640320,"MediaType":"Fixed hard disk media"}],"physical":[{"DeviceId":"0","MediaType":"Unspecified","BusType":"NVMe"}],"monitors":[{"InstanceName":"DISPLAY\\DEFAULT_MONITOR\\1&28A6823A&4&UID256","Status":"Unknown"},{"InstanceName":"DISPLAY\\ACI27F6\\1&a&UID1","Status":"Unknown"},{"InstanceName":"DISPLAY\\ACI27F6\\2&b&UID2","Status":"Unknown"},{"InstanceName":"DISPLAY\\ACI27F6\\3&c&UID3","Status":"Unknown"}]}}
    }
} -body {
    set i [${ns}::collect -platform windows]
    list [dict get $i os kernel] [dict get $i cpu cores] [dict get $i machine version] \
         [dict get $i machine boardVendor] [dict get [lindex [dict get $i disks] 0] type] \
         [llength [dict get $i displays]] [dict get [lindex [dict get $i displays] 0] present] \
         [string match {*(not connected)*} [${ns}::report $i]]
} -cleanup {
    # undo only what the setup got to
    catch {rename ::registry {}}
    if {$hadReg && [llength [info commands ::_realRegistry]]} {
        rename ::_realRegistry ::registry
    }
    if {[llength [info commands ${ns}::_realPS]]} {
        catch {rename ${ns}::_winPowerShell {}}
        rename ${ns}::_realPS ${ns}::_winPowerShell
    }
} -result {10.0.26300 8 {} {} ssd 1 0 1}

test tusysinfo-9.1 {an unreadable PowerShell answer is a warning, not empty data} -setup {
    rename ${ns}::_winPowerShell ${ns}::_realPS
    proc ${ns}::_winPowerShell {timeout} { return "\{kaputt" }
    set hadReg [llength [info commands ::registry]]
    if {$hadReg} { rename ::registry ::_realRegistry }
    proc ::registry {args} { error "no key" }
    if {[catch {package present registry}]} { package provide registry 1.3 }
} -body {
    set i [${ns}::collect -platform windows -sections {memory}]
    list [llength [dict get $i warnings]] [string match "*--- Warnings ---*" [${ns}::report $i]]
} -cleanup {
    catch {rename ::registry {}}
    if {$hadReg && [llength [info commands ::_realRegistry]]} { rename ::_realRegistry ::registry }
    if {[llength [info commands ${ns}::_realPS]]} {
        catch {rename ${ns}::_winPowerShell {}}
        rename ${ns}::_realPS ${ns}::_winPowerShell
    }
} -result {1 1}

cleanupTests
