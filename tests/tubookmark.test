package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tubookmark 0.3

set ::SAMPLE {<!DOCTYPE NETSCAPE-Bookmark-file-1>
<TITLE>Bookmarks</TITLE>
<H1>Bookmarks</H1>
<DL><p>
    <DT><A HREF="https://tcl.tk/" ADD_DATE="1700000000" TAGS="tcl,lang">Tcl &amp; Tk</A>
    <DT><H3>Dev</H3>
    <DL><p>
        <DT><A HREF="https://core.tcl-lang.org/">Fossil</A>
        <DT><H3>Docs</H3>
        <DL><p>
            <DT><A HREF="https://www.tcl-lang.org/man/">Manual</A>
        </DL><p>
    </DL><p>
</DL><p>}

test tubookmark-1.1 {parse count} -body {
    llength [::tclutils::tubookmark::parse $::SAMPLE]
} -result 3

test tubookmark-1.2 {top-level bookmark: title entity, tags} -body {
    set b [lindex [::tclutils::tubookmark::parse $::SAMPLE] 0]
    list [dict get $b title] [dict get $b url] [dict get $b folder] [dict get $b tags] [dict get $b adddate]
} -result {{Tcl & Tk} https://tcl.tk/ {} {tcl lang} 1700000000}

test tubookmark-1.3 {nested folder path} -body {
    set all [::tclutils::tubookmark::parse $::SAMPLE]
    set manual [lindex $all end]
    list [dict get $manual title] [dict get $manual folder]
} -result {Manual Dev/Docs}

test tubookmark-1.4 {mid folder} -body {
    set all [::tclutils::tubookmark::parse $::SAMPLE]
    set fossil [lindex $all 1]
    list [dict get $fossil url] [dict get $fossil folder]
} -result {https://core.tcl-lang.org/ Dev}

test tubookmark-2.1 {serialize contains entries and folder} -body {
    set bms [list \
        [dict create title "A & B" url http://a.test folder "" tags {x} adddate ""] \
        [dict create title Deep url http://b.test folder "Work/Sub" tags {} adddate ""]]
    set html [::tclutils::tubookmark::serialize $bms]
    list [string match {*HREF="http://a.test"*} $html] \
         [string match {*TAGS="x"*} $html] \
         [string match {*<H3>Work</H3>*} $html] \
         [string match {*<H3>Sub</H3>*} $html] \
         [string match {*A &amp; B*} $html]
} -result {1 1 1 1 1}

test tubookmark-3.1 {round-trip (normalized, sorted by url)} -body {
    set bms [list \
        [dict create title One url http://1.test folder "" tags {a b} adddate "111"] \
        [dict create title Two url http://2.test folder "F1" tags {} adddate ""] \
        [dict create title Three url http://3.test folder "F1/F2" tags {z} adddate ""]]
    set rt [::tclutils::tubookmark::parse [::tclutils::tubookmark::serialize $bms]]
    proc norm {lst} {
        set o {}
        foreach b $lst {
            lappend o [list [dict get $b title] [dict get $b url] [dict get $b folder] [dict get $b tags]]
        }
        return [lsort -index 1 $o]
    }
    expr {[norm $rt] eq [norm $bms]}
} -result 1


test tubookmark-4.1 {header lines start at column 0} -body {
    set html [::tclutils::tubookmark::serialize {}]
    lrange [split $html \n] 0 4
} -result {{<!DOCTYPE NETSCAPE-Bookmark-file-1>} {<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">} <TITLE>Bookmarks</TITLE> <H1>Bookmarks</H1> <DL><p>}

test tubookmark-4.2 {quotes in TAGS, ADD_DATE and HREF are escaped} -body {
    set bms [list [dict create title T url {http://x.test/?q="1"} \
        folder "" tags {a"b c} adddate {1"2}]]
    set html [::tclutils::tubookmark::serialize $bms]
    set b [lindex [::tclutils::tubookmark::parse $html] 0]
    list [string match {*TAGS="a&quot;b,c" ADD_DATE="1&quot;2"*} $html] \
        [dict get $b url] [dict get $b tags] [dict get $b adddate]
} -result [list 1 {http://x.test/?q="1"} [list {a"b} c] {1"2}]

test tubookmark-4.3 {two links in one line are two bookmarks} -body {
    set html {<DL><p><DT><A HREF="http://a.test">A</A><DT><A HREF="http://b.test">B</A></DL>}
    set out {}
    foreach b [::tclutils::tubookmark::parse $html] {
        lappend out [dict get $b title] [dict get $b url]
    }
    set out
} -result {A http://a.test B http://b.test}

test tubookmark-4.4 {a title with markup stays inside its link} -body {
    set html {<DT><A HREF="http://a.test">a <b>x</b></A> <A HREF="http://b.test">B</A>}
    llength [::tclutils::tubookmark::parse $html]
} -result 2

test tubookmark-3.1 {order kept, folder name with a slash stays one folder (0.3)} -body {
    set html {<!DOCTYPE NETSCAPE-Bookmark-file-1>
<DL><p>
<DT><A HREF="https://top.example/">Top</A>
<DT><H3>Z Ordner</H3>
<DL><p><DT><A HREF="https://z.example/">Z</A></DL><p>
<DT><H3>A/B</H3>
<DL><p><DT><A HREF="https://ab.example/">AB</A></DL><p>
<DT><H3>A Ordner</H3>
<DL><p><DT><A HREF="https://a.example/">A</A></DL><p>
<DT><A HREF="https://last.example/">Last</A>
</DL><p>}
    set again [::tclutils::tubookmark::parse [::tclutils::tubookmark::serialize \
        [::tclutils::tubookmark::parse $html]]]
    list [lmap b $again {dict get $b title}] [lmap b $again {dict get $b folders}] \
         [regexp -all {<H3>} [::tclutils::tubookmark::serialize $again]]
} -result {{Top Z AB A Last} {{} {{Z Ordner}} A/B {{A Ordner}} {}} 3}

test tubookmark-3.2 {HREF in single quotes and unquoted; serialize writes it back} -body {
    set html {<DL><p>
<DT><A HREF='https://single.example/' ADD_DATE=1700000000 TAGS='a, b'>S</A>
</DL><p>}
    set b [lindex [::tclutils::tubookmark::parse $html] 0]
    list [dict get $b url] [dict get $b adddate] [dict get $b tags] \
         [string match {*HREF="https://single.example/"*} [::tclutils::tubookmark::serialize [list $b]]]
} -result {https://single.example/ 1700000000 {a b} 1}

test tubookmark-3.3 {folder without folders key: split at / as before} -body {
    set out [::tclutils::tubookmark::serialize [list [dict create title T url u folder X/Y]]]
    regexp -all {<H3>} $out
} -result 2

cleanupTests
