package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
package require tclutils::tupng
package require tclutils::tuimage
set haveTk [expr {![catch {package require Tk 8.6-}]}]
testConstraint haveTk $haveTk

# --- structure / dims (pure Tcl) ---
test tupng-1.1 {encodeRGB -> valid PNG, correct dims} -body {
    set png [::tclutils::tupng::encodeRGB {{FF0000 00FF00 0000FF} {FFFFFF 000000 808080}}]
    ::tclutils::tuimage::inspect $png
} -result {type png mime image/png width 3 height 2}
test tupng-1.2 {encodeRGBA dims} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tupng::encodeRGBA {{FF0000FF 00FF0080} {0000FF00 FFFFFFFF}}]
} -result {2 2}
test tupng-1.3 {encodeGray dims} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tupng::encodeGray {{0 128 255} {255 128 0}}]
} -result {3 2}
test tupng-1.4 {encodeIndexed dims} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tupng::encodeIndexed {FF0000 00FF00} {{0 1 0} {1 0 1}}]
} -result {3 2}
test tupng-1.5 {colour input forms are interchangeable} -body {
    set a [::tclutils::tupng::encodeRGB {{FF0000}}]
    set b [::tclutils::tupng::encodeRGB {{#FF0000}}]
    set c [::tclutils::tupng::encodeRGB {{{255 0 0}}}]
    list [expr {$a eq $b}] [expr {$a eq $c}]
} -result {1 1}

# --- filter modes all produce valid PNGs ---
test tupng-1.6 {all filter modes encode} -body {
    set img {{FF0000 00FF00 0000FF FFFFFF} {101010 202020 303030 404040}}
    set ok {}
    foreach f {none sub up average paeth best} {
        lappend ok [::tclutils::tuimage::type [::tclutils::tupng::encodeRGB $img -filter $f]]
    }
    lsort -unique $ok
} -result png

# --- error handling ---
test tupng-2.1 {ragged rows -> DIM} -body {
    catch {::tclutils::tupng::encodeRGB {{FF0000 00FF00} {0000FF}}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG DIM}
test tupng-2.2 {bad colour -> COLOR} -body {
    catch {::tclutils::tupng::encodeRGB {{ZZZZZZ}}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG COLOR}
test tupng-2.3 {index out of range -> INDEX} -body {
    catch {::tclutils::tupng::encodeIndexed {FF0000} {{0 5}}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG INDEX}
test tupng-2.4 {bad compression -> OPT} -body {
    catch {::tclutils::tupng::encodeRGB {{FF0000}} -compression 99} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG OPT}
test tupng-2.5 {bad filter -> OPT} -body {
    catch {::tclutils::tupng::encodeRGB {{FF0000}} -filter wat} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG OPT}
test tupng-2.6 {unknown option -> COMMON OPTION} -body {
    catch {::tclutils::tupng::encodeRGB {{FF0000}} -bogus 1} e o
    lrange [dict get $o -errorcode] 0 2
} -result {TCLUTILS COMMON OPTION}

# --- pixel correctness via Tk readback ---
test tupng-3.1 {RGB round-trips through Tk} -constraints haveTk -setup {
    set d [makeDirectory tp]; set f [file join $d rgb.png]
} -body {
    ::tclutils::tupng::writeRGB $f {{FF0000 00FF00} {0000FF FFFF00}}
    set img [image create photo -file $f]
    set r [list [$img get 0 0] [$img get 1 0] [$img get 0 1] [$img get 1 1]]
    image delete $img; set r
} -cleanup {removeDirectory tp} -result {{255 0 0} {0 255 0} {0 0 255} {255 255 0}}

test tupng-3.2 {gray round-trips through Tk} -constraints haveTk -setup {
    set d [makeDirectory tg]; set f [file join $d g.png]
} -body {
    ::tclutils::tupng::writeGray $f {{0 255} {128 64}}
    set img [image create photo -file $f]
    set r [list [$img get 0 0] [$img get 1 1]]
    image delete $img; set r
} -cleanup {removeDirectory tg} -result {{0 0 0} {64 64 64}}

test tupng-3.3 {RGBA alpha=0 pixel is transparent to Tk} -constraints haveTk -setup {
    set d [makeDirectory ta]; set f [file join $d a.png]
} -body {
    ::tclutils::tupng::writeRGBA $f {{FF0000FF 00FF0000}}
    set img [image create photo -file $f]
    set r [list [$img transparency get 0 0] [$img transparency get 1 0] [$img get 0 0]]
    image delete $img; set r
} -cleanup {removeDirectory ta} -result {0 1 {255 0 0}}

test tupng-3.4 {indexed with transparent palette entry} -constraints haveTk -setup {
    set d [makeDirectory ti]; set f [file join $d i.png]
} -body {
    # palette: 0=red opaque, 1=blue fully transparent
    ::tclutils::tupng::writeIndexed $f {FF0000 0000FF00} {{0 1}}
    set img [image create photo -file $f]
    set r [list [$img transparency get 0 0] [$img transparency get 1 0] [$img get 0 0]]
    image delete $img; set r
} -cleanup {removeDirectory ti} -result {0 1 {255 0 0}}

# --- encodeRGBARaw (packed-bytes fast path) -------------------------------
test tupng-3.1 {encodeRGBARaw dims + valid PNG} -body {
    set bytes [binary format c* {255 0 0 255  0 255 0 255  0 0 255 255  255 255 255 255}]
    ::tclutils::tuimage::inspect [::tclutils::tupng::encodeRGBARaw $bytes 2 2]
} -result {type png mime image/png width 2 height 2}

test tupng-3.2 {encodeRGBARaw matches encodeRGBA for the same pixels} -body {
    set img {{FF0000FF 00FF00FF} {0000FFFF FFFFFFFF}}
    set raw [binary format c* {255 0 0 255  0 255 0 255  0 0 255 255  255 255 255 255}]
    expr {[::tclutils::tupng::encodeRGBA $img] eq [::tclutils::tupng::encodeRGBARaw $raw 2 2]}
} -result 1

test tupng-3.3 {wrong byte length -> DIM} -body {
    catch {::tclutils::tupng::encodeRGBARaw [binary format c* {0 0 0}] 2 2} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG DIM}

test tupng-3.4 {non-positive dimension -> DIM} -body {
    catch {::tclutils::tupng::encodeRGBARaw "" 0 2} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG DIM}

# --- 0.3: decoder (round-trip + foreign-encoder inverse) -------------------
test tupng-4.1 {RGBA round-trip is byte-exact, all filters} -body {
    set W 5; set H 3; set buf {}
    for {set y 0} {$y < $H} {incr y} {
        for {set x 0} {$x < $W} {incr x} {
            lappend buf [expr {$x*50}] [expr {$y*80}] [expr {($x+$y)*30}] 255
        }
    }
    set packed [binary format cu* $buf]
    set d [::tclutils::tupng::decode \
        [::tclutils::tupng::encodeRGBARaw $packed $W $H -filter best -compression 9]]
    list [dict get $d width] [dict get $d height] [dict get $d colortype] \
        [expr {[dict get $d rgba] eq $packed}]
} -result {5 3 6 1}

test tupng-4.2 {RGB decodes to opaque RGBA} -body {
    set d [::tclutils::tupng::decode \
        [::tclutils::tupng::encodeRGB {{FF0000 00FF00 0000FF}} -filter paeth]]
    binary scan [dict get $d rgba] cu* px
    list [dict get $d colortype] $px
} -result {2 {255 0 0 255 0 255 0 255 0 0 255 255}}

test tupng-4.3 {grayscale decodes to RGB triplets} -body {
    set d [::tclutils::tupng::decode [::tclutils::tupng::encodeGray {{0 128 255}}]]
    binary scan [dict get $d rgba] cu* px
    list [dict get $d colortype] $px
} -result {0 {0 0 0 255 128 128 128 255 255 255 255 255}}

test tupng-4.4 {indexed decodes via palette incl. tRNS alpha} -body {
    set d [::tclutils::tupng::decode \
        [::tclutils::tupng::encodeIndexed {FF0000 00FF0080} {{0 1} {1 0}}]]
    binary scan [dict get $d rgba] cu* px
    list [dict get $d colortype] [lrange $px 0 7]
} -result {3 {255 0 0 255 0 255 0 128}}

test tupng-4.5 {bad signature -> DECODE SIGNATURE} -body {
    catch {::tclutils::tupng::decode "not a png"} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNG DECODE SIGNATURE}

cleanupTests
