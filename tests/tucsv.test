package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tucsv 0.2

test tucsv-1.1 {parse simple line} {
    ::tclutils::tucsv::parseLine {a,b,c}
} {a b c}

test tucsv-1.2 {parse quoted comma and escaped quote} {
    set row [::tclutils::tucsv::parseLine {a,"b,c","d""e"}]
    list [llength $row] [lindex $row 1] [lindex $row 2]
} [list 3 {b,c} {d"e}]

test tucsv-1.3 {join quotes where needed} {
    ::tclutils::tucsv::joinLine [list a {b,c} {d"e}]
} {a,"b,c","d""e"}

test tucsv-1.4 {parse multi-line quoted field} {
    set rows [::tclutils::tucsv::parse "name,note\nAlice,\"hello\nworld\"\n"]
    list [llength $rows] [lindex $rows 1 1]
} [list 2 "hello\nworld"]

test tucsv-1.5 {parse semicolon delimiter} {
    ::tclutils::tucsv::parseLine {a;b;c} -delimiter {;}
} {a b c}

test tucsv-1.6 {dict conversion uses first row as headers} {
    set rows [::tclutils::tucsv::parse "name;city\nAlice;Berlin" -delimiter {;}]
    ::tclutils::tucsv::dicts $rows
} {{name Alice city Berlin}}

test tucsv-1.7 {file roundtrip} {
    set tmp [file join [temporaryDirectory] tucsv-[pid].csv]
    ::tclutils::tucsv::writeFile $tmp [list [list a b] [list 1 {x,y}]]
    set result [::tclutils::tucsv::file $tmp]
    file delete -force $tmp
    list [llength $result] [lindex $result 1 1]
} [list 2 {x,y}]

test tucsv-1.8 {unterminated quote errors} -body {
    ::tclutils::tucsv::parseLine {a,"b}
} -returnCodes error -match glob -result {*unterminated*}

test tucsv-bom-1 {leading UTF-8 BOM is stripped} -body {
    set rows [::tclutils::tucsv::parse "\uFEFFid,name\n1,Alice\n"]
    lindex [lindex $rows 0] 0
} -result id

test tucsv-strict-1 {strict (default) errors on unterminated quote} -body {
    catch {::tclutils::tucsv::parse "a,\"open\n1,2\n"} e
    set e
} -result {unterminated quoted field}

test tucsv-strict-2 {lenient recovers instead of erroring} -body {
    set rows [::tclutils::tucsv::parse "a,b\n1,\"open and no close\n" -strict 0]
    expr {[llength $rows] >= 1}
} -result 1

test tucsv-3.1 {writeFile writes UTF-8 by default} -body {
    set tmp [file join [temporaryDirectory] tucsv-u-[pid].csv]
    ::tclutils::tucsv::writeFile $tmp [list [list T\u00e4mo \u00d6l]]
    set fh [open $tmp rb]; set raw [read $fh]; close $fh
    file delete -force $tmp
    binary encode hex $raw
} -result [binary encode hex [encoding convertto utf-8 "T\u00e4mo,\u00d6l"]]
test tucsv-3.2 {profile excel-de: semicolon, CRLF, BOM} -body {
    set tmp [file join [temporaryDirectory] tucsv-x-[pid].csv]
    ::tclutils::tucsv::writeFile $tmp [list {a b} {{x;y} 2}] -profile excel-de
    set fh [open $tmp rb]; set raw [read $fh]; close $fh
    file delete -force $tmp
    set raw
} -result [encoding convertto utf-8 "\ufeffa;b\r\n\"x;y\";2"]
test tucsv-3.3 {excel-de file reads back (BOM stripped)} -body {
    set tmp [file join [temporaryDirectory] tucsv-r-[pid].csv]
    ::tclutils::tucsv::writeFile $tmp [list {Name Ort} "T\u00e4mo Nordhafen"] -profile excel-de
    set r [::tclutils::tucsv::file $tmp -profile excel-de]
    file delete -force $tmp
    set r
} -result "{Name Ort} {T\u00e4mo Nordhafen}"
test tucsv-3.4 {text -bom and explicit options after the profile win} -body {
    ::tclutils::tucsv::text {{a b}} -profile excel-de -delimiter , -bom 0
} -result "a,b"
test tucsv-3.5 {unknown profile} -body {
    ::tclutils::tucsv::text {{a}} -profile excel-fr
} -returnCodes error -result {unknown profile "excel-fr": must be excel-de or rfc4180}
test tucsv-3.6 {-encoding for other files} -body {
    set tmp [file join [temporaryDirectory] tucsv-l-[pid].csv]
    ::tclutils::tucsv::writeFile $tmp [list [list \u00d6l]] -encoding iso8859-1
    set fh [open $tmp rb]; set raw [read $fh]; close $fh
    set back [::tclutils::tucsv::file $tmp -encoding iso8859-1]
    file delete -force $tmp
    list [string length $raw] $back
} -result "2 \u00d6l"

test tucsv-9.1 {a failed write leaves the old file, no temp file, no channel} -setup {
    set f [makeFile PRECIOUS tucsv-9.1.csv]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tclutils::tucsv::writeFile $f {{a b}}}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tucsv-9.1.csv
} -result {1 PRECIOUS 0 0}

cleanupTests
