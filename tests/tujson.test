package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tujson 0.1

test tujson-1.1 {quote escapes strings} -body {
    ::tclutils::tujson::quote "a\nb\\c\""
} -result {"a\nb\\c\""}

test tujson-1.2 {minify preserves string whitespace} -body {
    set json [string cat "\{" { "a" : "x y" , "b" : [ 1 , 2 ] } "\}"]
    ::tclutils::tujson::minify $json
} -result {{"a":"x y","b":[1,2]}}

test tujson-1.3 {pretty formats JSON} -body {
    set p [::tclutils::tujson::pretty {{"a":1,"b":[2,3]}} -indent "  "]
    set a [string first "\n  \"a\": 1" $p]
    set b [string first "\n  \"b\": \[" $p]
    expr {$a >= 0 && $b >= 0}
} -result 1

test tujson-1.4 {validate accepts matching structure} -body {
    ::tclutils::tujson::validate { {"a":[true,false,null]} }
} -result 1

test tujson-1.5 {validate rejects mismatch} -body {
    catch {::tclutils::tujson::validate { {"a": [1} }} msg
} -result 1

test tujson-1.6 {filePretty writes output} -setup {
    set tmp [makeDirectory tujson]
    set in [file join $tmp in.json]
    set out [file join $tmp out.json]
    set f [open $in w]; puts -nonewline $f {{"a":1}}; close $f
} -body {
    ::tclutils::tujson::filePretty $in $out
    string first "\n" [read [set f [open $out r]]]
} -cleanup {
    catch {close $f}
    removeDirectory tujson
} -result 1


test tujson-2.1 {parse empty object} -body {
    ::tclutils::tujson::parse {{}}
} -result {}

test tujson-2.2 {parse empty array} -body {
    ::tclutils::tujson::parse {[]}
} -result {}

test tujson-2.3 {parse object to dict} -body {
    set d [::tclutils::tujson::parse {{"name":"Gregor","city":"Vreden"}}]
    list [dict get $d name] [dict get $d city]
} -result {Gregor Vreden}

test tujson-2.4 {parse nested object} -body {
    set d [::tclutils::tujson::parse {{"customer":{"name":"Gregor","active":true}}}]
    list [dict get $d customer name] [dict get $d customer active]
} -result {Gregor 1}

test tujson-2.5 {parse array} -body {
    set d [::tclutils::tujson::parse {{"items":[1,2,3]}}]
    dict get $d items
} -result {1 2 3}

test tujson-2.6 {parse numbers} -body {
    set d [::tclutils::tujson::parse {{"i":-12,"r":3.50,"e":1.2e+3}}]
    list [dict get $d i] [dict get $d r] [dict get $d e]
} -result {-12 3.50 1.2e+3}

test tujson-2.7 {parse booleans and null} -body {
    set d [::tclutils::tujson::parse {{"t":true,"f":false,"n":null}}]
    list [dict get $d t] [dict get $d f] [dict get $d n]
} -result {1 0 {}}

test tujson-2.8 {parse unicode escape} -body {
    set d [::tclutils::tujson::parse {{"text":"M\u00fcller"}}]
    expr {[dict get $d text] eq [subst {M\u00fcller}]}
} -result 1

test tujson-2.9 {parse string escapes} -body {
    set d [::tclutils::tujson::parse {{"text":"A\nB\t\"Q\""}}]
    dict get $d text
} -result "A\nB\t\"Q\""

test tujson-2.10 {parse surrogate pair} -body {
    set d [::tclutils::tujson::parse {{"face":"\ud83d\ude00"}}]
    string length [dict get $d face]
} -result 1

test tujson-2.11 {fromJson alias} -body {
    set d [::tclutils::tujson::fromJson {{"a":1}}]
    dict get $d a
} -result 1

test tujson-2.12 {invalid trailing comma} -body {
    catch {::tclutils::tujson::parse {{"a":1,}}} msg opts
    list $msg [lrange [dict get $opts -errorcode] 0 2]
} -match glob -result {* {TCLUTILS TUJSON PARSE}}

test tujson-2.13 {invalid leading zero} -body {
    catch {::tclutils::tujson::parse {{"n":01}}} msg opts
    lrange [dict get $opts -errorcode] 0 2
} -result {TCLUTILS TUJSON PARSE}

# --- parseTyped: type-preserving parse ---

test tujson-3.1 {typed scalars} -body {
    list [::tclutils::tujson::parseTyped {"hi"}] \
         [::tclutils::tujson::parseTyped {42}] \
         [::tclutils::tujson::parseTyped {true}] \
         [::tclutils::tujson::parseTyped {false}] \
         [::tclutils::tujson::parseTyped {null}]
} -result {{string hi} {number 42} {boolean true} {boolean false} {null {}}}

test tujson-3.2 {empty object and array are distinguishable} -body {
    list [::tclutils::tujson::parseTyped {{}}] [::tclutils::tujson::parseTyped {[]}]
} -result {{object {}} {array {}}}

test tujson-3.3 {typed object preserves keys and order} -body {
    set t [::tclutils::tujson::parseTyped {{"b":1,"a":2}}]
    list [lindex $t 0] [dict keys [lindex $t 1]]
} -result {object {b a}}

test tujson-3.4 {typed nested access} -body {
    set t [::tclutils::tujson::parseTyped {{"meta":{"age":30},"tags":["x","y"]}}]
    set obj [lindex $t 1]
    set age [dict get [lindex [dict get $obj meta] 1] age]
    set tags [lindex [dict get $obj tags] 1]
    list $age [llength $tags] [lindex $tags 0]
} -result {{number 30} 2 {string x}}

test tujson-3.5 {typed array of mixed scalars} -body {
    lindex [::tclutils::tujson::parseTyped {[1,"a",true,null]}] 1
} -result {{number 1} {string a} {boolean true} {null {}}}

test tujson-3.6 {parseTyped rejects trailing data} -body {
    catch {::tclutils::tujson::parseTyped {1 2}} msg opts
    lrange [dict get $opts -errorcode] 0 2
} -result {TCLUTILS TUJSON PARSE}

test tujson-tojson-1 {round-trip object/array/scalars via parseTyped} -body {
    set j {{"a":1,"b":[true,null,"x"],"c":{"d":-2.5}}}
    string equal [::tclutils::tujson::minify $j] \
        [::tclutils::tujson::minify [::tclutils::tujson::toJson [::tclutils::tujson::parseTyped $j]]]
} -result 1

test tujson-tojson-2 {compact encode of hand-built value} -body {
    ::tclutils::tujson::toJson [::tclutils::tujson::obj [list \
        name [::tclutils::tujson::str Alice] \
        age  [::tclutils::tujson::num 30] \
        ok   [::tclutils::tujson::bool 1] \
        tags [::tclutils::tujson::arr [list [::tclutils::tujson::str x] [::tclutils::tujson::str y]]] \
        note [::tclutils::tujson::null]]]
} -result {{"name":"Alice","age":30,"ok":true,"tags":["x","y"],"note":null}}

test tujson-tojson-3 {pretty with -indent 2} -body {
    ::tclutils::tujson::toJson [::tclutils::tujson::parseTyped {{"a":1,"b":[2,3]}}] -indent 2
} -result "\{\n  \"a\": 1,\n  \"b\": \[\n    2,\n    3\n  \]\n\}"

test tujson-tojson-4 {empty object and array} -body {
    return "[::tclutils::tujson::toJson [::tclutils::tujson::obj {}]]|[::tclutils::tujson::toJson [::tclutils::tujson::arr {}]]"
} -result {{}|[]}

test tujson-tojson-5 {string escaping is applied} -body {
    ::tclutils::tujson::toJson [::tclutils::tujson::str "a\"b\nc"]
} -result {"a\"b\nc"}

test tujson-tojson-6 {invalid number is rejected} -body {
    catch {::tclutils::tujson::num abc} e
    set e
} -result {not a number: "abc"}

test tujson-tojson-7 {unknown type is rejected} -body {
    catch {::tclutils::tujson::toJson {weird v}} e
    set e
} -result {unknown JSON type "weird"}

cleanupTests
