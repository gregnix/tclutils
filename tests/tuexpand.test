package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuexpand 0.2

test tuexpand-1.1 {tab at column 0 -> 8 spaces} {
    ::tclutils::tuexpand::expand "\tx"
} "        x"
test tuexpand-1.2 {tab aligns to next stop} {
    ::tclutils::tuexpand::expand "ab\tc"
} "ab      c"
test tuexpand-1.3 {custom tab width} {
    ::tclutils::tuexpand::expand "a\tb" -tabs 4
} "a   b"
test tuexpand-1.4 {multiple lines, trailing nl} {
    ::tclutils::tuexpand::expand "\ta\n\tb\n"
} "        a\n        b\n"
test tuexpand-1.5 {unexpand leading 8 spaces -> tab} {
    ::tclutils::tuexpand::unexpand "        x"
} "\tx"
test tuexpand-1.6 {unexpand leading only by default} {
    ::tclutils::tuexpand::unexpand "        a        b"
} "\ta        b"
test tuexpand-1.7 {unexpand -all converts inner runs} {
    ::tclutils::tuexpand::unexpand "        a        b" -all 1
} "\ta\t b"
test tuexpand-1.8 {expand then unexpand roundtrip leading} {
    set s "\t\tcode"
    ::tclutils::tuexpand::unexpand [::tclutils::tuexpand::expand $s]
} "\t\tcode"
test tuexpand-1.9 {4 leading spaces stay (cannot reach stop 8)} {
    ::tclutils::tuexpand::unexpand "    x"
} "    x"
test tuexpand-1.10 {invalid mode rejected} {
    # a real file: /dev/null does not exist on Windows, and the error came
    # from opening it instead of from the bad -mode
    set f [makeFile "x\n" tuexpand-mode.txt]
    catch {::tclutils::tuexpand::file $f -mode bogus} m o; dict get $o -errorcode
} {TCLUTILS TUEXPAND MODE}
test tuexpand-2.1 {unexpand without -all keeps inner tabs} {
    ::tclutils::tuexpand::unexpand "a\tb"
} "a\tb"
test tuexpand-2.2 {unexpand without -all: leading blanks only, rest copied} {
    ::tclutils::tuexpand::unexpand "   \tc  d\te"
} "\tc  d\te"
test tuexpand-2.3 {unexpand -all: run one column before a stop} {
    ::tclutils::tuexpand::unexpand "abcdefg          x" -all 1
} "abcdefg\t\t x"
test tuexpand-2.4 {unexpand -all: single space before a stop stays} {
    ::tclutils::tuexpand::unexpand "abcdefg x" -all 1
} "abcdefg x"
test tuexpand-2.5 {unexpand -all: two blanks over a stop, -tabs 4} {
    ::tclutils::tuexpand::unexpand "abc  x" -tabs 4 -all 1
} "abc\t x"
test tuexpand-2.6 {unexpand -all: spaces before a tab are absorbed} {
    ::tclutils::tuexpand::unexpand "ab  \tc" -all 1
} "ab\tc"
test tuexpand-2.7 {unexpand -all keeps a one-column tab} {
    ::tclutils::tuexpand::unexpand "abcdefg\tx" -all 1
} "abcdefg\tx"
test tuexpand-2.8 {expand rejects -all} {
    catch {::tclutils::tuexpand::expand "a\tb" -all 1} m o
    dict get $o -errorcode
} {TCLUTILS COMMON OPTION -all}
test tuexpand-2.9 {file -mode expand rejects -all} {
    set f [makeFile "x\n" tuexpand-all.txt]
    catch {::tclutils::tuexpand::file $f -mode expand -all 1} m o
    dict get $o -errorcode
} {TCLUTILS COMMON OPTION -all}

cleanupTests
