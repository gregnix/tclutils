package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuprovider 0.1

# a scratch tree for the local provider
set ::d [makeDirectory tuprov]
makeDirectory sub $::d
makeFile "hello" a.txt $::d
makeFile "world" [file join sub b.txt] $::d

test tuprovider-1.1 {local provider lists a directory} -body {
    set p [::tclutils::tuprovider open local]
    set names {}
    foreach e [$p list $::d] { lappend names [dict get $e name] }
    lsort $names
} -result {a.txt sub}

test tuprovider-1.2 {stat reports type and size} -body {
    set p [::tclutils::tuprovider open local]
    set e [$p stat [file join $::d a.txt]]
    list [dict get $e type] [dict get $e size]
} -result {file 6}

test tuprovider-1.3 {get returns raw bytes} -body {
    set p [::tclutils::tuprovider open local]
    string trim [$p get [file join $::d a.txt]]
} -result hello

test tuprovider-1.4 {local provider reports all caps} -body {
    set p [::tclutils::tuprovider open local]
    lsort [$p caps]
} -result {copy delete get list mkdir move put stat}

test tuprovider-1.5 {put then get round-trips} -body {
    set p [::tclutils::tuprovider open local]
    $p put [file join $::d new.txt] "data"
    set r [$p get [file join $::d new.txt]]
    file delete [file join $::d new.txt]
    set r
} -result data

test tuprovider-1.6 {caps of a read-only subclass excludes writers} -setup {
    # a provider that inherits Base and implements only readers reports exactly
    # those as caps -- the introspection walks the resolution chain.
    oo::class create ROProv {
        superclass ::tclutils::tuprovider::Base
        method list {dir}  { return {} }
        method stat {path} { return {} }
        method get  {path} { return "" }
    }
} -body {
    set p [ROProv new]
    lsort [$p caps]
} -cleanup {
    ROProv destroy
} -result {get list stat}

test tuprovider-1.7 {unknown scheme is an error} -body {
    catch {::tclutils::tuprovider open nosuchscheme} e
    string match {*unknown scheme*} $e
} -result 1


test tuprovider-1.8 {local head reads only a prefix} -setup {
    set f [file join [tcltest::temporaryDirectory] head_test.bin]
    set ch [open $f wb]; puts -nonewline $ch [string repeat "ABCD" 10000]; close $ch
} -body {
    set p [::tclutils::tuprovider open local]
    set h [$p head $f 16]
    list [string length $h] $h
} -cleanup {
    file delete [file join [tcltest::temporaryDirectory] head_test.bin]
} -result {16 ABCDABCDABCDABCD}

test tuprovider-1.9 {head len<=0 returns the whole file} -setup {
    set f [file join [tcltest::temporaryDirectory] head_test2.bin]
    set ch [open $f wb]; puts -nonewline $ch "hello world"; close $ch
} -body {
    set p [::tclutils::tuprovider open local]
    $p head $f 0
} -cleanup {
    file delete [file join [tcltest::temporaryDirectory] head_test2.bin]
} -result {hello world}

test tuprovider-1.10 {base head default truncates get output} -setup {
    oo::class create HeadProv {
        superclass ::tclutils::tuprovider::Base
        method get {path} { return "0123456789" }
    }
} -body {
    set p [HeadProv new]
    # no head override -> base default: get then truncate
    list [$p head x 4] [$p head x 0]
} -cleanup {
    HeadProv destroy
} -result {0123 0123456789}

cleanupTests
