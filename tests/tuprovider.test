package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuprovider 0.4

# a scratch tree for the local provider
set ::d [makeDirectory tuprov]
makeDirectory sub $::d
makeFile "hello" a.txt $::d
makeFile "world" [file join sub b.txt] $::d

test tuprovider-1.1 {local provider lists a directory} -body {
    set p [::tclutils::tuprovider open local]
    set names {}
    foreach e [$p list $::d] { lappend names [dict get $e name] }
    lsort $names
} -result {a.txt sub}

test tuprovider-1.2 {stat reports type and size} -body {
    set p [::tclutils::tuprovider open local]
    set e [$p stat [file join $::d a.txt]]
    list [dict get $e type] [dict get $e size]
} -result {file 6}

test tuprovider-1.3 {get returns raw bytes} -body {
    set p [::tclutils::tuprovider open local]
    string trim [$p get [file join $::d a.txt]]
} -result hello

test tuprovider-1.4 {local provider reports all caps} -body {
    set p [::tclutils::tuprovider open local]
    lsort [$p caps]
} -result {copy delete get list mkdir move put stat}

test tuprovider-1.5 {put then get round-trips} -body {
    set p [::tclutils::tuprovider open local]
    $p put [file join $::d new.txt] "data"
    set r [$p get [file join $::d new.txt]]
    file delete [file join $::d new.txt]
    set r
} -result data

test tuprovider-1.6 {caps of a read-only subclass excludes writers} -setup {
    # a provider that inherits Base and implements only readers reports exactly
    # those as caps -- the introspection walks the resolution chain.
    oo::class create ROProv {
        superclass ::tclutils::tuprovider::Base
        method list {dir}  { return {} }
        method stat {path} { return {} }
        method get  {path} { return "" }
    }
} -body {
    set p [ROProv new]
    lsort [$p caps]
} -cleanup {
    ROProv destroy
} -result {get list stat}

test tuprovider-1.7 {unknown scheme is an error} -body {
    catch {::tclutils::tuprovider open nosuchscheme} e
    string match {*unknown scheme*} $e
} -result 1


test tuprovider-1.8 {local head reads only a prefix} -setup {
    set f [file join [tcltest::temporaryDirectory] head_test.bin]
    set ch [open $f wb]; puts -nonewline $ch [string repeat "ABCD" 10000]; close $ch
} -body {
    set p [::tclutils::tuprovider open local]
    set h [$p head $f 16]
    list [string length $h] $h
} -cleanup {
    file delete [file join [tcltest::temporaryDirectory] head_test.bin]
} -result {16 ABCDABCDABCDABCD}

test tuprovider-1.9 {head len<=0 returns the whole file} -setup {
    set f [file join [tcltest::temporaryDirectory] head_test2.bin]
    set ch [open $f wb]; puts -nonewline $ch "hello world"; close $ch
} -body {
    set p [::tclutils::tuprovider open local]
    $p head $f 0
} -cleanup {
    file delete [file join [tcltest::temporaryDirectory] head_test2.bin]
} -result {hello world}

test tuprovider-1.10 {base head default truncates get output} -setup {
    oo::class create HeadProv {
        superclass ::tclutils::tuprovider::Base
        method get {path} { return "0123456789" }
    }
} -body {
    set p [HeadProv new]
    # no head override -> base default: get then truncate
    list [$p head x 4] [$p head x 0]
} -cleanup {
    HeadProv destroy
} -result {0123 0123456789}


# --- unreleased: head returns the bytes unchanged ---------------------------
test tuprovider-2.1 {local head keeps content that looks like a number} -setup {
    set f [file join [tcltest::temporaryDirectory] head_num.txt]
    set fh [open $f wb]; puts -nonewline $fh 010; close $fh
    set p [::tclutils::tuprovider open local]
} -body {
    list [$p head $f 0] [$p head $f 3]
} -cleanup {
    file delete $f
} -result {010 010}

test tuprovider-9.1 {a failed write leaves the old file, no temp file, no channel} -setup {
    set f [makeFile PRECIOUS tuprovider-9.1.bin]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {[::tclutils::tuprovider open local] put $f NEW}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tuprovider-9.1.bin
} -result {1 PRECIOUS 0 0}

# --- 0.4: hidden/system, unreadable entries ---------------------------------
testConstraint unixFs [expr {$::tcl_platform(platform) eq "unix"}]
testConstraint winFs  [expr {$::tcl_platform(platform) eq "windows"}]

test tuprovider-3.1 {local entries carry hidden and system} -setup {
    set dd [makeDirectory tuprov31]
    makeFile x .versteckt $dd
    makeFile x sichtbar.txt $dd
} -body {
    set p [::tclutils::tuprovider open local]
    set out {}
    foreach e [$p list $dd] { lappend out [dict get $e name] [dict get $e hidden] [dict get $e system] }
    $p destroy
    lsort -stride 3 $out
} -constraints unixFs -cleanup {
    removeDirectory tuprov31
} -result {.versteckt 1 0 sichtbar.txt 0 0}

test tuprovider-3.2 {stat carries hidden too} -setup {
    set dd [makeDirectory tuprov32]
    set f [makeFile x .h $dd]
} -body {
    set p [::tclutils::tuprovider open local]
    set e [$p stat $f]
    $p destroy
    dict get $e hidden
} -constraints unixFs -cleanup {
    removeDirectory tuprov32
} -result 1

test tuprovider-3.3 {on Windows the attribute decides, not the dot; each entry once} -setup {
    set dd [makeDirectory tuprov33]
    # name -> attributes; every case as a file and as a folder
    set cases {dot {} norm {} sys {-system 1} hid {-hidden 1} both {-hidden 1 -system 1}}
    foreach {n attrs} $cases {
        set f [makeFile x $n.txt $dd]
        set d [makeDirectory ${n}dir $dd]
        if {$n eq "dot"} { file rename $f [file join $dd .dot.txt]; file rename $d [file join $dd .dotdir] }
        if {[llength $attrs]} { file attributes $f {*}$attrs; file attributes $d {*}$attrs }
    }
} -body {
    set p [::tclutils::tuprovider open local]
    set out {}
    foreach e [$p list $dd] {
        lappend out [list [dict get $e name] [dict get $e type] [dict get $e hidden] [dict get $e system]]
    }
    $p destroy
    lsort -index 0 $out
} -constraints winFs -cleanup {
    foreach f [::tclutils::tuprovider localNames $dd] {
        catch {file attributes $f -hidden 0 -system 0}
    }
    removeDirectory tuprov33
} -result {{.dot.txt file 0 0} {.dotdir dir 0 0} {both.txt file 1 1} {bothdir dir 1 1} {hid.txt file 1 0} {hiddir dir 1 0} {norm.txt file 0 0} {normdir dir 0 0} {sys.txt file 0 1} {sysdir dir 0 1}}

test tuprovider-3.3a {Unix: dot names once, as file and folder} -setup {
    set dd [makeDirectory tuprov33a]
    makeFile x .dot.txt $dd
    makeDirectory .dotdir $dd
    makeFile x norm.txt $dd
    makeDirectory normdir $dd
} -body {
    set p [::tclutils::tuprovider open local]
    set out {}
    foreach e [$p list $dd] { lappend out [list [dict get $e name] [dict get $e type] [dict get $e hidden]] }
    $p destroy
    lsort -index 0 $out
} -constraints unixFs -cleanup {
    removeDirectory tuprov33a
} -result {{.dot.txt file 1} {.dotdir dir 1} {norm.txt file 0} {normdir dir 0}}

test tuprovider-3.3b {localNames: each entry once, no . or ..} -setup {
    set dd [makeDirectory tuprov33b]
    makeFile x a $dd
    makeFile x .b $dd
} -body {
    lsort [lmap f [::tclutils::tuprovider localNames $dd] {file tail $f}]
} -cleanup {
    removeDirectory tuprov33b
} -result {.b a}

test tuprovider-3.4 {hiddenFlags with the platform hook} -body {
    set ::tclutils::tuprovider::platform unix
    set r [::tclutils::tuprovider hiddenFlags /x/.a .a]
    lappend r {*}[::tclutils::tuprovider hiddenFlags /x/a a]
} -cleanup {
    set ::tclutils::tuprovider::platform ""
} -result {1 0 0 0}

test tuprovider-3.5 {a dangling symbolic link does not break the listing} -setup {
    set dd [makeDirectory tuprov35]
    makeFile x echt.txt $dd
    # Tcl links only to an existing target: link first, then remove it
    set ziel [makeFile x gibtsnicht $dd]
    file link -symbolic [file join $dd kaputt] $ziel
    file delete $ziel
} -body {
    set p [::tclutils::tuprovider open local]
    set out {}
    foreach e [$p list $dd] { lappend out [dict get $e name] [dict get $e mtime] }
    $p destroy
    set names [lsort [lmap {n m} $out {set n}]]
    list $names [expr {[dict get $out kaputt] eq ""}]
} -constraints unixFs -cleanup {
    removeDirectory tuprov35
} -result {{echt.txt kaputt} 1}

cleanupTests
