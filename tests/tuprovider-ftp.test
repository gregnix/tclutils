package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuprovider 0.1

if {![catch {package require tclutils::tuprovider::ftp}]} {
    testConstraint haveFtp 1
} else {
    testConstraint haveFtp 0
}

# The ftp provider forwards to the tcllib ftp package. Rather than reach a live
# FTP server (none in a test run), stand in a tiny ftp stub that returns a fixed
# LIST and canned results. Defined AFTER the package require so it OVERRIDES the
# real ftp procedures pulled in as a dependency -- this exercises the adapter's
# own logic (LIST parsing, caps, path->name), which is what is new here; the FTP
# traffic itself is tcllib's concern, tested there.
namespace eval ::ftp {}
proc ::ftp::Open {host user pass args} { return 1 }
proc ::ftp::Close {c} { return }
proc ::ftp::Cd {c path} { if {[string match *missing* $path]} { error "no" } ; return 1 }
proc ::ftp::Pwd {c} { return "/" }
proc ::ftp::List {c path} {
    return {
        "drwxr-xr-x 2 u g 4096 Jan 01 12:00 photos"
        "-rw-r--r-- 1 u g 1234 Jan 01 12:00 readme.txt"
        "-rw-r--r-- 1 u g  567 Jan 01 12:00 data file.csv"
    }
}
proc ::ftp::FileSize {c path} { return 1234 }
proc ::ftp::Get {c path args} {
    array set o $args
    if {[info exists o(-variable)]} { upvar 1 $o(-variable) v ; set v "the bytes" }
    return 1
}
proc ::ftp::Put    {c args}       { return 1 }
proc ::ftp::MkDir  {c path}       { return 1 }
proc ::ftp::Rename {c from to}    { return 1 }
proc ::ftp::Delete {c path}       { return 1 }

test tuprovider-ftp-1.1 {ftp loads and registers the scheme} -constraints haveFtp -body {
    set p [::tclutils::tuprovider open ftp ftp://example.com/pub]
    expr {$p ne ""}
} -result 1

test tuprovider-ftp-1.2 {caps are the full read/write set ftp supports} -constraints haveFtp -body {
    # ftp can list/stat/get/put/delete/mkdir/move but not copy (no server-side
    # copy), and caps must report exactly that.
    set p [::tclutils::tuprovider open ftp ftp://h/]
    set c [lsort [$p caps]]
    list [expr {"put" in $c}] [expr {"mkdir" in $c}] [expr {"move" in $c}] \
         [expr {"copy" in $c}]
} -result {1 1 1 0}

test tuprovider-ftp-1.3 {list parses the LIST output into entries} -constraints haveFtp -body {
    set p [::tclutils::tuprovider open ftp ftp://h/]
    set out {}
    foreach e [$p list /pub] {
        lappend out [list [dict get $e name] [dict get $e type]]
    }
    lsort $out
} -result {{photos dir} {readme.txt file} {{data file.csv} file}}

test tuprovider-ftp-1.4 {a directory entry is typed from the perms column} -constraints haveFtp -body {
    set p [::tclutils::tuprovider open ftp ftp://h/]
    foreach e [$p list /pub] {
        if {[dict get $e name] eq "photos"} { return [dict get $e type] }
    }
    return "?"
} -result dir

test tuprovider-ftp-1.5 {get returns the fetched bytes} -constraints haveFtp -body {
    set p [::tclutils::tuprovider open ftp ftp://h/]
    $p get /readme.txt
} -result {the bytes}

test tuprovider-ftp-1.6 {stat reports dir for a cd-able path} -constraints haveFtp -body {
    set p [::tclutils::tuprovider open ftp ftp://h/]
    dict get [$p stat /pub] type
} -result dir

cleanupTests
