package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tupie

namespace eval M { namespace import ::tclutils::tupie::* }

proc pngSig {bytes} {
    binary scan $bytes H16 sig
    return $sig
}

# --- parse: header variants --------------------------------------------------

test tupie-1.1 {bare pie header, simple slices} -body {
    set m [M::parse "pie\n  \"A\" : 10\n  \"B\" : 20"]
    list [dict get $m title] [dict get $m showData] [llength [dict get $m slices]]
} -result {{} 0 2}

test tupie-1.2 {pie showData sets the flag} -body {
    dict get [M::parse "pie showData\n  \"A\" : 1"] showData
} -result 1

test tupie-1.3 {pie title on the header line} -body {
    dict get [M::parse "pie title Browser Share\n  \"A\" : 1"] title
} -result {Browser Share}

test tupie-1.4 {pie showData title combined} -body {
    set m [M::parse "pie showData title Sales\n  \"A\" : 1"]
    list [dict get $m showData] [dict get $m title]
} -result {1 Sales}

test tupie-1.5 {standalone title line} -body {
    dict get [M::parse "pie\n  title Q1\n  \"A\" : 1"] title
} -result Q1

# --- parse: slices -----------------------------------------------------------

test tupie-2.1 {quotes are optional on labels} -body {
    set m [M::parse "pie\n  Chrome : 5\n  \"Edge\" : 3"]
    lmap s [dict get $m slices] { lindex $s 0 }
} -result {Chrome Edge}

test tupie-2.2 {float values are kept} -body {
    lindex [lindex [dict get [M::parse "pie\n  \"A\" : 12.5"] slices] 0] 1
} -result 12.5

test tupie-2.3 {comments and blank lines are ignored} -body {
    set m [M::parse "%% a comment\npie\n\n  \"A\" : 1\n%% trailing"]
    llength [dict get $m slices]
} -result 1

# --- parse: errors -----------------------------------------------------------

test tupie-3.1 {no slices is an EMPTY error} -body {
    catch {M::parse "pie title only"} e o
    lindex [dict get $o -errorcode] end
} -result EMPTY

test tupie-3.2 {values summing to zero is a VALUE error} -body {
    catch {M::parse "pie\n  \"A\" : 0\n  \"B\" : 0"} e o
    lindex [dict get $o -errorcode] end
} -result VALUE

# --- render: SVG -------------------------------------------------------------

test tupie-4.1 {toSvg yields a well-formed svg document} -body {
    set svg [M::toSvg [M::parse "pie\n  \"A\" : 1\n  \"B\" : 1\n  \"C\" : 1"]]
    expr {[string match {<svg*} $svg] && [string match {*</svg>*} $svg]}
} -result 1

test tupie-4.2 {one wedge polygon per slice} -body {
    set svg [M::toSvg [M::parse "pie\n  \"A\" : 1\n  \"B\" : 1\n  \"C\" : 1\n  \"D\" : 1"]]
    regexp -all {<(polygon|path)\M} $svg
} -result 4

test tupie-4.3 {legend off removes the swatch rectangles} -body {
    set src "pie\n  \"A\" : 1\n  \"B\" : 1"
    set withLeg [regexp -all {<rect\M} [M::toSvg [M::parse $src] -legend 1]]
    set noLeg   [regexp -all {<rect\M} [M::toSvg [M::parse $src] -legend 0]]
    expr {$withLeg > $noLeg}
} -result 1

# --- render: PNG -------------------------------------------------------------

test tupie-5.1 {toPng yields valid PNG bytes} -body {
    pngSig [M::toPng [M::parse "pie\n  \"A\" : 1\n  \"B\" : 1"]]
} -result 89504e470d0a1a0a

test tupie-5.2 {integer -scale multiplies the raster dimensions} -body {
    set m [M::parse "pie\n  \"A\" : 1"]
    set p1 [M::toPng $m -width 200 -height 200 -scale 1]
    set p3 [M::toPng $m -width 200 -height 200 -scale 3]
    binary scan $p1 @16II w1 h1
    binary scan $p3 @16II w3 h3
    list $w1 $h1 $w3 $h3
} -result {200 200 600 600}

test tupie-5.3 {non-integer -scale is an ARG error} -body {
    catch {M::toPng [M::parse "pie\n  \"A\" : 1"] -scale 1.5} e o
    lindex [dict get $o -errorcode] end
} -result ARG

# --- render: stability over many slices (palette cycles) ---------------------

test tupie-6.1 {more slices than palette colours still renders} -body {
    set src "pie"
    for {set i 0} {$i < 14} {incr i} { append src "\n  \"S$i\" : [expr {$i + 1}]" }
    pngSig [M::toPng [M::parse $src]]
} -result 89504e470d0a1a0a

cleanupTests
