package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tucrc 0.2

set tmp [makeDirectory tucrc]
set f [makeFile "hello" [file join $tmp hello.txt]]

test tucrc-1.1 {crc32 matches Tcl zlib} -body {
    ::tclutils::tucrc::crc32 hello
} -result [zlib crc32 hello]

test tucrc-1.2 {adler32 matches Tcl zlib} -body {
    ::tclutils::tucrc::adler32 hello
} -result [zlib adler32 hello]

test tucrc-1.3 {hex32} -body {
    ::tclutils::tucrc::hex32 [::tclutils::tucrc::crc32 hello]
} -result 3610A686

test tucrc-1.4 {file crc32} -body {
    ::tclutils::tucrc::crc32File $f
} -result [zlib crc32 "hello\n"]

test tucrc-2.1 {-encoding utf-8 equals the crc of the UTF-8 bytes} -body {
    expr {[::tclutils::tucrc::crc32 "J\u00f6rg" -encoding utf-8]
          == [zlib crc32 [encoding convertto utf-8 "J\u00f6rg"]]}
} -result 1
test tucrc-2.2 {init value and -encoding together} -body {
    expr {[::tclutils::tucrc::adler32 "\u00e4" 1 -encoding utf-8]
          == [zlib adler32 [encoding convertto utf-8 "\u00e4"] 1]}
} -result 1
test tucrc-2.3 {bytes by default: a character above 255 is an error} -body {
    catch {::tclutils::tucrc::crc32 "\u20ac"} m o
    dict get $o -errorcode
} -result {TCLUTILS TUCRC BYTES}
test tucrc-2.4 {wrong option} -body {
    catch {::tclutils::tucrc::crc32 x -enc utf-8} m o
    dict get $o -errorcode
} -result {TCLUTILS TUCRC OPTION}

cleanupTests
