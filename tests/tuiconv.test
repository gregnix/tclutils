package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuiconv 0.1

proc writeBinaryTestFile {path bytes} {
    set fh [open $path wb]
    try {
        fconfigure $fh -translation binary -encoding iso8859-1
        puts -nonewline $fh $bytes
    } finally {
        close $fh
    }
    return $path
}

test tuiconv-1.1 {encodings contains utf-8} -body {
    expr {[lsearch -exact [::tclutils::tuiconv::encodings] utf-8] >= 0}
} -result 1

test tuiconv-1.2 {convert utf-8 to cp1252 bytes} -body {
    set input [encoding convertto utf-8 \u00e4]
    binary scan [::tclutils::tuiconv::convert $input utf-8 cp1252] H* hex
    set hex
} -result e4

set encFile [file join [temporaryDirectory] tuiconv-cp1252.txt]
writeBinaryTestFile $encFile [encoding convertto cp1252 "\u00e4\u00f6\u00fc"]

test tuiconv-1.3 {read file with explicit encoding} -body {
    ::tclutils::tuiconv::readFile $encFile cp1252
} -result "\u00e4\u00f6\u00fc"

test tuiconv-1.4 {write file with explicit encoding} -body {
    set out [file join [temporaryDirectory] tuiconv-out.txt]
    ::tclutils::tuiconv::writeFile $out \u00e4 cp1252
    set fh [open $out rb]
    try {
        fconfigure $fh -translation binary -encoding iso8859-1
        binary scan [read $fh] H* hex
    } finally {
        close $fh
    }
    set hex
} -result e4

test tuiconv-1.5 {convert file} -body {
    set out [file join [temporaryDirectory] tuiconv-utf8.txt]
    ::tclutils::tuiconv::convertFile $encFile $out cp1252 utf-8
    ::tclutils::tuiconv::readFile $out utf-8
} -result "\u00e4\u00f6\u00fc"

foreach f [list $encFile [file join [temporaryDirectory] tuiconv-out.txt] [file join [temporaryDirectory] tuiconv-utf8.txt]] { catch {file delete -force $f} }
cleanupTests
