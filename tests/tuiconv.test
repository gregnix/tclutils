package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuiconv 0.2

proc writeBinaryTestFile {path bytes} {
    set fh [open $path wb]
    try {
        fconfigure $fh -translation binary -encoding iso8859-1
        puts -nonewline $fh $bytes
    } finally {
        close $fh
    }
    return $path
}

test tuiconv-1.1 {encodings contains utf-8} -body {
    expr {[lsearch -exact [::tclutils::tuiconv::encodings] utf-8] >= 0}
} -result 1

test tuiconv-1.2 {convert utf-8 to cp1252 bytes} -body {
    set input [encoding convertto utf-8 \u00e4]
    binary scan [::tclutils::tuiconv::convert $input utf-8 cp1252] H* hex
    set hex
} -result e4

set encFile [file join [temporaryDirectory] tuiconv-cp1252.txt]
writeBinaryTestFile $encFile [encoding convertto cp1252 "\u00e4\u00f6\u00fc"]

test tuiconv-1.3 {read file with explicit encoding} -body {
    ::tclutils::tuiconv::readFile $encFile cp1252
} -result "\u00e4\u00f6\u00fc"

test tuiconv-1.4 {write file with explicit encoding} -body {
    set out [file join [temporaryDirectory] tuiconv-out.txt]
    ::tclutils::tuiconv::writeFile $out \u00e4 cp1252
    set fh [open $out rb]
    try {
        fconfigure $fh -translation binary -encoding iso8859-1
        binary scan [read $fh] H* hex
    } finally {
        close $fh
    }
    set hex
} -result e4

test tuiconv-1.5 {convert file} -body {
    set out [file join [temporaryDirectory] tuiconv-utf8.txt]
    ::tclutils::tuiconv::convertFile $encFile $out cp1252 utf-8
    ::tclutils::tuiconv::readFile $out utf-8
} -result "\u00e4\u00f6\u00fc"

foreach f [list $encFile [file join [temporaryDirectory] tuiconv-out.txt] [file join [temporaryDirectory] tuiconv-utf8.txt]] { catch {file delete -force $f} }
# --- 0.2: strict on Tcl 8.6 and 9 --------------------------------------------

test tuiconv-3.1 {a character the target cannot hold is an error} -body {
    list [catch {::tclutils::tuiconv::convert [encoding convertto utf-8 "Jörg €"] utf-8 iso8859-1} m] \
        $::errorCode $m
} -result {1 {TCLUTILS TUICONV UNMAPPABLE iso8859-1} {character U+20AC at index 5 cannot be written in iso8859-1}}

test tuiconv-3.2 {-replace 1 writes ?} -body {
    binary encode hex [::tclutils::tuiconv::convert [encoding convertto utf-8 "Jörg €"] utf-8 iso8859-1 -replace 1]
} -result 4af67267203f

test tuiconv-3.3 {invalid source bytes are an error} -body {
    list [catch {::tclutils::tuiconv::convert "a\xFFb" utf-8 cp1252} m] $::errorCode
} -result {1 {TCLUTILS TUICONV INVALID utf-8}}

test tuiconv-3.4 {writeFile: on an error the file stays} -body {
    set f [makeFile alt tuiconv34.txt]
    catch {::tclutils::tuiconv::writeFile $f "€" iso8859-1}
    string trim [::tclutils::tuiconv::readFile $f utf-8]
} -result alt

test tuiconv-3.5 {valid text passes unchanged} -body {
    ::tclutils::tuiconv::convert [::tclutils::tuiconv::convert [encoding convertto utf-8 "Jörg"] utf-8 cp1252] cp1252 utf-8
} -result [encoding convertto utf-8 "Jörg"]

test tuiconv-9.1 {a failed write leaves the old file, no temp file, no channel} -setup {
    set f [makeFile PRECIOUS tuiconv-9.1.txt]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {::tclutils::tuiconv::writeFile $f abc iso8859-1}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tuiconv-9.1.txt
} -result {1 PRECIOUS 0 0}

cleanupTests
