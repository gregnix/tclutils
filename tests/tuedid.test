test tuedid-2.1 {real block: BenQ RD280U (3:2, 3840x2560, extension block)} -body {
    set d [${ns}::parseHex $::benq]
    lmap k {valid version manufacturer vendor productCode serial serialText name
            week year digital widthCm heightCm diagonal preferred extensions} {dict get $d $k}
} -result {1 1.4 BNQ BenQ 805B 0 XXXXXXXXXXX {BenQ RD280U} 46 2023 1 60 40 28.4 {width 3840 height 2560 refresh 59.98} 1}

test tuedid-2.2 {real block: ASUS VE278 (1920x1080)} -body {
    set d [${ns}::parseHex $::asus]
    lmap k {valid manufacturer vendor productCode serialText name week year
            widthCm heightCm diagonal preferred extensions} {dict get $d $k}
} -result {1 ACI ASUS 27F6 XXXXXXXXXXXX {ASUS VE278} 22 2013 60 34 27.2 {width 1920 height 1080 refresh 60.0} 1}

cleanupTests
