# tufetch.test -- tests for tclutils::tufetch.
#
# tufetch needs either the tls package or a curl/wget binary to actually move
# bytes, so the network round-trips are gated behind the `net` constraint
# (enable with env TUFETCH_NET=1). The option-handling and temp-dir logic, and
# the "no transport available" path, are checked without any network.
#
# Constraints:
#   notls  - the tls package is NOT installed (then the NOMETHOD path is reachable)
#   net    - real network access is wanted (env TUFETCH_NET set to a true value)

package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tufetch 0.5

proc opts {args} {
    ::tclutils::common::parseOptions $::tclutils::tufetch::defaults {*}$args
}

testConstraint notls [catch {package require tls}]
testConstraint net   [expr {[info exists ::env(TUFETCH_NET)] && $::env(TUFETCH_NET)}]

set ::RAW https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.teams.json

# ---------------------------------------------------------------------------
# no network needed
# ---------------------------------------------------------------------------
test tufetch-1.1 {an unknown option is rejected before any I/O} -body {
    catch {::tclutils::tufetch::download https://example.org/x /tmp/none -bogus 1} e o
    lrange [dict get $o -errorcode] 0 2
} -result {TCLUTILS COMMON OPTION}

test tufetch-1.2 {_tmpdir returns an existing directory} -body {
    file isdirectory [::tclutils::tufetch::_tmpdir]
} -result 1

test tufetch-1.3 {_tmpdir honours TMPDIR} -setup {
    set ::keepEnv [array get ::env]
    foreach v {TMPDIR TEMP TMP} { unset -nocomplain ::env($v) }
    set ::env(TMPDIR) [temporaryDirectory]
} -body {
    ::tclutils::tufetch::_tmpdir
} -cleanup {
    foreach v {TMPDIR TEMP TMP} { unset -nocomplain ::env($v) }
    array set ::env $::keepEnv
} -result [temporaryDirectory]

test tufetch-1.4 {with no tls and no curl/wget, download reports NOMETHOD} -constraints notls -setup {
    rename ::auto_execok ::tufetch_saved_auto_execok
    proc ::auto_execok {name} { return "" }
} -body {
    catch {::tclutils::tufetch::download https://example.org/x \
        [file join [temporaryDirectory] tufetch-none.tmp] -timeout 1000} e o
    dict get $o -errorcode
} -cleanup {
    rename ::auto_execok {}
    rename ::tufetch_saved_auto_execok ::auto_execok
} -result {TCLUTILS TUFETCH NOMETHOD}

# --- request construction (pure helpers, no network) ---
test tufetch-1.5 {curl GET arg list} -body {
    set a [::tclutils::tufetch::_curlArgs http://x /tmp/o [opts]]
    list [string match {*-X GET*} $a] [string match {*-- http://x*} $a]
} -result {1 1}

test tufetch-1.6 {curl POST builds method, headers, content-type and body} -body {
    set a [::tclutils::tufetch::_curlArgs https://ep /tmp/o \
        [opts -method post -headers {Accept A} -data BODY -type CT]]
    list [string match {*-X POST*} $a] \
         [string match "*-H {Accept: A}*" $a] \
         [string match "*-H {Content-Type: CT}*" $a] \
         [string match {*--data-binary BODY*} $a]
} -result {1 1 1 1}

test tufetch-1.7 {native (http::geturl) options for POST} -body {
    set a [::tclutils::tufetch::_nativeOpts \
        [opts -method post -headers {Accept A} -data BODY -type CT] 9000]
    list [string match {*-method POST*} $a] [string match {*-query BODY*} $a] \
         [string match {*-type CT*} $a] [string match {*-headers {Accept A}*} $a]
} -result {1 1 1 1}

test tufetch-1.8 {wget arg list for POST: one argument per header} -body {
    # Checked per LIST ELEMENT, not by string match on the whole list: up to
    # 0.3 "--header=Accept:" and "A" were two elements, and a string match on
    # "--header=Accept: A" still found them side by side and passed.
    set a [::tclutils::tufetch::_wgetArgs https://ep /tmp/o \
        [opts -method post -headers {Accept A} -data BODY -type CT]]
    list [expr {[lsearch -exact $a --method=POST] >= 0}] \
         [expr {[lsearch -exact $a "--header=Accept: A"] >= 0}] \
         [expr {[lsearch -exact $a "--header=Content-Type: CT"] >= 0}] \
         [expr {[lsearch -exact $a --body-data=BODY] >= 0}] \
         [expr {[lsearch -exact $a A] < 0}]
} -result {1 1 1 1 1}

test tufetch-1.9 {curl: verifies by default, -insecure -> -k, -cafile -> --cacert} -body {
    list [expr {[lsearch -exact [::tclutils::tufetch::_curlArgs https://x /o [opts]] -k] >= 0}] \
         [expr {[lsearch -exact [::tclutils::tufetch::_curlArgs https://x /o [opts -insecure 1]] -k] >= 0}] \
         [lrange [lindex [lsearch -all -inline -exact -index 0 \
             [lmap {a b} [::tclutils::tufetch::_curlArgs https://x /o [opts -cafile /ca.pem]] {list $a $b}] \
             --cacert] 0] 1 1]
} -result {0 1 /ca.pem}

test tufetch-1.10 {wget: verifies by default, -insecure / -cafile map to its flags} -body {
    list [expr {[lsearch -glob [::tclutils::tufetch::_wgetArgs https://x /o [opts]] --no-check*] >= 0}] \
         [expr {[lsearch -exact [::tclutils::tufetch::_wgetArgs https://x /o [opts -insecure 1]] --no-check-certificate] >= 0}] \
         [expr {[lsearch -exact [::tclutils::tufetch::_wgetArgs https://x /o [opts -cafile /ca.pem]] --ca-certificate=/ca.pem] >= 0}]
} -result {0 1 1}

test tufetch-1.11 {-insecure must be boolean} -body {
    catch {::tclutils::tufetch::download https://x [file join [temporaryDirectory] t.tmp] -insecure maybe} m o
    lrange [dict get $o -errorcode] 0 2
} -result {TCLUTILS COMMON BOOLEAN}

test tufetch-1.12 {unknown option names the known ones} -body {
    catch {::tclutils::tufetch::get https://x -insecur 1} m
    string match "*Known:*-insecure*-cafile*" $m
} -result 1

# ---------------------------------------------------------------------------
# certificate verification against a local self-signed server (no network)
# ---------------------------------------------------------------------------
testConstraint tls  [expr {![catch {package require tls}]}]
testConstraint tls1 [expr {[testConstraint tls] && [package vcompare [package provide tls] 2.0] < 0}]
# Default verification needs a CA bundle under tls 1.x (and 2.0 betas).
testConstraint caOK [expr {[testConstraint tls] && (![testConstraint tls1]
    || (![catch {package require tclutils::tuhttps}] && [::tclutils::tuhttps::caFile] ne ""))}]
set crt [file join $here data tuhttps-localhost.crt]
set key [file join $here data tuhttps-localhost.key]
set lport 0
if {[testConstraint tls]} {
    set srvPipe [open |[list [info nameofexecutable] \
        [file join $here data https-server.tcl] $crt $key] r+]
    gets $srvPipe lport
}
set lurl https://localhost:$lport/
proc httpsReg {} {
    if {[info exists ::http::urlTypes(https)]} { return $::http::urlTypes(https) }
    return <none>
}

test tufetch-4.1 {a self-signed certificate is rejected by default, with the way out} -constraints {tls caOK} -body {
    catch {::tclutils::tufetch::get $lurl -timeout 5000} m o
    list [dict get $o -errorcode] [string match {*-cafile*-insecure 1*} $m]
} -result {{TCLUTILS TUFETCH CONNECT} 1}

test tufetch-4.2 {the same certificate as -cafile is accepted} -constraints tls -body {
    ::tclutils::tufetch::get $lurl -timeout 5000 -cafile $crt
} -result ok

test tufetch-4.3 {-insecure 1 accepts it} -constraints tls -body {
    ::tclutils::tufetch::get $lurl -timeout 5000 -insecure 1
} -result ok

test tufetch-4.4 {tufetch leaves the https registration as it found it} -constraints tls -setup {
    catch {::http::unregister https}
} -body {
    ::tclutils::tufetch::get $lurl -timeout 5000 -insecure 1
    set a [httpsReg]
    ::http::register https 443 [list MarkerSocket]
    ::tclutils::tufetch::get $lurl -timeout 5000 -insecure 1
    list $a [lindex [httpsReg] 1]
} -cleanup {
    catch {::http::unregister https}
} -result {<none> MarkerSocket}

test tufetch-4.5 {after tufetch -insecure 1, the application's own geturl still verifies} \
    -constraints {tls caOK} -setup {
    package require tclutils::tuhttps
    ::http::register https 443 [::tclutils::tuhttps::socketCmd -host localhost]
} -body {
    # The case measured on 2026-09-19 with 0.3: after one tufetch call every
    # later geturl in the process accepted any certificate.
    ::tclutils::tufetch::get $lurl -timeout 5000 -insecure 1
    catch {set t [::http::geturl $lurl -timeout 5000]; ::http::cleanup $t}
} -cleanup {
    catch {::http::unregister https}
} -result 1

test tufetch-4.6 {tls 1.x without CA bundle and without curl/wget: NOMETHOD names the way out} \
    -constraints tls1 -setup {
    set savedCa $::tclutils::tuhttps::caCandidates
    set ::tclutils::tuhttps::caCandidates {}
    set hadEnv [info exists ::env(SSL_CERT_FILE)]
    if {$hadEnv} { set savedEnv $::env(SSL_CERT_FILE); unset ::env(SSL_CERT_FILE) }
    rename ::auto_execok ::tufetch_saved_auto_execok
    proc ::auto_execok {name} { return "" }
} -body {
    catch {::tclutils::tufetch::get $lurl -timeout 5000} m o
    list [dict get $o -errorcode] [string match {*-cafile*} $m]
} -cleanup {
    rename ::auto_execok {}
    rename ::tufetch_saved_auto_execok ::auto_execok
    set ::tclutils::tuhttps::caCandidates $savedCa
    if {$hadEnv} { set ::env(SSL_CERT_FILE) $savedEnv }
} -result {{TCLUTILS TUFETCH NOMETHOD} 1}

if {[info exists srvPipe]} { catch {close $srvPipe} }

# ---------------------------------------------------------------------------
# real network (only with TUFETCH_NET=1)
# ---------------------------------------------------------------------------
test tufetch-2.1 {download saves a non-empty file and names its method} -constraints net -setup {
    set ::out [file join [temporaryDirectory] tufetch-dl.json]
    file delete -force $::out
} -body {
    set method [::tclutils::tufetch::download $::RAW $::out]
    list [expr {$method in {native curl wget}}] [expr {[file size $::out] > 0}]
} -cleanup {
    file delete -force $::out
} -result {1 1}

test tufetch-2.2 {get returns decoded text with the expected content} -constraints net -body {
    set txt [::tclutils::tufetch::get $::RAW]
    list [string match {*Mexico*} $txt] [string match {*fifa_code*} $txt]
} -result {1 1}

# --- error taxonomy (pure, no network) -------------------------------------
test tufetch-3.1 {_httpClass maps a status code to its class} -body {
    lmap c {100 200 301 404 503 999 abc} {::tclutils::tufetch::_httpClass $c}
} -result {1XX 2XX 3XX 4XX 5XX {} {}}

test tufetch-3.2 {an HTTP error carries class and code in the errorcode} -body {
    catch {::tclutils::tufetch::_httpError 404 http://x/y} e o
    dict get $o -errorcode
} -result {TCLUTILS TUFETCH HTTP 4XX 404}

test tufetch-3.3 {try/trap distinguishes 404, any-4XX and any-5XX} -body {
    set hits {}
    try {
        ::tclutils::tufetch::_httpError 404 http://x
    } trap {TCLUTILS TUFETCH HTTP 4XX 404} {} {
        lappend hits exact-404
    } trap {TCLUTILS TUFETCH HTTP 5XX} {} {
        lappend hits any-5XX
    }
    try {
        ::tclutils::tufetch::_httpError 503 http://x
    } trap {TCLUTILS TUFETCH HTTP 4XX} {} {
        lappend hits any-4XX
    } trap {TCLUTILS TUFETCH HTTP} {err} {
        lappend hits status-503
    }
    set hits
} -result {exact-404 status-503}

test tufetch-3.4 {a non-http(s) URL is rejected with a URL errorcode} -body {
    catch {::tclutils::tufetch::download ftp://host/file /tmp/none} e o
    dict get $o -errorcode
} -result {TCLUTILS TUFETCH URL}

test tufetch-3.5 {status and curl-exit classification map to TIMEOUT/CONNECT} -body {
    list [::tclutils::tufetch::_statusReason timeout] \
         [::tclutils::tufetch::_statusReason reset] \
         [::tclutils::tufetch::_statusReason eof] \
         [::tclutils::tufetch::_curlExitReason 28] \
         [::tclutils::tufetch::_curlExitReason 7]
} -result {TIMEOUT CONNECT CONNECT TIMEOUT CONNECT}

test tufetch-2.3 {the curl path reports an HTTP status as a clean errorcode} -constraints net -body {
    catch {::tclutils::tufetch::download \
        https://raw.githubusercontent.com/openfootball/worldcup.json/master/NO_SUCH_FILE_xyz \
        [file join [temporaryDirectory] tufetch-404.tmp] -timeout 15000} e o
    lrange [dict get $o -errorcode] 0 4
} -result {TCLUTILS TUFETCH HTTP 4XX 404}


test tufetch-3.6 {a failed write leaves the old file} -setup {
    package require http
    set f [makeFile PRECIOUS tufetch-3.6.bin]
    foreach c {geturl status ncode data cleanup} {
        rename ::http::$c ::_tf_$c
    }
    proc ::http::geturl {url args} { return ::tf_tok }
    proc ::http::status {tok} { return ok }
    proc ::http::ncode {tok} { return 200 }
    proc ::http::data {tok} { return NEWBYTES }
    proc ::http::cleanup {tok} {}
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set o {-timeout 1000 -redirects 0 -method GET -headers {} -data {} -type {}}
    set rc [catch {::tclutils::tufetch::_nativeLoop http://example.test/x $f $o}]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    foreach c {geturl status ncode data cleanup} {
        rename ::http::$c {}
        rename ::_tf_$c ::http::$c
    }
    removeFile tufetch-3.6.bin
} -result {1 PRECIOUS 0 0}

test tufetch-5.1 {_redirectUrl resolves relative Location forms (0.5)} -body {
    set f ::tclutils::tufetch::_redirectUrl
    list [$f https://h/a/b?q=1 /c] [$f https://h/a/b c] [$f https://h a] \
         [$f https://h/a/b ?x=1] [$f https://h/a //o/p] [$f http://h/a https://o/p]
} -result {https://h/c https://h/a/c https://h/a https://h/a/b?x=1 https://o/p https://o/p}

test tufetch-5.5 {_redirectUrl resolves "." and ".." in the path} -body {
    set f ::tclutils::tufetch::_redirectUrl
    list [$f https://example/cal/x ../J\u00f6rg.ics] [$f https://h/a/b ./c/../d?q=../x] \
         [$f https://h/ ../../z] [$f https://h/a/ /x/../y/] [$f https://h/a //o/p/./q]
} -result [list https://example/J\u00f6rg.ics https://h/a/d?q=../x https://h/z https://h/y/ https://o/p/q]

test tufetch-5.2 {_redirectUrl refuses https to http and other schemes (0.5)} -body {
    set r {}
    foreach {from loc} {https://h/a http://h/b https://h/a file:///etc/passwd http://h/a ftp://o/x} {
        catch {::tclutils::tufetch::_redirectUrl $from $loc} m o
        lappend r [dict get $o -errorcode]
    }
    set r
} -result {{TCLUTILS TUFETCH REDIRECT} {TCLUTILS TUFETCH REDIRECT} {TCLUTILS TUFETCH REDIRECT}}

test tufetch-5.3 {curl gets --proto-redir after the scheme of the URL (0.5)} -body {
    set o [dict create -timeout 1000 -redirects 5 -method GET -headers {} -data {} -type {} -insecure 0 -cafile {}]
    set a [::tclutils::tufetch::_curlArgs https://h/x out $o]
    set b [::tclutils::tufetch::_curlArgs http://h/x out $o]
    list [lindex $a [expr {[lsearch $a --proto-redir] + 1}]] \
         [lindex $b [expr {[lsearch $b --proto-redir] + 1}]]
} -result {=https =http,https}

# A local server: /a answers 302 with the relative Location "b", /b the body.
proc fetchSrvAccept {ch addr port} {
    fconfigure $ch -translation crlf -blocking 0
    set ::fetchReq($ch) ""
    fileevent $ch readable [list fetchSrvRead $ch]
}
proc fetchSrvRead {ch} {
    while {[gets $ch line] >= 0} {
        if {$::fetchReq($ch) eq ""} { set ::fetchReq($ch) $line; continue }
        if {$line ne ""} continue
        set req $::fetchReq($ch)
        fconfigure $ch -translation binary -blocking 1
        if {[string match "GET /dir/a *" $req]} {
            puts -nonewline $ch "HTTP/1.0 302 Found\r\nLocation: b\r\nContent-Length: 0\r\n\r\n"
        } elseif {[string match "GET /dir/b *" $req]} {
            puts -nonewline $ch "HTTP/1.0 200 OK\r\nContent-Length: 4\r\n\r\nJ\xc3\xb6r"
        } else {
            puts -nonewline $ch "HTTP/1.0 404 Not Found\r\nContent-Length: 0\r\n\r\n"
        }
        close $ch
        return
    }
    if {[eof $ch]} { close $ch }
}

test tufetch-5.4 {native path follows a relative Location (0.5)} -setup {
    set srv [socket -server fetchSrvAccept -myaddr 127.0.0.1 0]
    set port [lindex [fconfigure $srv -sockname] 2]
    set out [file join [temporaryDirectory] tufetch-4.4.bin]
} -body {
    set how [::tclutils::tufetch::download http://127.0.0.1:$port/dir/a $out]
    set ch [open $out rb]; set d [read $ch]; close $ch
    list $how [encoding convertfrom utf-8 $d]
} -cleanup {
    close $srv
    file delete -force $out
} -result [list native "J\u00f6r"]

cleanupTests
