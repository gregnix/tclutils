# tufetch.test -- tests for tclutils::tufetch.
#
# tufetch needs either the tls package or a curl/wget binary to actually move
# bytes, so the network round-trips are gated behind the `net` constraint
# (enable with env TUFETCH_NET=1). The option-handling and temp-dir logic, and
# the "no transport available" path, are checked without any network.
#
# Constraints:
#   notls  - the tls package is NOT installed (then the NOMETHOD path is reachable)
#   net    - real network access is wanted (env TUFETCH_NET set to a true value)

package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tufetch 0.2

proc opts {args} {
    ::tclutils::common::parseOptions $::tclutils::tufetch::defaults {*}$args
}

testConstraint notls [catch {package require tls}]
testConstraint net   [expr {[info exists ::env(TUFETCH_NET)] && $::env(TUFETCH_NET)}]

set ::RAW https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.teams.json

# ---------------------------------------------------------------------------
# no network needed
# ---------------------------------------------------------------------------
test tufetch-1.1 {an unknown option is rejected before any I/O} -body {
    catch {::tclutils::tufetch::download https://example.org/x /tmp/none -bogus 1} e o
    lrange [dict get $o -errorcode] 0 2
} -result {TCLUTILS COMMON OPTION}

test tufetch-1.2 {_tmpdir returns an existing directory} -body {
    file isdirectory [::tclutils::tufetch::_tmpdir]
} -result 1

test tufetch-1.3 {_tmpdir honours TMPDIR} -setup {
    set ::keepEnv [array get ::env]
    foreach v {TMPDIR TEMP TMP} { unset -nocomplain ::env($v) }
    set ::env(TMPDIR) [temporaryDirectory]
} -body {
    ::tclutils::tufetch::_tmpdir
} -cleanup {
    foreach v {TMPDIR TEMP TMP} { unset -nocomplain ::env($v) }
    array set ::env $::keepEnv
} -result [temporaryDirectory]

test tufetch-1.4 {with no tls and no curl/wget, download reports NOMETHOD} -constraints notls -setup {
    rename ::auto_execok ::tufetch_saved_auto_execok
    proc ::auto_execok {name} { return "" }
} -body {
    catch {::tclutils::tufetch::download https://example.org/x \
        [file join [temporaryDirectory] tufetch-none.tmp] -timeout 1000} e o
    dict get $o -errorcode
} -cleanup {
    rename ::auto_execok {}
    rename ::tufetch_saved_auto_execok ::auto_execok
} -result {TCLUTILS TUFETCH NOMETHOD}

# --- request construction (pure helpers, no network) ---
test tufetch-1.5 {curl GET arg list} -body {
    set a [::tclutils::tufetch::_curlArgs http://x /tmp/o [opts]]
    list [string match {*-X GET*} $a] [string match {*-- http://x*} $a]
} -result {1 1}

test tufetch-1.6 {curl POST builds method, headers, content-type and body} -body {
    set a [::tclutils::tufetch::_curlArgs https://ep /tmp/o \
        [opts -method post -headers {Accept A} -data BODY -type CT]]
    list [string match {*-X POST*} $a] \
         [string match "*-H {Accept: A}*" $a] \
         [string match "*-H {Content-Type: CT}*" $a] \
         [string match {*--data-binary BODY*} $a]
} -result {1 1 1 1}

test tufetch-1.7 {native (http::geturl) options for POST} -body {
    set a [::tclutils::tufetch::_nativeOpts \
        [opts -method post -headers {Accept A} -data BODY -type CT] 9000]
    list [string match {*-method POST*} $a] [string match {*-query BODY*} $a] \
         [string match {*-type CT*} $a] [string match {*-headers {Accept A}*} $a]
} -result {1 1 1 1}

test tufetch-1.8 {wget arg list for POST} -body {
    set a [::tclutils::tufetch::_wgetArgs https://ep /tmp/o \
        [opts -method post -headers {Accept A} -data BODY -type CT]]
    list [string match {*--method=POST*} $a] [string match {*--header=Accept: A*} $a] \
         [string match {*--body-data=BODY*} $a]
} -result {1 1 1}

# ---------------------------------------------------------------------------
# real network (only with TUFETCH_NET=1)
# ---------------------------------------------------------------------------
test tufetch-2.1 {download saves a non-empty file and names its method} -constraints net -setup {
    set ::out [file join [temporaryDirectory] tufetch-dl.json]
    file delete -force $::out
} -body {
    set method [::tclutils::tufetch::download $::RAW $::out]
    list [expr {$method in {native curl wget}}] [expr {[file size $::out] > 0}]
} -cleanup {
    file delete -force $::out
} -result {1 1}

test tufetch-2.2 {get returns decoded text with the expected content} -constraints net -body {
    set txt [::tclutils::tufetch::get $::RAW]
    list [string match {*Mexico*} $txt] [string match {*fifa_code*} $txt]
} -result {1 1}

test tufetch-2.3 {the curl path reports an HTTP status as a clean errorcode} -constraints net -body {
    catch {::tclutils::tufetch::download \
        https://raw.githubusercontent.com/openfootball/worldcup.json/master/NO_SUCH_FILE_xyz \
        [file join [temporaryDirectory] tufetch-404.tmp] -timeout 15000} e o
    lrange [dict get $o -errorcode] 0 3
} -result {TCLUTILS TUFETCH HTTP 404}

cleanupTests
