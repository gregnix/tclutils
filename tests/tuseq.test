package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuseq 0.2

test tuseq-1.1 {one arg} { ::tclutils::tuseq::range 5 } {1 2 3 4 5}
test tuseq-1.2 {first last} { ::tclutils::tuseq::range 3 7 } {3 4 5 6 7}
test tuseq-1.3 {first incr last} { ::tclutils::tuseq::range 0 2 10 } {0 2 4 6 8 10}
test tuseq-1.4 {descending} { ::tclutils::tuseq::range 5 -1 1 } {5 4 3 2 1}
test tuseq-1.5 {empty when direction mismatch} { ::tclutils::tuseq::range 5 1 1 } {}
test tuseq-1.6 {empty range} { ::tclutils::tuseq::range 5 1 3 } {}
test tuseq-1.7 {float step} { ::tclutils::tuseq::range 1 0.5 2 } {1 1.5 2}
test tuseq-1.8 {equalwidth} { ::tclutils::tuseq::range 8 11 -equalwidth 1 } {08 09 10 11}
test tuseq-1.9 {format} { ::tclutils::tuseq::range 1 3 -format %03d } {001 002 003}
test tuseq-1.10 {text join} { ::tclutils::tuseq::text 1 3 -separator , } {1,2,3}
test tuseq-1.11 {zero increment rejected} {
    catch {::tclutils::tuseq::range 1 0 5} m o; dict get $o -errorcode
} {TCLUTILS TUSEQ INCREMENT}
test tuseq-2.1 {text: -separator after one value} {
    ::tclutils::tuseq::text 3 -separator ,
} {1,2,3}
test tuseq-2.2 {text: -separator after three values} {
    ::tclutils::tuseq::text 1 2 7 -separator ,
} {1,3,5,7}
test tuseq-2.3 {text: -separator first, negative values} {
    ::tclutils::tuseq::text -separator , -2 1
} {-2,-1,0,1}
test tuseq-2.4 {text: -separator between values} {
    ::tclutils::tuseq::text 5 -separator , -1 1
} {5,4,3,2,1}
test tuseq-2.5 {text: other options pass through} {
    ::tclutils::tuseq::text 2 -separator " " -format %02d
} {01 02}
test tuseq-2.6 {range rejects -separator} {
    catch {::tclutils::tuseq::range 3 -separator ,} m o
    dict get $o -errorcode
} {TCLUTILS COMMON OPTION -separator}
test tuseq-2.7 {64-bit integers stay integers (also Tcl 8.6)} {
    ::tclutils::tuseq::range 5000000000 5000000002
} {5000000000 5000000001 5000000002}
test tuseq-2.8 {bignum integers} {
    ::tclutils::tuseq::range 99999999999999999999 2 100000000000000000003
} {99999999999999999999 100000000000000000001 100000000000000000003}
test tuseq-2.9 {option without value} {
    catch {::tclutils::tuseq::text 3 -separator} m o
    dict get $o -errorcode
} {TCLUTILS TUSEQ OPTION}

cleanupTests
