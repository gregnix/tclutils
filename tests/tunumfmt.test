package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tunumfmt 0.1

test tunumfmt-1.1 {si below scale stays integer} { ::tclutils::tunumfmt::toHuman 999 } 999
test tunumfmt-1.2 {si kilo} { ::tclutils::tunumfmt::toHuman 1500 } 1.5K
test tunumfmt-1.3 {si mega} { ::tclutils::tunumfmt::toHuman 1048576 } 1.0M
test tunumfmt-1.4 {iec kibi} { ::tclutils::tunumfmt::toHuman 1536 -to iec } 1.5Ki
test tunumfmt-1.5 {iec below 1024 stays integer} { ::tclutils::tunumfmt::toHuman 1023 -to iec } 1023
test tunumfmt-1.6 {negative} { ::tclutils::tunumfmt::toHuman -2500 } -2.5K
test tunumfmt-1.7 {precision} { ::tclutils::tunumfmt::toHuman 2500 -precision 2 } 2.50K
test tunumfmt-1.8 {zero} { ::tclutils::tunumfmt::toHuman 0 } 0
test tunumfmt-1.9 {from si} { ::tclutils::tunumfmt::fromHuman 1.5K } 1500
test tunumfmt-1.10 {from iec auto} { ::tclutils::tunumfmt::fromHuman 1.5Ki } 1536
test tunumfmt-1.11 {from plain} { ::tclutils::tunumfmt::fromHuman 999 } 999
test tunumfmt-1.12 {from negative giga} { ::tclutils::tunumfmt::fromHuman -3G } -3000000000
test tunumfmt-1.13 {roundtrip} {
    ::tclutils::tunumfmt::fromHuman [::tclutils::tunumfmt::toHuman 5000]
} 5000
test tunumfmt-1.14 {text mode to, per line} {
    ::tclutils::tunumfmt::text "1500\n2000000"
} "1.5K\n2.0M"
test tunumfmt-1.15 {bad number rejected} {
    catch {::tclutils::tunumfmt::toHuman foo} m o; dict get $o -errorcode
} {TCLUTILS TUNUMFMT VALUE}
test tunumfmt-1.16 {unknown suffix rejected} {
    catch {::tclutils::tunumfmt::fromHuman 5Q} m o; dict get $o -errorcode
} {TCLUTILS TUNUMFMT SUFFIX}
test tunumfmt-1.17 {bad precision rejected} {
    catch {::tclutils::tunumfmt::toHuman 5 -precision -1} m o; dict get $o -errorcode
} {TCLUTILS TUNUMFMT PRECISION}
cleanupTests
