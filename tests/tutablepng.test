package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
package require tclutils::tutablepng
package require tclutils::tuimage

set rows {
    {Name Qty Price}
    {Apples 12 3.40}
    {Pears 4 2.10}
}

test tutablepng-1.1 {render -> valid PNG} -body {
    ::tclutils::tuimage::type [::tclutils::tutablepng::render $rows]
} -result png

test tutablepng-1.2 {dimensions for scale 1} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -align {l r r}]
} -result {134 60}

test tutablepng-1.3 {scale 2 doubles cell metrics} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -scale 2]
} -result {232 84}

test tutablepng-1.4 {header flag does not change layout size} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -header 0]
} -result {134 60}

test tutablepng-2.1 {no rows -> EMPTY} -body {
    catch {::tclutils::tutablepng::render {}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG EMPTY}

test tutablepng-2.2 {bad align -> ALIGN} -body {
    catch {::tclutils::tutablepng::render $rows -align x} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG ALIGN}

test tutablepng-2.3 {ragged rows are padded, not an error} -body {
    set r {{a b c} {x}}
    ::tclutils::tuimage::type [::tclutils::tutablepng::render $r]
} -result png

test tutablepng-3.1 {write creates a PNG file} -setup {
    set f [file join [temporaryDirectory] tutablepng-test.png]
} -body {
    ::tclutils::tutablepng::write $f $rows
    set bytes [::tclutils::common::readBinaryFile $f]
    list [file exists $f] [::tclutils::tuimage::type $bytes]
} -cleanup {
    file delete $f
} -result {1 png}

test tutablepng-4.1 {number-like cells keep their text (width check)} -body {
    set a [::tclutils::tutablepng::render {{4.80 1e3 0x1F 010 " 5"}} -header 0]
    set b [::tclutils::tutablepng::render {{abcd abc abcd abc xx}} -header 0]
    expr {[::tclutils::tuimage::dimensions $a] eq [::tclutils::tuimage::dimensions $b]}
} -result 1

test tutablepng-4.2 {number-like cell renders like its literal text} -body {
    # 4.80 must not be drawn as 4.8 (a 3-char cell gives other pixels)
    set a [::tclutils::tutablepng::render {{4.80}} -header 0]
    set b [::tclutils::tutablepng::render {{4.8}} -header 0]
    expr {$a ne $b}
} -result 1

test tutablepng-4.3 {-padding negative -> PADDING} -body {
    catch {::tclutils::tutablepng::render $rows -padding -1} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG PADDING}

test tutablepng-4.4 {-spacing not an integer -> SPACING} -body {
    catch {::tclutils::tutablepng::render $rows -spacing x} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG SPACING}

test tutablepng-4.5 {-padding 0 and -spacing 0 are allowed} -body {
    ::tclutils::tuimage::dimensions \
        [::tclutils::tutablepng::render {{ab}} -padding 0 -spacing 0]
} -result {12 8}

test tutablepng-4.6 {-padding with leading zero is decimal} -body {
    ::tclutils::tuimage::dimensions \
        [::tclutils::tutablepng::render {{ab}} -padding 010 -spacing 0]
} -result {32 28}


test tutablepng-5.1 {a failed write leaves the old file} -setup {
    set f [makeFile PRECIOUS tutablepng-5.1.png]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {
        ::tclutils::tutablepng::write $f {{a}}
    }]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile tutablepng-5.1.png
} -result {1 PRECIOUS 0 0}

cleanupTests
