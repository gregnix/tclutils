package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
package require tclutils::tutablepng
package require tclutils::tuimage

set rows {
    {Name Qty Price}
    {Apples 12 3.40}
    {Pears 4 2.10}
}

test tutablepng-1.1 {render -> valid PNG} -body {
    ::tclutils::tuimage::type [::tclutils::tutablepng::render $rows]
} -result png

test tutablepng-1.2 {dimensions for scale 1} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -align {l r r}]
} -result {134 60}

test tutablepng-1.3 {scale 2 doubles cell metrics} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -scale 2]
} -result {232 84}

test tutablepng-1.4 {header flag does not change layout size} -body {
    ::tclutils::tuimage::dimensions [::tclutils::tutablepng::render $rows -header 0]
} -result {134 60}

test tutablepng-2.1 {no rows -> EMPTY} -body {
    catch {::tclutils::tutablepng::render {}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG EMPTY}

test tutablepng-2.2 {bad align -> ALIGN} -body {
    catch {::tclutils::tutablepng::render $rows -align x} e o
    dict get $o -errorcode
} -result {TCLUTILS TUTABLEPNG ALIGN}

test tutablepng-2.3 {ragged rows are padded, not an error} -body {
    set r {{a b c} {x}}
    ::tclutils::tuimage::type [::tclutils::tutablepng::render $r]
} -result png

test tutablepng-3.1 {write creates a PNG file} -setup {
    set f [file join [temporaryDirectory] tutablepng-test.png]
} -body {
    ::tclutils::tutablepng::write $f $rows
    set bytes [::tclutils::common::readBinaryFile $f]
    list [file exists $f] [::tclutils::tuimage::type $bytes]
} -cleanup {
    file delete $f
} -result {1 png}

cleanupTests
