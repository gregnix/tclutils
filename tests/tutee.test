package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tutee 0.3
package require tclutils::common 0.1

set tmp [makeDirectory tutee]

test tutee-1.1 {write to two files} -body {
    set a [file join $tmp a.txt]
    set b [file join $tmp b.txt]
    ::tclutils::tutee::write "hello" [list $a $b]
    list [string trim [::tclutils::common::readFile $a]] [string trim [::tclutils::common::readFile $b]]
} -result {hello hello}

test tutee-1.2 {append mode} -body {
    set a [file join $tmp append.txt]
    ::tclutils::tutee::write "one" [list $a]
    ::tclutils::tutee::write "two" [list $a] -append 1
    string trim [::tclutils::common::readFile $a]
} -result "one\ntwo"

test tutee-1.3 {writeFile copies input to outputs without extra newline} -body {
    set in [file join $tmp in.txt]
    set out [file join $tmp out.txt]
    ::tclutils::common::writeFile $in "abc\nxyz"
    ::tclutils::tutee::writeFile $in [list $out]
    ::tclutils::common::readFile $out
} -result "abc\nxyz"

test tutee-1.4 {copyChannel returns byte count} -body {
    set in [file join $tmp chan-in.txt]
    set out [file join $tmp chan-out.txt]
    ::tclutils::common::writeFile $in "abcdef"
    set fi [open $in r]
    set fo [open $out w]
    try {
        set n [::tclutils::tutee::copyChannel $fi [list $fo] -chunksize 2]
    } finally {
        close $fi
        close $fo
    }
    list $n [::tclutils::common::readFile $out]
} -result {6 abcdef}

test tutee-2.1 {failed open closes the channels opened before} -body {
    set a [file join $tmp keep.txt]
    set bad [file join $tmp missing-dir x.txt]
    set before [llength [file channels]]
    catch {::tclutils::tutee::write new [list $a $bad]}
    expr {[llength [file channels]] - $before}
} -result 0

test tutee-2.2 {failed open leaves earlier existing targets untouched} -body {
    set a [file join $tmp keep2.txt]
    ::tclutils::common::writeFile $a "old content"
    set bad [file join $tmp missing-dir x.txt]
    set code [catch {::tclutils::tutee::write new [list $a $bad]}]
    list $code [::tclutils::common::readFile $a]
} -result {1 {old content}}

test tutee-2.3 {failed open removes targets created by this call} -body {
    set a [file join $tmp fresh.txt]
    file delete -force $a
    set bad [file join $tmp missing-dir x.txt]
    catch {::tclutils::tutee::write new [list $a $bad]}
    file exists $a
} -result 0

test tutee-2.4 {failed open reports the open error} -body {
    set bad [file join $tmp missing-dir x.txt]
    catch {::tclutils::tutee::write new [list $bad]} err opts
    lrange [dict get $opts -errorcode] 0 1
} -result {POSIX ENOENT}

test tutee-2.5 {overwrite still empties a longer existing file} -body {
    set a [file join $tmp shorter.txt]
    ::tclutils::common::writeFile $a "a much longer old content"
    ::tclutils::tutee::write new [list $a]
    ::tclutils::common::readFile $a
} -result "new\n"

# --- 0.3: writeFile copies bytes ---------------------------------------------

test tutee-3.1 {writeFile keeps CRLF and the bytes, returns the byte count} -body {
    set d [makeDirectory tee31]
    set in [file join $d in]; set out [file join $d out]
    set data "J\xC3\xB6rg\r\nZeile\r\n\xFF"
    set fh [open $in wb]; puts -nonewline $fh $data; close $fh
    set n [::tclutils::tutee::writeFile $in [list $out]]
    set fh [open $out rb]; set got [read $fh]; close $fh
    list $n [expr {$got eq $data}]
} -result {15 1}

test tutee-3.2 {writeFile -append adds the bytes} -body {
    set d [makeDirectory tee32]
    set in [file join $d in]; set out [file join $d out]
    set fh [open $in wb]; puts -nonewline $fh "x\r\n"; close $fh
    ::tclutils::tutee::writeFile $in [list $out]
    ::tclutils::tutee::writeFile $in [list $out] -append 1
    set fh [open $out rb]; set got [read $fh]; close $fh
    set got
} -result "x\r\nx\r\n"

cleanupTests
