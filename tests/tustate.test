package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tustate

namespace eval M { namespace import ::tclutils::tustate::* }

proc nnodes {m} { llength [dict get $m nodes] }
proc nedges {m} { llength [dict get $m edges] }
proc ids {m} { lmap n [dict get $m nodes] { dict get $n id } }
proc nodeById {m id} {
    foreach n [dict get $m nodes] { if {[dict get $n id] eq $id} { return $n } }
    return {}
}
proc epairs {m} { lmap e [dict get $m edges] { list [dict get $e from] [dict get $e to] } }

# --- states & transitions ----------------------------------------------------

test tustate-1.1 {one transition: 2 nodes, 1 edge} -body {
    set m [M::parse "stateDiagram-v2\n  A --> B"]
    list [nnodes $m] [nedges $m]
} -result {2 1}

test tustate-1.2 {states are rounded boxes} -body {
    dict get [nodeById [M::parse "stateDiagram-v2\n  A --> B"] A] shape
} -result rounded

test tustate-1.3 {transition endpoints and direction} -body {
    epairs [M::parse "stateDiagram-v2\n  A --> B"]
} -result {{A B}}

test tustate-1.4 {transition draws an arrowhead} -body {
    set m [M::parse "stateDiagram-v2\n  A --> B"]
    dict get [lindex [dict get $m edges] 0] arrow
} -result end

test tustate-1.5 {transition label after the colon} -body {
    set m [M::parse "stateDiagram-v2\n  A --> B : go"]
    dict get [lindex [dict get $m edges] 0] label
} -result go

test tustate-1.6 {bare state name on its own line becomes a node} -body {
    ids [M::parse "stateDiagram-v2\n  Idle"]
} -result Idle

# --- pseudostates [*] ---------------------------------------------------------

test tustate-2.1 {[*] on the from side -> __start dot} -body {
    set m [M::parse "stateDiagram-v2\n  \[*\] --> S"]
    list [dict get [nodeById $m __start] shape] [epairs $m]
} -result {dot {{__start S}}}

test tustate-2.2 {[*] on the to side -> __end dot} -body {
    set m [M::parse "stateDiagram-v2\n  S --> \[*\]"]
    list [dict get [nodeById $m __end] shape] [epairs $m]
} -result {dot {{S __end}}}

# --- state label, fork/join --------------------------------------------------

test tustate-3.1 {state description sets the display label} -body {
    dict get [nodeById [M::parse "stateDiagram-v2\n  S : Working hard"] S] label
} -result {Working hard}

test tustate-3.2 {fork declaration becomes a named box} -body {
    dict get [nodeById [M::parse "stateDiagram-v2\n  state Fork1 <<fork>>"] Fork1] shape
} -result rounded

test tustate-3.3 {join declaration becomes a named box} -body {
    nnodes [M::parse "stateDiagram-v2\n  state J1 <<join>>"]
} -result 1

# --- direction mapping -------------------------------------------------------

test tustate-4.1 {direction RL maps to LR} -body {
    dict get [M::parse "stateDiagram-v2\n  direction RL\n  A --> B"] meta direction
} -result LR

test tustate-4.2 {direction TD maps to TB} -body {
    dict get [M::parse "stateDiagram-v2\n  direction TD\n  A --> B"] meta direction
} -result TB

test tustate-4.3 {direction BT maps to TB} -body {
    dict get [M::parse "stateDiagram-v2\n  direction BT\n  A --> B"] meta direction
} -result TB

test tustate-4.4 {direction LR is kept} -body {
    dict get [M::parse "stateDiagram-v2\n  direction LR\n  A --> B"] meta direction
} -result LR

# --- noise: composite, comments, notes ---------------------------------------

test tustate-5.1 {composite state is flattened: inner kept, boundary dropped} -body {
    set m [M::parse "stateDiagram-v2\n  state Outer {\n    A --> B\n  }"]
    list [ids $m] [expr {[nodeById $m Outer] eq {} ? "no-outer" : "outer"}]
} -result {{A B} no-outer}

test tustate-5.2 {comments and blank lines are ignored} -body {
    nnodes [M::parse "stateDiagram-v2\n  %% a comment\n\n  A --> B"]
} -result 2

test tustate-5.3 {block notes and inline notes are ignored} -body {
    set src "stateDiagram-v2\n  A --> B\n  note right of A\n    hidden\n  end note\n  note left of B : inline"
    list [ids [M::parse $src]] [nedges [M::parse $src]]
} -result {{A B} 1}

# --- errors ------------------------------------------------------------------

test tustate-6.1 {empty diagram raises TUSTATE EMPTY} -body {
    catch {M::parse "stateDiagram-v2"} e o
    list [lindex [dict get $o -errorcode] 1] [lindex [dict get $o -errorcode] 2]
} -result {TUSTATE EMPTY}

cleanupTests
