package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tustat 0.1

set tmp [makeDirectory tustat]
set f [makeFile "abc" [file join $tmp file.txt]]

test tustat-1.1 {file returns dict metadata} -body {
    set d [::tclutils::tustat::file $f]
    list [dict get $d size] [dict get $d type] [file tail [dict get $d path]]
} -result {4 file file.txt}

test tustat-1.2 {files returns list of dicts} -body {
    llength [::tclutils::tustat::files [list $f]]
} -result 1

test tustat-1.3 {format contains size} -body {
    string match {*size*4*} [::tclutils::tustat::render [::tclutils::tustat::file $f]]
} -result 1

cleanupTests
