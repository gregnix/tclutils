package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file join [file dirname $here] lib tm]
package require tclutils::tuvcard 0.1
package require tclutils::tupng 0.1

set vcf "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Alice Smith\r\nN:Smith;Alice;;;\r\nEMAIL;TYPE=work:alice@ex.com\r\nEMAIL;TYPE=home:a@home.com\r\nTEL;TYPE=cell:123\r\nEND:VCARD\r\nBEGIN:VCARD\r\nFN:Bob\r\nEND:VCARD\r\n"

test tuvcard-1.1 {parse card count} -body {
    llength [::tclutils::tuvcard::parse $vcf]
} -result 2

test tuvcard-1.2 {fullName} -body {
    ::tclutils::tuvcard::fullName [lindex [::tclutils::tuvcard::parse $vcf] 0]
} -result {Alice Smith}

test tuvcard-1.3 {multi-valued EMAIL} -body {
    ::tclutils::tuvcard::get [lindex [::tclutils::tuvcard::parse $vcf] 0] EMAIL
} -result {alice@ex.com a@home.com}

test tuvcard-1.4 {property params} -body {
    set card [lindex [::tclutils::tuvcard::parse $vcf] 0]
    dict get [lindex [::tclutils::tuvcard::properties $card EMAIL] 0] params
} -result {TYPE work}

test tuvcard-1.5 {names of second card} -body {
    ::tclutils::tuvcard::names [lindex [::tclutils::tuvcard::parse $vcf] 1]
} -result FN

test tuvcard-1.6 {round-trip parse -> toVcf -> parse} -body {
    set a [::tclutils::tuvcard::parse $vcf]
    set b [::tclutils::tuvcard::parse [::tclutils::tuvcard::toVcf $a]]
    expr {$a eq $b}
} -result 1

test tuvcard-1.7 {long value folds and survives round-trip} -body {
    set long [string repeat x 120]
    set card [list [dict create name FN value $long params {}]]
    set out [::tclutils::tuvcard::toVcf $card]
    set back [::tclutils::tuvcard::property \
        [lindex [::tclutils::tuvcard::parse $out] 0] FN]
    list [string match "*\r\n *" $out] [expr {$back eq $long}]
} -result {1 1}

test tuvcard-2.1 {addProperty / removeProperty / setProperty} -body {
    set card [list [dict create name FN value Alice params {}]]
    set card [::tclutils::tuvcard::addProperty $card EMAIL a@x.com {TYPE work}]
    set v1 [::tclutils::tuvcard::property $card EMAIL]
    set card [::tclutils::tuvcard::setProperty $card 1 EMAIL b@x.com {TYPE home}]
    set v2 [::tclutils::tuvcard::property $card EMAIL]
    set card [::tclutils::tuvcard::removeProperty $card 1]
    list $v1 $v2 [::tclutils::tuvcard::names $card]
} -result {a@x.com b@x.com FN}

# --- PHOTO convenience ---
test tuvcard-photo-1.1 {parse 3.0 inline base64 PHOTO} -body {
    set bytes [binary format c* {1 2 3 255 0 137 80 78}]
    set vcf "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Jane\r\nPHOTO;ENCODING=b;TYPE=JPEG:[::tclutils::tubase64::encode $bytes]\r\nEND:VCARD\r\n"
    set card [lindex [::tclutils::tuvcard::parse $vcf] 0]
    set ph [::tclutils::tuvcard::photo $card]
    list [dict get $ph kind] [dict get $ph mime] [expr {[dict get $ph bytes] eq $bytes}]
} -result {inline image/jpeg 1}

test tuvcard-photo-1.2 {parse 4.0 data: URI PHOTO} -body {
    set bytes [binary format c* {9 9 9}]
    set vcf "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Jane\r\nPHOTO:data:image/png;base64,[::tclutils::tubase64::encode $bytes]\r\nEND:VCARD\r\n"
    set card [lindex [::tclutils::tuvcard::parse $vcf] 0]
    set ph [::tclutils::tuvcard::photo $card]
    list [dict get $ph kind] [dict get $ph mime] [expr {[dict get $ph bytes] eq $bytes}]
} -result {inline image/png 1}

test tuvcard-photo-1.3 {parse URI PHOTO} -body {
    set vcf "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Jane\r\nPHOTO:https://example.com/me.jpg\r\nEND:VCARD\r\n"
    set card [lindex [::tclutils::tuvcard::parse $vcf] 0]
    set ph [::tclutils::tuvcard::photo $card]
    list [dict get $ph kind] [dict get $ph uri]
} -result {uri https://example.com/me.jpg}

test tuvcard-photo-1.4 {no PHOTO -> kind none} -body {
    set card [lindex [::tclutils::tuvcard::parse "BEGIN:VCARD\r\nFN:Jane\r\nEND:VCARD\r\n"] 0]
    dict get [::tclutils::tuvcard::photo $card] kind
} -result none

test tuvcard-photo-2.1 {setPhoto v4 round-trips through toVcf/parse} -body {
    set bytes [binary format c* {10 20 30 40 50}]
    set card [::tclutils::tuvcard::addProperty {} FN Jane]
    set card [::tclutils::tuvcard::setPhoto $card image/png $bytes]
    set back [lindex [::tclutils::tuvcard::parse [::tclutils::tuvcard::toVcf $card]] 0]
    set ph [::tclutils::tuvcard::photo $back]
    list [dict get $ph kind] [dict get $ph mime] [expr {[dict get $ph bytes] eq $bytes}]
} -result {inline image/png 1}

test tuvcard-photo-2.2 {setPhoto v3 round-trips} -body {
    set bytes [binary format c* {7 7 7 7}]
    set card [::tclutils::tuvcard::addProperty {} FN Jane]
    set card [::tclutils::tuvcard::setPhoto $card image/jpeg $bytes -version 3]
    set back [lindex [::tclutils::tuvcard::parse [::tclutils::tuvcard::toVcf $card]] 0]
    set ph [::tclutils::tuvcard::photo $back]
    list [dict get $ph kind] [dict get $ph mime] [expr {[dict get $ph bytes] eq $bytes}]
} -result {inline image/jpeg 1}

test tuvcard-photo-2.3 {setPhoto replaces existing PHOTO (only one remains)} -body {
    set card [::tclutils::tuvcard::addProperty {} FN Jane]
    set card [::tclutils::tuvcard::setPhoto $card image/png [binary format c* {1}]]
    set card [::tclutils::tuvcard::setPhoto $card image/gif [binary format c* {2}]]
    llength [::tclutils::tuvcard::properties $card PHOTO]
} -result 1

test tuvcard-photo-2.4 {setPhotoUri v4} -body {
    set card [::tclutils::tuvcard::setPhotoUri {} https://x/me.png]
    set ph [::tclutils::tuvcard::photo $card]
    list [dict get $ph kind] [dict get $ph uri]
} -result {uri https://x/me.png}

test tuvcard-photo-3.1 {inline 3.0 photo without TYPE is MIME-sniffed via tuimage} -body {
    set png [::tclutils::tupng::encodeRGB {{FF0000 00FF00} {0000FF FFFFFF}}]
    set vcf "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Jane\r\nPHOTO;ENCODING=b:[::tclutils::tubase64::encode $png]\r\nEND:VCARD\r\n"
    set ph [::tclutils::tuvcard::photo [lindex [::tclutils::tuvcard::parse $vcf] 0]]
    list [dict get $ph kind] [dict get $ph mime] [expr {[dict get $ph bytes] eq $png}]
} -result {inline image/png 1}

cleanupTests
