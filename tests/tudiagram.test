package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tudiagram

testConstraint tupngdraw [expr {![catch {package require tclutils::tupngdraw}]}]
testConstraint tdom      [expr {![catch {package require tdom}]}]

namespace eval D { namespace import ::tclutils::tudiagram::* }

# --- model + validation ----------------------------------------------------

test tudiagram-1.1 {create yields a versioned model} -body {
    set d [D::create -title T -direction LR]
    list [dict get $d version] [dict get $d meta direction] [llength [dict get $d nodes]]
} -result {1 LR 0}

test tudiagram-1.2 {duplicate node id is rejected} -body {
    set d [D::create]
    set d [D::addNode $d a]
    D::addNode $d a
} -returnCodes error -match glob -result {*duplicate node id*}

test tudiagram-1.3 {bad direction is rejected} -body {
    D::create -direction sideways
} -returnCodes error -match glob -result {*LR, TB, RL or BT*}

test tudiagram-1.4 {validate flags an edge to an unknown node} -body {
    set d [D::create]
    set d [D::addNode $d a]
    set d [D::addEdge $d a ghost]
    lindex [lindex [D::validate $d] 0] 0
} -result NONODE

test tudiagram-1.5 {label defaults to the id} -body {
    set d [D::addNode [D::create] x]
    dict get [lindex [dict get $d nodes] 0] label
} -result x

# --- layered layout --------------------------------------------------------

test tudiagram-2.1 {layout assigns geometry to every node} -body {
    set d [D::create]
    foreach id {a b c} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d b c]
    set d [D::layout $d]
    set ok 1
    foreach n [dict get $d nodes] {
        foreach k {x y width height} { if {![dict exists $n $k]} { set ok 0 } }
    }
    set ok
} -result 1

test tudiagram-2.2 {longest-path ranks place a chain left to right (LR x increases)} -body {
    set d [D::create -direction LR]
    foreach id {a b c} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d b c]
    set d [D::layout $d]
    array set X {}
    foreach n [dict get $d nodes] { set X([dict get $n id]) [dict get $n x] }
    expr {$X(a) < $X(b) && $X(b) < $X(c)}
} -result 1

test tudiagram-2.3 {parallel successors share a rank and stack (same x, different y)} -body {
    set d [D::create -direction LR]
    foreach id {a b c} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d a c]
    set d [D::layout $d]
    array set P {}
    foreach n [dict get $d nodes] { set P([dict get $n id]) [list [dict get $n x] [dict get $n y]] }
    expr {[lindex $P(b) 0] == [lindex $P(c) 0] && [lindex $P(b) 1] != [lindex $P(c) 1]}
} -result 1

test tudiagram-2.4 {wider label yields a wider box} -body {
    set d [D::create]
    set d [D::addNode $d a -label "X"]
    set d [D::addNode $d b -label "a much longer label"]
    set d [D::layout $d]
    array set W {}
    foreach n [dict get $d nodes] { set W([dict get $n id]) [dict get $n width] }
    expr {$W(b) > $W(a)}
} -result 1

test tudiagram-2.5 {a cycle is broken best-effort: one edge flagged back, no crash} -body {
    set d [D::create]
    foreach id {a b} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d b a]
    set d [D::layout $d]
    set backs 0
    foreach e [dict get $d edges] { incr backs [dict get $e back] }
    set backs
} -result 1

test tudiagram-2.6 {empty diagram cannot be laid out} -body {
    D::layout [D::create]
} -returnCodes error -match glob -result {*empty*}

test tudiagram-2.7 {long edges route through dummy waypoints; adjacent edges stay straight} -body {
    set d [D::create]
    foreach id {a b c e} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d b c]
    set d [D::addEdge $d c e]
    set d [D::addEdge $d a e]   ;# spans 3 ranks -> two dummy waypoints
    set d [D::layout $d]
    array set NP {}
    foreach edge [dict get $d edges] {
        set NP([dict get $edge from][dict get $edge to]) \
            [expr {[llength [dict get $edge points]] / 2}]
    }
    list $NP(ab) $NP(ae)
} -result {2 4}

# --- render: backend-agnostic ----------------------------------------------

test tudiagram-3.1 {toSvg produces well-formed SVG with the expected element counts} \
        -constraints tdom -body {
    set d [D::create -theme pipeline]
    foreach id {a b} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]
    dom parse [D::toSvg $d] doc
    list [llength [$doc getElementsByTagName rect]] \
         [llength [$doc getElementsByTagName line]] \
         [llength [$doc getElementsByTagName text]]
} -result {3 1 2}   ;# bg + 2 boxes, 1 edge, 2 labels

test tudiagram-3.2 {the same model renders on both backends (svg + png non-empty)} \
        -constraints tupngdraw -body {
    set d [D::create]
    foreach id {a b c} { set d [D::addNode $d $id -shape rounded] }
    set d [D::addEdge $d a b]
    set d [D::addEdge $d a c]
    expr {[string length [D::toSvg $d]] > 0 && [string length [D::toPng $d]] > 0}
} -result 1

# --- per-node style (colour overrides) -------------------------------------

test tudiagram-4.1 {a -style fill/stroke override appears in the SVG} -body {
    set d [D::create]
    set d [D::addNode $d a -style {fill #112233 stroke #445566}]
    set svg [D::toSvg $d]
    expr {[string match {*#112233*} $svg] && [string match {*#445566*} $svg]}
} -result 1

test tudiagram-4.2 {an unstyled node uses the theme fill} -body {
    set d [D::create]
    set d [D::addNode $d a]
    string match {*#f4f4f5*} [D::toSvg $d]
} -result 1

test tudiagram-4.3 {a malformed (odd-length) -style is ignored, theme fill used} -body {
    set d [D::create]
    set d [D::addNode $d a -style fill]
    string match {*#f4f4f5*} [D::toSvg $d]
} -result 1

# --- node shapes -----------------------------------------------------------

test tudiagram-5.1 {the new shapes are accepted} -body {
    set d [D::create]
    foreach s {circle stadium diamond hexagon cylinder} {
        set d [D::addNode $d n_$s -shape $s]
    }
    llength [dict get $d nodes]
} -result 5

test tudiagram-5.2 {an unknown shape is rejected} -body {
    catch {D::addNode [D::create] x -shape star} e o
    lindex [dict get $o -errorcode] 2
} -result ARG

test tudiagram-5.3 {diamond renders as a polygon} -body {
    string match {*<polygon*} [D::toSvg [D::addNode [D::create] a -shape diamond]]
} -result 1

test tudiagram-5.4 {cylinder renders polygon lids and a body rect} -body {
    set svg [D::toSvg [D::addNode [D::create] a -shape cylinder]]
    expr {[regexp -all {<polygon} $svg] >= 2 && [string match {*<rect*} $svg]}
} -result 1

# --- directions (RL/BT mirror LR/TB) ---------------------------------------

proc chainXY {dir axis} {
    set d [D::create -direction $dir]
    foreach id {a b c} { set d [D::addNode $d $id] }
    set d [D::addEdge $d a b]; set d [D::addEdge $d b c]
    set d [D::layout $d]
    set r {}
    foreach n [dict get $d nodes] { dict set r [dict get $n id] [dict get $n $axis] }
    return $r
}

test tudiagram-6.1 {RL reverses the LR x-order of a chain} -body {
    set lr [chainXY LR x]; set rl [chainXY RL x]
    expr {[dict get $lr a] < [dict get $lr c]
          && [dict get $rl a] > [dict get $rl c]}
} -result 1

test tudiagram-6.2 {BT reverses the TB y-order of a chain} -body {
    set tb [chainXY TB y]; set bt [chainXY BT y]
    expr {[dict get $tb a] < [dict get $tb c]
          && [dict get $bt a] > [dict get $bt c]}
} -result 1

test tudiagram-6.3 {RL/BT still render to SVG and PNG} -constraints tupngdraw -body {
    set d [D::addEdge [D::addNode [D::addNode [D::create -direction RL] a] b] a b]
    expr {[string length [D::toSvg $d]] > 0 && [string length [D::toPng $d]] > 0}
} -result 1

# --- edge styles and arrows -------------------------------------------------

proc edgeSvg {style arrow} {
    set d [D::create -direction LR]
    set d [D::addNode $d a]; set d [D::addNode $d b]
    set d [D::addEdge $d a b -style $style -arrow $arrow]
    return [D::toSvg $d]
}

test tudiagram-7.1 {a dashed edge is drawn as several line pieces} -body {
    expr {[regexp -all {<line} [edgeSvg dashed end]]
          > [regexp -all {<line} [edgeSvg solid end]]}
} -result 1

test tudiagram-7.2 {arrow both draws two arrowheads} -body {
    regexp -all {<polygon} [edgeSvg solid both]
} -result 2

test tudiagram-7.3 {arrow none draws no arrowhead} -body {
    regexp -all {<polygon} [edgeSvg solid none]
} -result 0

test tudiagram-7.4 {default edge is one solid segment with one head} -body {
    set svg [edgeSvg solid end]
    list [regexp -all {<line} $svg] [regexp -all {<polygon} $svg]
} -result {1 1}

test tudiagram-7.5 {a thick edge is drawn with a wider stroke} -body {
    string match {*stroke-width="4"*} [edgeSvg thick end]
} -result 1

test tudiagram-7.6 {a non-thick edge keeps the default stroke width} -body {
    set svg [edgeSvg solid end]
    list [string match {*stroke-width="2"*} $svg] [string match {*stroke-width="4"*} $svg]
} -result {1 0}

# --- cardinality end-marks (crow's foot) -----------------------------------

proc markSvg {sm em} {
    set d [D::create -direction LR]
    set d [D::addNode $d a]; set d [D::addNode $d b]
    set d [D::addEdge $d a b -arrow none -startMark $sm -endMark $em]
    return [D::toSvg $d]
}
proc markCounts {svg} {
    list [regexp -all {<line} $svg] [regexp -all {<polygon} $svg]
}

test tudiagram-8.1 {no marks by default: just the edge segment} -body {
    markCounts [markSvg none none]
} -result {1 0}

test tudiagram-8.2 {exactlyOne draws two bars} -body {
    markCounts [markSvg none exactlyOne]
} -result {3 0}

test tudiagram-8.3 {zeroOrOne draws one bar and a ring} -body {
    markCounts [markSvg none zeroOrOne]
} -result {2 1}

test tudiagram-8.4 {oneOrMany draws a crow's foot and a bar} -body {
    markCounts [markSvg none oneOrMany]
} -result {5 0}

test tudiagram-8.5 {zeroOrMany draws a crow's foot and a ring} -body {
    markCounts [markSvg none zeroOrMany]
} -result {4 1}

test tudiagram-8.6 {marks on both ends are both drawn} -body {
    markCounts [markSvg exactlyOne zeroOrMany]
} -result {6 1}

test tudiagram-8.7 {an unknown mark draws nothing (treated as none)} -body {
    markCounts [markSvg none bogus]
} -result {1 0}

# --- groups (clusters, since 0.4) --------------------------------------------

proc groupDoc {} {
    set d [D::create -direction TB]
    set d [D::addNode $d A -label A]
    set d [D::addNode $d B -label B]
    set d [D::addNode $d C -label C]
    set d [D::addEdge $d A B -arrow end]
    set d [D::addEdge $d B C -arrow end]
    return $d
}

test tudiagram-9.1 {addGroup records id, label and members} -body {
    set d [D::addGroup [groupDoc] g1 -label "Phase 1" -members {A B}]
    lindex [dict get $d groups] 0
} -result {id g1 label {Phase 1} members {A B}}

test tudiagram-9.2 {addGroup defaults the label to the id} -body {
    set d [D::addGroup [groupDoc] g1 -members {A B}]
    dict get [lindex [dict get $d groups] 0] label
} -result {g1}

test tudiagram-9.3 {a model with a group still validates and lays out} -body {
    set d [D::addGroup [groupDoc] g1 -label G -members {A B}]
    set d [D::layout $d]
    expr {[dict get $d meta width] > 0 && [dict get $d meta height] > 0}
} -result 1

test tudiagram-9.4 {a grouped model renders to an <svg> document} -body {
    set d [D::addGroup [groupDoc] g1 -label "Phase 1" -members {A B}]
    string match {<svg*} [D::toSvg $d]
} -result 1

test tudiagram-9.5 {the group label appears in the SVG text} -body {
    set d [D::addGroup [groupDoc] g1 -label ZZTOP -members {A B}]
    expr {[string first ZZTOP [D::toSvg $d]] >= 0}
} -result 1

test tudiagram-9.6 {a grouped model renders valid PNG} -constraints tupngdraw -body {
    set d [D::addGroup [groupDoc] g1 -label G -members {A B}]
    binary scan [D::toPng $d] H8 s
    set s
} -result {89504e47}

test tudiagram-9.7 {a group with no real members is skipped at render (no crash)} -body {
    set d [D::addGroup [groupDoc] ghost -label X -members {NOPE}]
    string match {<svg*} [D::toSvg $d]
} -result 1

test tudiagram-9.8 {same-rank compaction keeps a foreign node out of the group span} -body {
    # A fans out to M1, X, M2 (all one rank); group {M1,M2} must end up
    # contiguous so X's centre is not inside the group's x-interval.
    set d [D::create -direction TB]
    foreach id {A M1 X M2} { set d [D::addNode $d $id -label $id] }
    set d [D::addEdge $d A M1 -arrow end]
    set d [D::addEdge $d A X  -arrow end]
    set d [D::addEdge $d A M2 -arrow end]
    set d [D::addGroup $d G -label G -members {M1 M2}]
    set d [D::layout $d]
    array set P {}
    foreach n [dict get $d nodes] {
        set P([dict get $n id]) [list [dict get $n x] [expr {[dict get $n x]+[dict get $n width]}]]
    }
    lassign $P(M1) m1a m1b; lassign $P(M2) m2a m2b; lassign $P(X) xa xb
    set lo [expr {min($m1a,$m2a)}]; set hi [expr {max($m1b,$m2b)}]
    set xc [expr {($xa+$xb)/2.0}]
    expr {$xc < $lo || $xc > $hi}
} -result 1

test tudiagram-9.9 {cross-rank groups get disjoint column bands} -body {
    # app={UI,Logic} (rank0), tk={WM,EV,Bind} and tcl={VM,PK} span ranks.
    # Each group must occupy its own column band -> pairwise-disjoint x-ranges.
    set d [D::create -direction TB]
    foreach id {UI Logic WM EV Bind VM PK} { set d [D::addNode $d $id -label $id] }
    foreach {f t} {UI WM Logic VM WM EV Bind EV EV VM PK VM} {
        set d [D::addEdge $d $f $t -arrow end]
    }
    set d [D::addGroup $d app -label App -members {UI Logic}]
    set d [D::addGroup $d tk  -label Tk  -members {WM EV Bind}]
    set d [D::addGroup $d tcl -label Tcl -members {VM PK}]
    set d [D::layout $d]
    array set R {}
    foreach n [dict get $d nodes] {
        set R([dict get $n id]) [list [dict get $n x] [expr {[dict get $n x]+[dict get $n width]}]]
    }
    set bands {}
    foreach mem {{UI Logic} {WM EV Bind} {VM PK}} {
        set lo 1e9; set hi -1e9
        foreach m $mem {
            lassign $R($m) a b
            set lo [expr {min($lo,$a)}]; set hi [expr {max($hi,$b)}]
        }
        lappend bands [list $lo $hi]
    }
    set bands [lsort -real -index 0 $bands]
    set ok 1
    for {set i 0} {$i < 2} {incr i} {
        if {[lindex $bands $i 1] > [lindex $bands [expr {$i+1}] 0] + 1} { set ok 0 }
    }
    set ok
} -result 1

test tudiagram-9.10 {_edgeLabelPoint returns a point at the fraction with a left normal} -body {
    # vertical line downwards: 40% point is (0,40); left normal of "down" is (-1,0)
    lassign [::tclutils::tudiagram::_edgeLabelPoint {0 0 0 100} 0.4] x y nx ny
    list [expr {round($x)}] [expr {round($y)}] [expr {round($nx)}] [expr {round($ny)}]
} -result {0 40 -1 0}

cleanupTests
