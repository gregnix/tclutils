package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tucat 0.2

set tmp [file join [temporaryDirectory] tucat-[pid].txt]
set f [open $tmp w]; puts $f "a\nb\n"; close $f

test tucat-1.1 {text returns input} {::tclutils::tucat::text "a\nb"} "a\nb"
test tucat-1.2 {file returns input} {string trimright [::tclutils::tucat::file $tmp]} "a\nb"
test tucat-1.3 {number lines} {::tclutils::tucat::text "a\nb" -number 1} "     1\ta\n     2\tb"
file delete -force $tmp
# --- 0.2 ---------------------------------------------------------------------

test tucat-2.1 {no number for the end after the last LF} -body {
    ::tclutils::tucat::text "eins\nJ\u00f6rg\n" -number 1
} -result "     1\teins\n     2\tJ\u00f6rg\n"

test tucat-2.2 {-nonblank skips empty lines} -body {
    ::tclutils::tucat::text "a\n\nb\n" -nonblank 1
} -result "     1\ta\n\n     2\tb\n"

test tucat-2.3 {files numbers through, as cat -n} -setup {
    set d [makeDirectory tucat23]
    set fa [file join $d a]; set fb [file join $d b]
    set fh [open $fa w]; puts -nonewline $fh "a\nb\n"; close $fh
    set fh [open $fb w]; puts -nonewline $fh "c\n"; close $fh
} -body {
    ::tclutils::tucat::files [list $fa $fb] -number 1
} -result "     1\ta\n     2\tb\n     3\tc\n"

test tucat-2.4 {files without LF are joined as they are} -setup {
    set d [makeDirectory tucat24]
    set fa [file join $d a]; set fb [file join $d b]
    set fh [open $fa w]; puts -nonewline $fh "J\u00f6rg"; close $fh
    set fh [open $fb w]; puts -nonewline $fh "drei"; close $fh
} -body {
    ::tclutils::tucat::files [list $fa $fb]
} -result "J\u00f6rgdrei"

test tucat-2.5 {unknown option is an error} -body {
    catch {::tclutils::tucat::text a -nummer 1}
    lrange $::errorCode 0 2
} -result {TCLUTILS COMMON OPTION}

cleanupTests
