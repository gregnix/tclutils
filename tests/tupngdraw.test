package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
tcl::tm::path add [file normalize [file join $here .. lib tm]]
package require tclutils::tupngdraw
package require tclutils::tuimage

# --- construction / dimensions --------------------------------------------
test tupngdraw-1.1 {new + accessors} -body {
    set p [::tclutils::tupngdraw::new -width 12 -height 8]
    set r [list [$p width] [$p height]]
    $p destroy
    set r
} -result {12 8}

test tupngdraw-1.2 {data is a valid PNG of the right size} -body {
    set p [::tclutils::tupngdraw::new -width 5 -height 3 -background white]
    set d [::tclutils::tuimage::inspect [$p data]]
    $p destroy
    set d
} -result {type png mime image/png width 5 height 3}

test tupngdraw-1.3 {background fills the surface} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4 -background {10 20 30}]
    set r [$p pixel 0 0]
    $p destroy
    set r
} -result {10 20 30 255}

# --- primitives via pixel readback ----------------------------------------
test tupngdraw-2.1 {setpixel uses stroke by default} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4 -background white]
    $p setstroke {255 0 0}
    $p setpixel 2 1
    set r [$p pixel 2 1]
    $p destroy
    set r
} -result {255 0 0 255}

test tupngdraw-2.2 {filled rect interior = fill colour} -body {
    set p [::tclutils::tupngdraw::new -width 20 -height 20 -background white]
    $p setfill {0 128 255}
    $p rect 4 4 15 15 -fill 1 -outline 0
    set r [$p pixel 9 9]
    $p destroy
    set r
} -result {0 128 255 255}

test tupngdraw-2.3 {rect outline uses stroke colour} -body {
    set p [::tclutils::tupngdraw::new -width 20 -height 20 -background white]
    $p setstroke {0 0 0}
    $p rect 4 4 15 15 -fill 0
    set r [$p pixel 4 4]
    $p destroy
    set r
} -result {0 0 0 255}

test tupngdraw-2.4 {line endpoints are drawn} -body {
    set p [::tclutils::tupngdraw::new -width 10 -height 10 -background white]
    $p setstroke {0 0 0}
    $p line 1 1 8 8
    list [$p pixel 1 1] [$p pixel 8 8]
} -result {{0 0 0 255} {0 0 0 255}} -cleanup {$p destroy}

test tupngdraw-2.5 {filled circle centre = fill colour} -body {
    set p [::tclutils::tupngdraw::new -width 30 -height 30 -background white]
    $p setfill {0 200 0}
    $p circle 15 15 8 -fill 1 -outline 0
    set r [$p pixel 15 15]
    $p destroy
    set r
} -result {0 200 0 255}

test tupngdraw-2.6 {filled polygon interior} -body {
    set p [::tclutils::tupngdraw::new -width 30 -height 30 -background white]
    $p setfill {200 0 200}
    $p polygon {5 5 25 5 15 25} -fill 1 -outline 0
    set r [$p pixel 15 10]
    $p destroy
    set r
} -result {200 0 200 255}

# --- alpha compositing (source-over) --------------------------------------
test tupngdraw-3.1 {semi-transparent over white blends} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4 -background white]
    $p setfill {0 0 255 128}
    $p rect 0 0 3 3 -fill 1 -outline 0
    $p pixel 1 1
} -result {127 127 255 255} -cleanup {$p destroy}

test tupngdraw-3.2 {opaque draw replaces} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4 -background black]
    $p setfill {255 255 255 255}
    $p rect 0 0 3 3 -fill 1 -outline 0
    $p pixel 2 2
} -result {255 255 255 255} -cleanup {$p destroy}

test tupngdraw-3.3 {fully transparent source is a no-op} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4 -background {10 20 30}]
    $p setfill {255 0 0 0}
    $p rect 0 0 3 3 -fill 1 -outline 0
    $p pixel 1 1
} -result {10 20 30 255} -cleanup {$p destroy}

# --- colour parsing forms -------------------------------------------------
test tupngdraw-4.1 {name, hex and list colours are equivalent} -body {
    list \
        [::tclutils::tupngdraw::_color red] \
        [::tclutils::tupngdraw::_color #FF0000] \
        [::tclutils::tupngdraw::_color FF0000] \
        [::tclutils::tupngdraw::_color {255 0 0}]
} -result {{255 0 0 255} {255 0 0 255} {255 0 0 255} {255 0 0 255}}

test tupngdraw-4.2 {8-digit hex carries alpha} -body {
    ::tclutils::tupngdraw::_color 0000FF80
} -result {0 0 255 128}

# --- determinism across runs ----------------------------------------------
test tupngdraw-5.1 {identical drawing -> identical bytes} -body {
    set mk {{} {
        set p [::tclutils::tupngdraw::new -width 16 -height 16 -background white]
        $p setfill {255 0 0}; $p circle 8 8 6 -fill 1
        set d [$p data]; $p destroy; set d
    }}
    expr {[apply $mk] eq [apply $mk]}
} -result 1

# --- error codes ----------------------------------------------------------
test tupngdraw-6.1 {bad colour -> COLOR} -body {
    catch {::tclutils::tupngdraw::_color ZZZ} e o
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW COLOR}

test tupngdraw-6.2 {polygon < 3 points -> POLY} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p polygon {0 0 5 5}} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW POLY}

test tupngdraw-6.3 {pixel out of range -> RANGE} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p pixel 99 0} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW RANGE}

test tupngdraw-6.4 {unknown option rejected by parseOptions} -body {
    catch {::tclutils::tupngdraw::new -bogus 1} e o
    dict get $o -errorcode
} -result {TCLUTILS COMMON OPTION -bogus}

test tupngdraw-6.5 {non-positive size rejected} -body {
    catch {::tclutils::tupngdraw::new -width 0 -height 4} e o
    dict get $o -errorcode
} -result {TCLUTILS COMMON INTEGER width}

# --- 0.2: text, ellipse, arc ----------------------------------------------
test tupngdraw-7.1 {textwidth = len * (6+spacing) * scale} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4]
    set w [$p textwidth "AB" -scale 2]
    $p destroy
    set w
} -result 24

test tupngdraw-7.2 {text draws glyph pixels in the chosen colour} -body {
    set p [::tclutils::tupngdraw::new -width 12 -height 10 -background white]
    $p text 0 0 "A" -color {255 0 0}
    set g [::tclutils::tupngdraw::_glyph 65]
    set found {}
    for {set ry 0} {$ry < 8 && $found eq ""} {incr ry} {
        set bits [lindex $g $ry]
        for {set rx 0} {$rx < 6} {incr rx} {
            if {($bits >> (5 - $rx)) & 1} { set found [list $rx $ry]; break }
        }
    }
    lassign $found fx fy
    set r [$p pixel $fx $fy]
    $p destroy
    set r
} -result {255 0 0 255}

test tupngdraw-7.3 {space glyph leaves background} -body {
    set p [::tclutils::tupngdraw::new -width 12 -height 10 -background white]
    $p text 0 0 " " -color {255 0 0}
    set r [$p pixel 2 3]
    $p destroy
    set r
} -result {255 255 255 255}

test tupngdraw-7.4 {filled ellipse interior = fill colour} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 30 -background white]
    $p setfill {0 0 200}
    $p ellipse 20 15 15 8 -fill 1 -outline 0
    set r [$p pixel 20 15]
    $p destroy
    set r
} -result {0 0 200 255}

test tupngdraw-7.5 {filled pie wedge interior = fill colour} -body {
    set p [::tclutils::tupngdraw::new -width 60 -height 60 -background white]
    $p setfill {200 0 0}
    $p arc 30 30 25 0 90 -fill 1 -style pie
    set r [$p pixel 38 38]
    $p destroy
    set r
} -result {200 0 0 255}

test tupngdraw-7.6 {bad arc style -> STYLE} -body {
    set p [::tclutils::tupngdraw::new -width 10 -height 10]
    catch {$p arc 5 5 3 0 90 -style wat} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW STYLE}

# --- 0.3: antialiasing + alpha-correct strokes ----------------------------
test tupngdraw-8.1 {antialiased line has partial-coverage (gray) pixels} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p line 2 4 21 15 -color black -aa 1
    set gray 0
    for {set y 0} {$y < 24} {incr y} {
        for {set x 0} {$x < 24} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    set gray
} -result 1

test tupngdraw-8.2 {-aa 0 keeps strokes crisp (only black or white)} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p line 2 4 21 15 -color black -aa 0
    set onlyBW 1
    for {set y 0} {$y < 24} {incr y} {
        for {set x 0} {$x < 24} {incr x} {
            set px [$p pixel $x $y]
            if {$px ne {0 0 0 255} && $px ne {255 255 255 255}} { set onlyBW 0 }
        }
    }
    $p destroy
    set onlyBW
} -result 1

test tupngdraw-8.3 {thick translucent outline: corner not composited twice} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 40 -background white]
    $p setstroke {255 0 0 128}
    $p setlinewidth 6
    $p rect 8 8 32 32 -fill 0
    set r [expr {[$p pixel 8 8] eq [$p pixel 20 8]}]
    $p destroy
    set r
} -result 1

test tupngdraw-8.4 {setantialias 0 makes strokes crisp by default} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p setantialias 0
    $p line 2 4 21 15 -color black
    set gray 0
    for {set y 0} {$y < 24} {incr y} {
        for {set x 0} {$x < 24} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    set gray
} -result 0

test tupngdraw-8.5 {bad -aa -> COMMON BOOLEAN} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p line 0 0 5 5 -aa wat} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS COMMON BOOLEAN -aa}

# --- 0.4: line caps + antialiased circle fill -----------------------------
test tupngdraw-9.1 {butt cap: no coverage past the endpoint} -body {
    set p [::tclutils::tupngdraw::new -width 30 -height 20 -background white]
    $p line 10 10 22 10 -width 5 -caps butt -color black
    set r [$p pixel 7 10]
    $p destroy
    set r
} -result {255 255 255 255}

test tupngdraw-9.2 {round cap: coverage past the endpoint} -body {
    set p [::tclutils::tupngdraw::new -width 30 -height 20 -background white]
    $p line 10 10 22 10 -width 5 -caps round -color black
    lassign [$p pixel 8 10] rr gg bb aa
    $p destroy
    expr {$rr < 255}
} -result 1

test tupngdraw-9.3 {antialiased circle fill has a soft edge} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 40 -background white]
    $p setfill black
    $p circle 20 20 12 -fill 1 -outline 0
    set gray 0
    for {set y 0} {$y < 40} {incr y} {
        for {set x 0} {$x < 40} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    set gray
} -result 1

test tupngdraw-9.4 {circle fill centre stays fully opaque} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 40 -background white]
    $p setfill {0 0 200}
    $p circle 20 20 12 -fill 1 -outline 0
    set r [$p pixel 20 20]
    $p destroy
    set r
} -result {0 0 200 255}

test tupngdraw-9.5 {bad -caps -> CAPS} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p line 0 0 5 5 -caps wat} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW CAPS}

# --- 0.5: antialiased fills (supersampled) + bevel/mitre joins ------------
test tupngdraw-10.1 {AA polygon fill has soft edges} -body {
    set p [::tclutils::tupngdraw::new -width 50 -height 40 -background white]
    $p setfill black
    $p polygon {5 35 25 4 45 35} -fill 1 -outline 0
    set gray 0
    for {set y 0} {$y < 40} {incr y} {
        for {set x 0} {$x < 50} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    set gray
} -result 1

test tupngdraw-10.2 {AA ellipse fill has soft edges} -body {
    set p [::tclutils::tupngdraw::new -width 60 -height 40 -background white]
    $p setfill black
    $p ellipse 30 20 24 14 -fill 1 -outline 0
    set gray 0
    for {set y 0} {$y < 40} {incr y} {
        for {set x 0} {$x < 60} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    set gray
} -result 1

test tupngdraw-10.3 {mitre join fills the sharp outer corner} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 40 -background white]
    $p setstroke black
    $p setlinewidth 6
    $p rect 10 10 30 30 -fill 0 -join mitre
    set r [$p pixel 7 7]
    $p destroy
    set r
} -result {0 0 0 255}

test tupngdraw-10.4 {round join leaves the sharp outer corner} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 40 -background white]
    $p setstroke black
    $p setlinewidth 6
    $p rect 10 10 30 30 -fill 0 -join round
    set r [$p pixel 7 7]
    $p destroy
    set r
} -result {255 255 255 255}

test tupngdraw-10.5 {bad -join -> JOIN} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p rect 1 1 6 6 -join wat} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW JOIN}

# --- 0.6: German umlaut / eszett glyphs in the 6x8 font --------------------
test tupngdraw-11.1 {umlaut glyph differs from its base letter} -body {
    expr {[::tclutils::tupngdraw::_glyph 228] ne [::tclutils::tupngdraw::_glyph 97]}
} -result 1

test tupngdraw-11.2 {a-diaeresis draws the top dots} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8 -background white]
    $p text 0 0 "\u00e4" -color {255 0 0} -scale 1
    set r [list [$p pixel 1 0] [$p pixel 4 0]]
    $p destroy
    set r
} -result {{255 0 0 255} {255 0 0 255}}

test tupngdraw-11.3 {unknown code point falls back to blank} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8 -background white]
    $p text 0 0 "\u2603" -color {255 0 0} -scale 1
    set drawn 0
    for {set y 0} {$y < 8} {incr y} {
        for {set x 0} {$x < 8} {incr x} {
            if {[$p pixel $x $y] ne {255 255 255 255}} { incr drawn }
        }
    }
    $p destroy
    set drawn
} -result 0

test tupngdraw-11.4 {textwidth counts umlaut chars like any other} -body {
    set p [::tclutils::tupngdraw::new -width 4 -height 4]
    set w [$p textwidth "M\u00e4rz" -scale 1]
    $p destroy
    set w
} -result 24

# --- 0.7: fillcontours (vector path fill, nonzero|evenodd, AA) --------------
test tupngdraw-12.1 {fillcontours fills a single triangle with AA edges} -body {
    set p [::tclutils::tupngdraw::new -width 40 -height 36 -background white]
    $p fillcontours {{4 32 20 4 36 32}} -color black
    set inside [$p pixel 20 24]
    set gray 0
    for {set y 0} {$y < 36} {incr y} {
        for {set x 0} {$x < 40} {incr x} {
            lassign [$p pixel $x $y] r g b a
            if {$r == $g && $g == $b && $r > 0 && $r < 255} { set gray 1 }
        }
    }
    $p destroy
    list $inside $gray
} -result {{0 0 0 255} 1}

test tupngdraw-12.2 {evenodd: nested contour is a hole} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p fillcontours {{2 2 22 2 22 22 2 22} {8 8 16 8 16 16 8 16}} \
        -color black -rule evenodd -aa 0
    set r [$p pixel 12 12]
    $p destroy
    set r
} -result {255 255 255 255}

test tupngdraw-12.3 {nonzero: same-direction nested contour stays filled} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p fillcontours {{2 2 22 2 22 22 2 22} {8 8 16 8 16 16 8 16}} \
        -color black -rule nonzero -aa 0
    set r [$p pixel 12 12]
    $p destroy
    set r
} -result {0 0 0 255}

test tupngdraw-12.4 {nonzero: opposite-direction nested contour is a hole} -body {
    set p [::tclutils::tupngdraw::new -width 24 -height 24 -background white]
    $p fillcontours {{2 2 22 2 22 22 2 22} {8 8 8 16 16 16 16 8}} \
        -color black -rule nonzero -aa 0
    set r [$p pixel 12 12]
    $p destroy
    set r
} -result {255 255 255 255}

test tupngdraw-12.5 {bad -rule -> RULE} -body {
    set p [::tclutils::tupngdraw::new -width 8 -height 8]
    catch {$p fillcontours {{0 0 8 0 8 8}} -rule wat} e o
    $p destroy
    dict get $o -errorcode
} -result {TCLUTILS TUPNGDRAW RULE}

cleanupTests
