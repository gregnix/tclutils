package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuzip 0.2

# Keep all generated ZIP test scratch under tests/.tmp, never in the project root.
set tuzipTmpRoot [file normalize [file join $here .tmp]]
file mkdir $tuzipTmpRoot
tcltest::configure -tmpdir $tuzipTmpRoot

set tmp [makeDirectory tuzip]
set a [file join $tmp a.txt]
set b [file join $tmp b.txt]
set sub [file join $tmp sub]
file mkdir $sub
set c [file join $sub c.txt]
set f [open $a w]; puts $f "hello"; close $f
set f [open $b w]; puts $f "banana"; close $f
set f [open $c w]; puts $f "inside"; close $f
set zip [file join $tmp test.zip]

test tuzip-1.1 {create zip with relative names} -body {
    ::tclutils::tuzip::create $zip [list $a $b $c] -base $tmp
    lsort [::tclutils::tuzip::names $zip]
} -result {a.txt b.txt sub/c.txt}

test tuzip-1.2 {read member} -body {
    string trim [::tclutils::tuzip::readMember $zip a.txt]
} -result {hello}

test tuzip-1.3 {extract member} -body {
    set out [file join $tmp out c.txt]
    ::tclutils::tuzip::extract $zip sub/c.txt $out
    set f [open $out r]
    set data [string trim [read $f]]
    close $f
    set data
} -result {inside}

test tuzip-1.4 {stored zip no compression} -body {
    set zip2 [file join $tmp stored.zip]
    ::tclutils::tuzip::create $zip2 [list $a] -base $tmp -compress 0
    set e [lindex [::tclutils::tuzip::entries $zip2] 0]
    list [dict get $e name] [dict get $e method] [string trim [::tclutils::tuzip::readMember $zip2 a.txt]]
} -result {a.txt 0 hello}

test tuzip-1.5 {missing member throws error} -body {
    catch {::tclutils::tuzip::readMember $zip missing.txt} msg opts
    list $msg [lrange [dict get $opts -errorcode] 0 2]
} -result {{member not found: missing.txt} {TCLUTILS TUZIP MEMBER}}


test tuzip-1.6 {DosTime handles zero-padded 08 and 09 fields} -body {
    # 2026-05-30 19:08:09 local time: minute=08, second=09.
    # This used to trigger Tcl expr's octal parsing trap.
    lassign [::tclutils::tuzip::DosTime [clock scan {2026-05-30 19:08:09} -format {%Y-%m-%d %H:%M:%S}]] time date
    expr {$time > 0 && $date > 0}
} -result 1

test tuzip-1.7 {ODT-style smoke test: mimetype and content.xml readable} -body {
    set odtdir [file join $tmp odt]
    file mkdir $odtdir
    set mimetype [file join $odtdir mimetype]
    set content [file join $odtdir content.xml]
    set f [open $mimetype w]
    puts -nonewline $f {application/vnd.oasis.opendocument.text}
    close $f
    set f [open $content w]
    puts -nonewline $f {<?xml version="1.0" encoding="UTF-8"?><office:document-content/>}
    close $f
    set odt [file join $tmp smoke.odt]
    ::tclutils::tuzip::create $odt [list $mimetype $content] -base $odtdir -compress 0
    list [lrange [::tclutils::tuzip::names $odt] 0 1]         [::tclutils::tuzip::readMember $odt mimetype]         [string match {*office:document-content*} [::tclutils::tuzip::readMember $odt content.xml]]
} -result {{mimetype content.xml} application/vnd.oasis.opendocument.text 1}

proc _zbytes {f} { set ch [open $f rb]; set b [read $ch]; close $ch; return $b }

test tuzip-3.1 {non-ASCII names: UTF-8 with flag 0x800, read back (0.2)} -body {
    set z [file join $tmp utf8.zip]
    ::tclutils::tuzip::createMembers $z [list \
        [dict create name "J\u00f6rg.txt" content "x" method stored] \
        [dict create name "a\u20acb.txt" content "y" method stored] \
        [dict create name plain.txt content "z" method stored]]
    set b [_zbytes $z]
    list [::tclutils::tuzip::names $z] \
         [lmap e [::tclutils::tuzip::entries $z] {expr {[dict get $e flags] & 0x800}}] \
         [expr {[string first [encoding convertto utf-8 "J\u00f6rg.txt"] $b] >= 0}] \
         [::tclutils::tuzip::readMember $z "a\u20acb.txt"]
} -result [list [list "J\u00f6rg.txt" "a\u20acb.txt" plain.txt] {2048 2048 0} 1 y]

proc _zipWithName {f nameBytes flags} {
    # one stored member "x" with the given raw name bytes and flags
    set crc [expr {[zlib crc32 x] & 0xffffffff}]
    set n [string length $nameBytes]
    set lh "PK\x03\x04[binary format sssss 20 $flags 0 0 0][binary format iii $crc 1 1][binary format ss $n 0]$nameBytes"
    set data "${lh}x"
    set cd "PK\x01\x02[binary format ssssss 20 20 $flags 0 0 0][binary format iii $crc 1 1][binary format sssssii $n 0 0 0 0 0 0]$nameBytes"
    set eocd "PK\x05\x06[binary format ssssiis 0 0 1 1 [string length $cd] [string length $data] 0]"
    set ch [open $f wb]; puts -nonewline $ch "$data$cd$eocd"; close $ch
}

test tuzip-3.2 {names without flag: valid UTF-8, else CP437; -encoding for others} -body {
    set a [file join $tmp a.zip]; set c [file join $tmp c.zip]
    _zipWithName $a [encoding convertto utf-8 "J\u00f6rg"] 0
    _zipWithName $c [encoding convertto iso8859-1 "J\u00f6rg"] 0
    list [::tclutils::tuzip::names $a] [::tclutils::tuzip::names $c] \
         [::tclutils::tuzip::names $c -encoding iso8859-1] \
         [::tclutils::tuzip::readMember $c "J\u00f6rg" -encoding iso8859-1] \
         [catch {::tclutils::tuzip::names $c -encoding nonsense} m o] [dict get $o -errorcode]
} -result [list "J\u00f6rg" "J\u00f7rg" "J\u00f6rg" x 1 {TCLUTILS TUZIP ENCODING}]

proc rmTree {path} {
    if {![file exists $path]} { return }
    foreach child [glob -nocomplain -directory $path * .*] {
        set tail [file tail $child]
        if {$tail in {. ..}} { continue }
        if {[file isdirectory $child]} {
            rmTree $child
        } else {
            file delete $child
        }
    }
    file delete $path
}
rmTree $tmp
catch {file delete $tuzipTmpRoot}
file mkdir $tuzipTmpRoot

test tuzip-4.1 {create: a failed write leaves the old file} -setup {
    set src [makeFile hello zsrc-4.1.txt]
    set f [makeFile PRECIOUS z-4.1.zip]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {
        ::tclutils::tuzip::create $f [list $src]
    }]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile zsrc-4.1.txt
    removeFile z-4.1.zip
} -result {1 PRECIOUS 0 0}

test tuzip-4.2 {createMembers: a failed write leaves the old file} -setup {
    set f [makeFile PRECIOUS z-4.2.zip]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {
        ::tclutils::tuzip::createMembers $f [list [dict create name a.txt content hello]]
    }]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile z-4.2.zip
} -result {1 PRECIOUS 0 0}

test tuzip-4.3 {extract: a failed write leaves the old file} -setup {
    set src [makeFile hello zsrc-4.3.txt]
    set zip [makeFile {} z-4.3-ok.zip]
    ::tclutils::tuzip::create $zip [list $src]
    set f [makeFile PRECIOUS z-4.3-out.txt]
    set before [llength [chan names file*]]
    rename ::puts ::_realPuts
    proc ::puts args {
        if {[string match file* [lindex $args end-1]]} { error "disk full" }
        ::_realPuts {*}$args
    }
} -body {
    set rc [catch {
        ::tclutils::tuzip::extract $zip [file tail $src] $f
    }]
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    set ch [open $f]; set d [read $ch]; close $ch
    list $rc [string trim $d] [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $f.tmp*]]
} -cleanup {
    if {[llength [info commands ::_realPuts]]} { rename ::puts {}; rename ::_realPuts ::puts }
    removeFile zsrc-4.3.txt
    removeFile z-4.3-ok.zip
    removeFile z-4.3-out.txt
} -result {1 PRECIOUS 0 0}

cleanupTests
