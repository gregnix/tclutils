test tudav-8.1 {proppatch builds a propertyupdate body} -setup {
    rename ::tclutils::tudav::_request ::tclutils::tudav::_req8
    proc ::tclutils::tudav::_request {c method path args} {
        set ::cap8 [list $method [dict get $args -query]]
        return [dict create code {HTTP/1.1 207 Multi-Status} ncode 207 meta {} \
            body {<d:multistatus xmlns:d="DAV:"></d:multistatus>}]
    }
} -body {
    ::tclutils::tudav::proppatch c0 /alice/cal/ {displayname "My Cal" calendar-color "#ff0000ff"}
    lassign $::cap8 m q
    list $m \
        [string match {*<D:propertyupdate*} $q] \
        [string match {*<D:displayname>My Cal</D:displayname>*} $q] \
        [string match {*<I:calendar-color>#ff0000ff</I:calendar-color>*} $q] \
        [string match {*apple.com/ns/ical/*} $q]
} -cleanup {
    rename ::tclutils::tudav::_request ""
    rename ::tclutils::tudav::_req8 ::tclutils::tudav::_request
    unset -nocomplain ::cap8
} -result {PROPPATCH 1 1 1 1}

test tudav-8.2 {proppatch rejects the read-only component set} -body {
    catch {::tclutils::tudav::proppatch c0 /x/ {supported-calendar-component-set VEVENT}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUDAV PROP}

test tudav-8.3 {getProperties parses text values and the component set} -setup {
    rename ::tclutils::tudav::_request ::tclutils::tudav::_req8
    proc ::tclutils::tudav::_request {c method path args} {
        return [dict create code {HTTP/1.1 207 Multi-Status} ncode 207 meta {} body {<d:multistatus xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav" xmlns:i="http://apple.com/ns/ical/"><d:response><d:propstat><d:prop><d:displayname>Cal</d:displayname><i:calendar-color>#112233ff</i:calendar-color><c:calendar-description>desc</c:calendar-description><c:supported-calendar-component-set><c:comp name="VEVENT"/><c:comp name="VTODO"/></c:supported-calendar-component-set></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response></d:multistatus>}]
    }
} -body {
    set p [::tclutils::tudav::getProperties c0 -path /alice/cal/ \
        -props {displayname calendar-color calendar-description supported-calendar-component-set}]
    list [dict get $p displayname] [dict get $p calendar-color] \
         [dict get $p calendar-description] [dict get $p supported-calendar-component-set]
} -cleanup {
    rename ::tclutils::tudav::_request ""
    rename ::tclutils::tudav::_req8 ::tclutils::tudav::_request
} -result {Cal #112233ff desc {VEVENT VTODO}}

cleanupTests
