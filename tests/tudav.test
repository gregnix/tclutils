    proc ::tclutils::tudav::_request {c method path args} {
        return [dict create code {HTTP/1.1 207 Multi-Status} ncode 207 meta {} body {<d:multistatus xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:carddav"><d:response><d:propstat><d:prop><c:addressbook-home-set><d:href>/alice/</d:href></c:addressbook-home-set></d:prop></d:propstat></d:response></d:multistatus>}]
