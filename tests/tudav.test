test tudav-8.1 {proppatch builds a propertyupdate body} -setup {
    rename ::tclutils::tudav::_request ::tclutils::tudav::_req8
    proc ::tclutils::tudav::_request {c method path args} {
        set ::cap8 [list $method [dict get $args -query]]
        return [dict create code {HTTP/1.1 207 Multi-Status} ncode 207 meta {} \
            body {<d:multistatus xmlns:d="DAV:"></d:multistatus>}]
    }
} -body {
    ::tclutils::tudav::proppatch c0 /alice/cal/ {displayname "My Cal" calendar-color "#ff0000ff"}
    lassign $::cap8 m q
    list $m \
        [string match {*<D:propertyupdate*} $q] \
        [string match {*<D:displayname>My Cal</D:displayname>*} $q] \
        [string match {*<I:calendar-color>#ff0000ff</I:calendar-color>*} $q] \
        [string match {*apple.com/ns/ical/*} $q]
} -cleanup {
    rename ::tclutils::tudav::_request ""
    rename ::tclutils::tudav::_req8 ::tclutils::tudav::_request
    unset -nocomplain ::cap8
} -result {PROPPATCH 1 1 1 1}

test tudav-8.2 {proppatch rejects the read-only component set} -body {
    catch {::tclutils::tudav::proppatch c0 /x/ {supported-calendar-component-set VEVENT}} e o
    dict get $o -errorcode
} -result {TCLUTILS TUDAV PROP}

test tudav-8.3 {getProperties parses text values and the component set} -setup {
    rename ::tclutils::tudav::_request ::tclutils::tudav::_req8
    proc ::tclutils::tudav::_request {c method path args} {
        return [dict create code {HTTP/1.1 207 Multi-Status} ncode 207 meta {} body {<d:multistatus xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav" xmlns:i="http://apple.com/ns/ical/"><d:response><d:propstat><d:prop><d:displayname>Cal</d:displayname><i:calendar-color>#112233ff</i:calendar-color><c:calendar-description>desc</c:calendar-description><c:supported-calendar-component-set><c:comp name="VEVENT"/><c:comp name="VTODO"/></c:supported-calendar-component-set></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response></d:multistatus>}]
    }
} -body {
    set p [::tclutils::tudav::getProperties c0 -path /alice/cal/ \
        -props {displayname calendar-color calendar-description supported-calendar-component-set}]
    list [dict get $p displayname] [dict get $p calendar-color] \
         [dict get $p calendar-description] [dict get $p supported-calendar-component-set]
} -cleanup {
    rename ::tclutils::tudav::_request ""
    rename ::tclutils::tudav::_req8 ::tclutils::tudav::_request
} -result {Cal #112233ff desc {VEVENT VTODO}}

# ---- 0.2: certificate verification, scoped https registration ----
set here [file dirname [file normalize [info script]]]
testConstraint tls [expr {![catch {package require tls}]}]
set crt [file join $here data tuhttps-localhost.crt]
set key [file join $here data tuhttps-localhost.key]
set lport 0
if {[testConstraint tls]} {
    set srvPipe [open |[list [info nameofexecutable] \
        [file join $here data https-server.tcl] $crt $key] r+]
    gets $srvPipe lport
}
proc davReg {} {
    if {[info exists ::http::urlTypes(https)]} { return $::http::urlTypes(https) }
    return <none>
}

test tudav-9.1 {self-signed server rejected by default} -constraints tls -body {
    set c [::tclutils::tudav::client https://localhost:$lport/]
    catch {::tclutils::tudav::get $c x}
} -cleanup { ::tclutils::tudav::destroy $c } -result 1

test tudav-9.2 {-cafile with the server certificate: accepted} -constraints tls -body {
    set c [::tclutils::tudav::client https://localhost:$lport/ -cafile $crt]
    ::tclutils::tudav::get $c x
} -cleanup { ::tclutils::tudav::destroy $c } -result ok

test tudav-9.3 {-insecure 1: accepted; registration left as found} -constraints tls -setup {
    catch {::http::unregister https}
} -body {
    set c [::tclutils::tudav::client https://localhost:$lport/ -insecure 1]
    list [::tclutils::tudav::get $c x] [davReg]
} -cleanup { ::tclutils::tudav::destroy $c } -result {ok <none>}

test tudav-9.4 {configure -insecure / -cafile; unknown option names the known ones} -body {
    set c [::tclutils::tudav::client https://localhost:$lport/]
    ::tclutils::tudav::configure $c -insecure yes -cafile /x.pem
    catch {::tclutils::tudav::configure $c -insecur 1} m
    list $::tclutils::tudav::state($c,insecure) $::tclutils::tudav::state($c,cafile) \
         [string match "*Known:*-cafile -insecure" $m]
} -cleanup { ::tclutils::tudav::destroy $c } -result {1 /x.pem 1}

test tudav-9.5 {client -insecure must be boolean} -body {
    catch {::tclutils::tudav::client https://h/ -insecure maybe} m o
    lrange [dict get $o -errorcode] 0 2
} -result {TCLUTILS COMMON BOOLEAN}

if {[info exists srvPipe]} { catch {close $srvPipe} }

test tudav-1.2 {basic auth is UTF-8} -body {
    ::tclutils::tudav::_basicAuth "J\u00f6rg" "\u20ac"
} -result {Basic SsO2cmc64oKs}

test tudav-10.1 {status and properties from the 2xx propstat} -body {
    set x [string map [list @ \u00f6] {<?xml version="1.0"?><d:multistatus xmlns:d="DAV:"><d:response><d:href>/B%C3%BCro/a.ics</d:href>
      <d:propstat><d:prop><d:getcontenttype/></d:prop><d:status>HTTP/1.1 404 Not Found</d:status></d:propstat>
      <d:propstat><d:prop><d:displayname>J@rg</d:displayname><d:getetag>W/"abc"</d:getetag></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat>
    </d:response></d:multistatus>}]
    set r [lindex [::tclutils::tudav::_parseMultistatus $x] 0]
    list [dict get $r displayname] [dict get $r code] [dict get $r etag]
} -result [list "J\u00f6rg" 200 {W/"abc"}]
test tudav-10.2 {If-Match gets the quotes back} -body {
    list [::tclutils::tudav::_etagHeader abc] [::tclutils::tudav::_etagHeader {"abc"}] \
         [::tclutils::tudav::_etagHeader {W/"abc"}] [::tclutils::tudav::_etagValue {"abc"}]
} -result [list {"abc"} {"abc"} {W/"abc"} abc]
test tudav-10.3 {a day that does not exist is DATE on 8.6 too} -body {
    set r {}
    foreach d {2026-02-29 20260229 2024-02-29 2026-1-5} {
        if {[catch {::tclutils::tudav::_caldavTime $d} v o]} { set v [lindex [dict get $o -errorcode] end] }
        lappend r $v
    }
    set r
} -result {DATE DATE 20240229T000000Z 20260105T000000Z}

test tudav-10.4 {resolve removes "." and ".." segments (0.3)} -body {
    list [::tclutils::tudav::_resolve https://example/kalender/ ../J\u00f6rg.ics] \
         [::tclutils::tudav::_resolve https://example/a/b/ ./c/../d.ics] \
         [::tclutils::tudav::_resolve https://example/a/ /x/../y/] \
         [::tclutils::tudav::_resolve https://example/ ../../z.ics] \
         [::tclutils::tudav::_resolve https://example/a/coll x.vcf]
} -result [list https://example/J\u00f6rg.ics https://example/a/b/d.ics https://example/y/ https://example/z.ics https://example/a/x.vcf]


test tudav-10.5 {resolve: "//host/x" keeps the scheme, takes the host} -body {
    list [::tclutils::tudav::_resolve https://example/cal/x.ics //other.example/x] \
         [::tclutils::tudav::_resolve http://h/a/ //o/a/../b.ics] \
         [::tclutils::tudav::_resolve https://example/cal/ //o]
} -result {https://other.example/x http://o/b.ics https://o}

test tudav-11.1 {_origin: scheme, host and port, default ports filled in} -body {
    list [::tclutils::tudav::_origin https://U@Dav.Example/cal/] \
         [::tclutils::tudav::_origin http://h:5232/x] \
         [::tclutils::tudav::_origin {http://[::1]/x}] \
         [::tclutils::tudav::_origin /rel/path]
} -result {https://dav.example:443 http://h:5232 {http://[::1]:80} {}}

# A one-shot HTTP server that answers 200 and notes whether the request
# carried an Authorization header.
proc davSrvAccept {name ch addr port} {
    fconfigure $ch -translation crlf -blocking 0
    set ::davAuth($ch) 0
    fileevent $ch readable [list davSrvRead $name $ch]
}
proc davSrvRead {name ch} {
    while {[gets $ch line] >= 0} {
        if {[string match -nocase authorization:* $line]} { set ::davAuth($ch) 1 }
        if {$line eq ""} {
            lappend ::davSeen $name $::davAuth($ch)
            fconfigure $ch -blocking 1
            puts -nonewline $ch "HTTP/1.0 200 OK\nContent-Type: text/plain\nContent-Length: 2\n\nok"
            close $ch
            return
        }
    }
    if {[eof $ch]} { close $ch }
}

test tudav-11.2 {Authorization only to the base origin; only http and https} -setup {
    set ::davSeen {}
    set s1 [socket -server [list davSrvAccept base] -myaddr 127.0.0.1 0]
    set s2 [socket -server [list davSrvAccept other] -myaddr 127.0.0.1 0]
    set p1 [lindex [fconfigure $s1 -sockname] 2]
    set p2 [lindex [fconfigure $s2 -sockname] 2]
    set c [::tclutils::tudav::client http://127.0.0.1:$p1/dav/ -user u -password p]
} -body {
    ::tclutils::tudav::get $c x.ics
    ::tclutils::tudav::get $c http://127.0.0.1:$p2/steal.ics
    ::tclutils::tudav::get $c http://127.0.0.1:$p1/abs.ics
    set rc [catch {::tclutils::tudav::get $c file:///etc/passwd} m o]
    list $::davSeen $rc [dict get $o -errorcode]
} -cleanup {
    close $s1; close $s2
} -result {{base 1 other 0 base 1} 1 {TCLUTILS TUDAV URL}}

