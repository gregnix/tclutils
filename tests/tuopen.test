package require tcltest
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuopen 0.1

test tuopen-1.1 {windows command} -body {
    ::tclutils::tuopen::command http://x.com -platform windows
} -result {cmd.exe /c start {} http://x.com}
test tuopen-1.2 {macOS command} -body {
    ::tclutils::tuopen::command /tmp/a.pdf -platform unix -os Darwin
} -result {open /tmp/a.pdf}
test tuopen-1.3 {linux command} -body {
    ::tclutils::tuopen::command http://x.com -platform unix -os Linux
} -result {xdg-open http://x.com}
test tuopen-1.4 {default uses host platform (returns a non-empty list)} -body {
    expr {[llength [::tclutils::tuopen::command http://x.com]] >= 1}
} -result 1
test tuopen-2.1 {empty target errors} -body {
    catch {::tclutils::tuopen::command ""} e o
    dict get $o -errorcode
} -result {TCLUTILS TUOPEN TARGET}

# --- edit ---
test tuopen-3.1 {editCommand windows} -body {
    ::tclutils::tuopen::editCommand /tmp/a.txt -platform windows
} -result {notepad /tmp/a.txt}
test tuopen-3.2 {editCommand macOS} -body {
    ::tclutils::tuopen::editCommand /tmp/a.txt -platform unix -os Darwin
} -result {open -e /tmp/a.txt}
test tuopen-3.3 {editCommand explicit multi-word editor} -body {
    ::tclutils::tuopen::editCommand /tmp/a.txt -editor {code -w}
} -result {code -w /tmp/a.txt}
test tuopen-3.4 {editCommand unix honors EDITOR} -setup {
    set ::_e [expr {[info exists ::env(EDITOR)] ? $::env(EDITOR) : ""}]
    set ::env(EDITOR) nano
} -body {
    ::tclutils::tuopen::editCommand /tmp/a.txt -platform unix -os Linux
} -cleanup {
    if {$::_e eq ""} { unset -nocomplain ::env(EDITOR) } else { set ::env(EDITOR) $::_e }
} -result {nano /tmp/a.txt}
test tuopen-3.5 {editCommand unix fallback when no EDITOR} -setup {
    set ::_e [expr {[info exists ::env(EDITOR)] ? $::env(EDITOR) : ""}]
    unset -nocomplain ::env(EDITOR)
} -body {
    ::tclutils::tuopen::editCommand /tmp/a.txt -platform unix -os Linux
} -cleanup {
    if {$::_e ne ""} { set ::env(EDITOR) $::_e }
} -result {xdg-open /tmp/a.txt}

# --- openDir target resolution ---
test tuopen-4.1 {_dirTarget: existing file -> parent} -setup {
    set ::_f [file join [::tcltest::makeDirectory td] sample.txt]
    close [open $::_f w]
} -body {
    expr {[::tclutils::tuopen::_dirTarget $::_f] eq [file dirname $::_f]}
} -cleanup { ::tcltest::removeDirectory td; unset -nocomplain ::_f } -result 1
test tuopen-4.2 {_dirTarget: non-file path unchanged} -body {
    ::tclutils::tuopen::_dirTarget /no/such/path
} -result /no/such/path

# --- config paths ---
test tuopen-5.1 {configDir windows uses APPDATA} -setup {
    set ::_a [expr {[info exists ::env(APPDATA)] ? $::env(APPDATA) : ""}]
    set ::env(APPDATA) /roaming
} -body {
    ::tclutils::tuopen::configDir myapp -platform windows
} -cleanup {
    if {$::_a eq ""} { unset -nocomplain ::env(APPDATA) } else { set ::env(APPDATA) $::_a }
} -result {/roaming/myapp}
test tuopen-5.2 {configDir unix uses XDG_CONFIG_HOME} -setup {
    set ::_x [expr {[info exists ::env(XDG_CONFIG_HOME)] ? $::env(XDG_CONFIG_HOME) : ""}]
    set ::env(XDG_CONFIG_HOME) /xdg
} -body {
    ::tclutils::tuopen::configDir myapp -platform unix -os Linux
} -cleanup {
    if {$::_x eq ""} { unset -nocomplain ::env(XDG_CONFIG_HOME) } else { set ::env(XDG_CONFIG_HOME) $::_x }
} -result {/xdg/myapp}
test tuopen-5.3 {configDir unix falls back to HOME/.config} -setup {
    set ::_x [expr {[info exists ::env(XDG_CONFIG_HOME)] ? $::env(XDG_CONFIG_HOME) : ""}]
    unset -nocomplain ::env(XDG_CONFIG_HOME)
    set ::_h [expr {[info exists ::env(HOME)] ? $::env(HOME) : ""}]
    set ::env(HOME) /home/g
} -body {
    ::tclutils::tuopen::configDir myapp -platform unix -os Linux
} -cleanup {
    if {$::_x ne ""} { set ::env(XDG_CONFIG_HOME) $::_x }
    if {$::_h ne ""} { set ::env(HOME) $::_h }
} -result {/home/g/.config/myapp}
test tuopen-5.4 {configDir macOS} -setup {
    set ::_h [expr {[info exists ::env(HOME)] ? $::env(HOME) : ""}]
    set ::env(HOME) /Users/g
} -body {
    ::tclutils::tuopen::configDir myapp -platform unix -os Darwin
} -cleanup { if {$::_h ne ""} { set ::env(HOME) $::_h } } -result {/Users/g/Library/Application Support/myapp}
test tuopen-5.5 {configFile joins filename} -setup {
    set ::_x [expr {[info exists ::env(XDG_CONFIG_HOME)] ? $::env(XDG_CONFIG_HOME) : ""}]
    set ::env(XDG_CONFIG_HOME) /c
} -body {
    ::tclutils::tuopen::configFile myapp settings.ini -platform unix -os Linux
} -cleanup {
    if {$::_x eq ""} { unset -nocomplain ::env(XDG_CONFIG_HOME) } else { set ::env(XDG_CONFIG_HOME) $::_x }
} -result {/c/myapp/settings.ini}
test tuopen-5.6 {configDir empty app errors} -body {
    catch {::tclutils::tuopen::configDir ""} e o
    dict get $o -errorcode
} -result {TCLUTILS TUOPEN APP}

cleanupTests
