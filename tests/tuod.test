package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuod 0.1

proc writeBinaryTestFile {path bytes} {
    set fh [open $path wb]
    try {
        fconfigure $fh -translation binary -encoding iso8859-1
        puts -nonewline $fh $bytes
    } finally {
        close $fh
    }
    return $path
}

test tuod-1.1 {byte list unsigned} -body {
    ::tclutils::tuod::bytes [binary format c* {0 65 255}]
} -result {0 65 255}

test tuod-1.2 {octal default dump} -body {
    ::tclutils::tuod::data "ABC" -width 8
} -result {00000000  101 102 103}

test tuod-1.3 {hex dump without address} -body {
    ::tclutils::tuod::data "ABC" -format hex -address none
} -result {41 42 43}

test tuod-1.4 {offset and length} -body {
    ::tclutils::tuod::data "abcdef" -format char -offset 2 -length 3 -width 8
} -result {00000002  c d e}

set odFile [file join [temporaryDirectory] tuod-input.bin]
writeBinaryTestFile $odFile "ABCD"

test tuod-1.5 {file dump} -body {
    ::tclutils::tuod::file $odFile -format decimal -width 4
} -result {00000000  065 066 067 068}

catch {file delete -force $odFile}
cleanupTests
