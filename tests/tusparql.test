# tusparql.test -- tests for tclutils::tusparql.
#
# The SPARQL-specific logic (results-JSON flattening, ASK boolean, GET-URL
# assembly) is tested offline against fixtures. A real round-trip to a live
# endpoint is gated behind the `sparqlnet` constraint (env SPARQL_NET=1), since
# query.wikidata.org is not reachable in every environment.

package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
package require tclutils::tusparql 0.2
package require tclutils::tujson 0.1

testConstraint sparqlnet [expr {[info exists ::env(SPARQL_NET)] && $::env(SPARQL_NET)}]

set ::SEL {{"head":{"vars":["club","clubLabel","countryLabel"]},
 "results":{"bindings":[
   {"club":{"type":"uri","value":"http://www.wikidata.org/entity/Q15789"},
    "clubLabel":{"type":"literal","value":"FC Bayern Munich","xml:lang":"en"},
    "countryLabel":{"type":"literal","value":"Germany","xml:lang":"en"}},
   {"club":{"type":"uri","value":"http://www.wikidata.org/entity/Q5794"},
    "clubLabel":{"type":"literal","value":"Everton F.C.","xml:lang":"en"}}
 ]}}}

# ---------------------------------------------------------------------------
# offline logic
# ---------------------------------------------------------------------------
test tusparql-1.1 {_rows flattens bindings to value-only row dicts} -body {
    ::tclutils::tusparql::_rows [::tclutils::tujson::parse $::SEL]
} -result {{club http://www.wikidata.org/entity/Q15789 clubLabel {FC Bayern Munich} countryLabel Germany} {club http://www.wikidata.org/entity/Q5794 clubLabel {Everton F.C.}}}

test tusparql-1.2 {_rows omits variables that are unbound in a row} -body {
    set rows [::tclutils::tusparql::_rows [::tclutils::tujson::parse $::SEL]]
    list [dict exists [lindex $rows 1] countryLabel] [dict get [lindex $rows 0] countryLabel]
} -result {0 Germany}

test tusparql-1.3 {_rows on empty bindings is the empty list} -body {
    ::tclutils::tusparql::_rows [::tclutils::tujson::parse \
        {{"head":{"vars":["x"]},"results":{"bindings":[]}}}]
} -result {}

test tusparql-1.4 {_bool reads the ASK boolean} -body {
    list [::tclutils::tusparql::_bool [::tclutils::tujson::parse {{"head":{},"boolean":true}}]] \
         [::tclutils::tusparql::_bool [::tclutils::tujson::parse {{"head":{},"boolean":false}}]]
} -result {1 0}

test tusparql-1.5 {_bool on a non-ASK response errors with NOTASK} -body {
    catch {::tclutils::tusparql::_bool [::tclutils::tujson::parse {{"head":{"vars":[]}}}]} e o
    dict get $o -errorcode
} -result {TCLUTILS TUSPARQL NOTASK}

test tusparql-1.6 {_getUrl encodes the query and forces JSON} -body {
    set u [::tclutils::tusparql::_getUrl https://query.wikidata.org/sparql {SELECT ?x WHERE {}}]
    list [string match {https://query.wikidata.org/sparql?query=*} $u] \
         [string match {*format=json*} $u] \
         [string match {*%3Fx*} $u]
} -result {1 1 1}

test tusparql-1.7 {_getUrl appends with & to an endpoint with a query} -body {
    list [::tclutils::tusparql::_getUrl http://h/sparql?key=1 x] \
         [::tclutils::tusparql::_getUrl http://h/sparql? x]
} -result {http://h/sparql?key=1&query=x&format=json http://h/sparql?query=x&format=json}

test tusparql-1.8 {_rows without head vars takes the keys of all bindings} -body {
    ::tclutils::tusparql::_rows [::tclutils::tujson::parse {{"head":{},
        "results":{"bindings":[{"a":{"type":"literal","value":"1"}},
          {"a":{"type":"literal","value":"2"},
           "b":{"type":"literal","value":"3"}}]}}}]
} -result {{a 1} {a 2 b 3}}

test tusparql-1.9 {Accept: -accept by default, -headers wins, sent once} -body {
    set d {-method get -timeout 1 -headers {} -accept application/x}
    list [::tclutils::tusparql::_headers $d] \
         [::tclutils::tusparql::_headers \
              [dict replace $d -headers {X 1 accept text/csv}]] \
         [::tclutils::tusparql::_headers [dict replace $d -headers {X 1}]]
} -result {{Accept application/x} {X 1 accept text/csv} {X 1 Accept application/x}}

# ---------------------------------------------------------------------------
# live endpoint (only with SPARQL_NET=1)
# ---------------------------------------------------------------------------
test tusparql-2.1 {a real SELECT against Wikidata returns labelled rows} -constraints sparqlnet -body {
    # member associations of FIFA (Q207318) -- small, stable result set
    set q {SELECT ?item ?itemLabel WHERE {
        wd:Q207318 wdt:P527 ?item .
        SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
    } LIMIT 3}
    set rows [::tclutils::tusparql::query https://query.wikidata.org/sparql $q]
    expr {[llength $rows] > 0 && [dict exists [lindex $rows 0] itemLabel]}
} -result 1


# --- unreleased: a single head var that looks like a number -----------------
test tusparql-3.1 {_rows keeps a single numeric-looking head var as given} -body {
    set d [dict create head [dict create vars [list 010]] \
        results [dict create bindings [list [dict create 010 [dict create type literal value x]]]]]
    ::tclutils::tusparql::_rows $d
} -result {{010 x}}

cleanupTests
