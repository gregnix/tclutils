package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tutr 0.1

set tmp [makeDirectory tutr]
set f [makeFile "aabbcc" [file join $tmp input.txt]]

test tutr-1.1 {translate simple} -body {
    ::tclutils::tutr::translate abcabc abc xyz
} -result xyzxyz

test tutr-1.2 {translate range} -body {
    ::tclutils::tutr::translate {abc cab} a-c A-C
} -result {ABC CAB}

test tutr-1.3 {delete chars} -body {
    ::tclutils::tutr::delete {a1b2c3} 0-9
} -result abc

test tutr-1.4 {squeeze chars} -body {
    ::tclutils::tutr::squeeze aaabccc ac
} -result abc

test tutr-1.5 {file translate} -body {
    ::tclutils::tutr::file $f ab xy
} -result "xxyycc
"

cleanupTests
