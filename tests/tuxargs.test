package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file dirname [file dirname [file normalize [info script]]]]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuxargs 0.1

test tuxargs-1.1 {batches split by n} -body {
    ::tclutils::tuxargs::batches {a b c d e} -n 2
} -result {{a b} {c d} e}

test tuxargs-1.2 {skip empty by default} -body {
    ::tclutils::tuxargs::batches {a {} b} -n 10
} -result {{a b}}

test tuxargs-1.3 {preserve empty when requested} -body {
    ::tclutils::tuxargs::batches {a {} b} -n 10 -skipempty 0
} -result {{a {} b}}

proc ::joinBatch {args} { join $args , }

test tuxargs-1.4 {apply command prefix in batches} -body {
    ::tclutils::tuxargs::apply {a b c d} ::joinBatch -n 2
} -result {a,b c,d}

test tuxargs-1.5 {command alias} -body {
    ::tclutils::tuxargs::command {1 2 3} ::joinBatch -n 3
} -result {1,2,3}

cleanupTests
