# test-tuico.test -- tests for tclutils::tuico. No Tk, runs headless.

package require tcltest 2
namespace import ::tcltest::*

set here [file normalize [file dirname [info script]]]
::tcl::tm::path add $here
package require tclutils::tuico 0.1

# A minimal valid PNG of the given size, built by hand: signature, IHDR with
# the right dimensions, a stored (uncompressed) IDAT and IEND. Enough for the
# container tests, which only look at signature and IHDR.
proc makePng {size} {
    set signature "\x89PNG\r\n\x1a\n"

    set ihdrData [binary format IIccccc $size $size 8 6 0 0 0]
    set ihdr [chunk IHDR $ihdrData]

    # One zlib stream with a single stored block; contents are irrelevant here.
    set raw [string repeat "\x00" 16]
    set len [string length $raw]
    set stored [binary format cs 1 $len]
    append stored [binary format s [expr {~$len & 0xFFFF}]]
    append stored $raw
    set zlib "\x78\x01$stored[binary format I 1]"
    set idat [chunk IDAT $zlib]

    set iend [chunk IEND ""]
    return $signature$ihdr$idat$iend
}

proc chunk {type data} {
    set body $type$data
    set crc [zlib crc32 $body]
    return [binary format I [string length $data]]$body[binary format I $crc]
}

set tmpDir [makeDirectory tuico]

test tuico-1.1 {write returns byte count and creates the file} -setup {
    set out [file join $tmpDir a.ico]
} -body {
    set n [::tclutils::tuico::write $out [list [list 16 [makePng 16]]]]
    list [file exists $out] [expr {$n == [file size $out]}]
} -result {1 1} -cleanup {file delete -force $out}

test tuico-1.2 {header identifies an icon file} -setup {
    set out [file join $tmpDir b.ico]
    ::tclutils::tuico::write $out [list [list 32 [makePng 32]]]
} -body {
    set fh [open $out rb]
    binary scan [read $fh 6] sss reserved type count
    close $fh
    list $reserved $type $count
} -result {0 1 1} -cleanup {file delete -force $out}

test tuico-2.1 {info reports every entry} -setup {
    set out [file join $tmpDir c.ico]
    set entries {}
    foreach size {256 48 16} {
        lappend entries [list $size [makePng $size]]
    }
    ::tclutils::tuico::write $out $entries
} -body {
    set widths {}
    foreach entry [::tclutils::tuico::info $out] {
        lappend widths [dict get $entry width]
    }
    set widths
} -result {256 48 16} -cleanup {file delete -force $out}

test tuico-2.2 {a 256 pixel entry is stored as 0 and read back as 256} -setup {
    set out [file join $tmpDir d.ico]
    ::tclutils::tuico::write $out [list [list 256 [makePng 256]]]
} -body {
    set fh [open $out rb]
    seek $fh 6
    binary scan [read $fh 2] cucu storedWidth storedHeight
    close $fh
    set entry [lindex [::tclutils::tuico::info $out] 0]
    list $storedWidth $storedHeight [dict get $entry width] [dict get $entry height]
} -result {0 0 256 256} -cleanup {file delete -force $out}

test tuico-2.3 {info reports the payload format} -setup {
    set out [file join $tmpDir e.ico]
    ::tclutils::tuico::write $out [list [list 16 [makePng 16]]]
} -body {
    dict get [lindex [::tclutils::tuico::info $out] 0] format
} -result png -cleanup {file delete -force $out}

test tuico-3.1 {extract returns the payload unchanged} -setup {
    set out [file join $tmpDir f.ico]
    set png [makePng 32]
    ::tclutils::tuico::write $out [list [list 32 $png]]
} -body {
    expr {[::tclutils::tuico::extract $out 32] eq $png}
} -result 1 -cleanup {file delete -force $out}

test tuico-3.2 {extract writes a file when asked} -setup {
    set out [file join $tmpDir g.ico]
    set png [file join $tmpDir g.png]
    ::tclutils::tuico::write $out [list [list 16 [makePng 16]]]
} -body {
    ::tclutils::tuico::extract $out 16 $png
    file exists $png
} -result 1 -cleanup {file delete -force $out $png}

test tuico-4.1 {empty entry list is refused} -body {
    catch {::tclutils::tuico::write [file join $tmpDir h.ico] {}} message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO NOENTRIES}

test tuico-4.2 {a size outside 1..256 is refused} -body {
    catch {
        ::tclutils::tuico::write [file join $tmpDir i.ico] \
            [list [list 512 [makePng 16]]]
    } message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO BADSIZE}

test tuico-4.3 {a non-PNG payload is refused} -body {
    catch {
        ::tclutils::tuico::write [file join $tmpDir j.ico] \
            [list [list 16 "not a png at all"]]
    } message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO BADPNG}

test tuico-4.4 {payload dimensions must match the declared size} -body {
    catch {
        ::tclutils::tuico::write [file join $tmpDir k.ico] \
            [list [list 32 [makePng 16]]]
    } message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO SIZEMISMATCH}

test tuico-4.5 {a malformed entry is refused} -body {
    catch {
        ::tclutils::tuico::write [file join $tmpDir l.ico] {{16}}
    } message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO BADENTRY}

test tuico-4.6 {reading a non-icon file is refused} -setup {
    set plain [file join $tmpDir plain.bin]
    set fh [open $plain wb]
    puts -nonewline $fh [string repeat "\x00" 64]
    close $fh
} -body {
    catch {::tclutils::tuico::info $plain} message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO BADFILE} -cleanup {file delete -force $plain}

test tuico-4.7 {extracting a missing size is refused} -setup {
    set out [file join $tmpDir m.ico]
    ::tclutils::tuico::write $out [list [list 16 [makePng 16]]]
} -body {
    catch {::tclutils::tuico::extract $out 64} message options
    dict get $options -errorcode
} -result {TCLUTILS TUICO NOSUCHSIZE} -cleanup {file delete -force $out}

test tuico-5.1 {the ensemble is usable} -setup {
    set out [file join $tmpDir n.ico]
} -body {
    tclutils::tuico write $out [list [list 16 [makePng 16]]]
    llength [tclutils::tuico info $out]
} -result 1 -cleanup {file delete -force $out}

removeDirectory tuico
cleanupTests
