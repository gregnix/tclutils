package require tcltest
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
package require tclutils::tuxlsx 0.1
package require tclutils::tuzip 0.2

set tmp [makeDirectory tuxlsx]
set xlsx [file join $tmp t.xlsx]

# A workbook from raw parts, as Excel writes it: two sheets, shared strings
# with rich text and phonetic runs, an absolute relationship target.
proc excelLike {path} {
    set wb {<workbook xmlns="m" xmlns:r="r"><sheets><sheet name="Ger&#228;te" sheetId="1" r:id="rId1"/><sheet name="Zwei" sheetId="2" r:id="rId2"/></sheets></workbook>}
    set rels {<Relationships><Relationship Id="rId2" Type="x/worksheet" Target="/xl/worksheets/b.xml"/><Relationship Id="rId1" Type="x/worksheet" Target="worksheets/a.xml"/></Relationships>}
    set ss {<sst><si><t>Name</t></si><si><r><rPr><b/></rPr><t>Dru</t></r><r><t xml:space="preserve">cker &amp; Co</t></r></si><si><t>&#x6F22;</t><rPh sb="0" eb="1"><t>kan</t></rPh></si></sst>}
    set a {<worksheet><sheetData>
<row r="1"><c r="A1" t="s"><v>0</v></c><c r="B1" t="inlineStr"><is><t>Anzahl</t></is></c></row>
<row r="2" spans="1:3"><c r="A2" t="s" s="1"><v>1</v></c><c r="B2"><v>3</v></c><c r="C2"><v>12.5</v></c></row>
<row r="4"><c r="A4" t="s"><v>2</v></c><c r="D4" t="b"><v>1</v></c><c r="E4"><f>B2*2</f><v>6</v></c><c r="F4" t="str"><f>A1</f><v>Name</v></c><c r="G4" t="e"><v>#DIV/0!</v></c></row>
<row r="5"><c r="B5" s="2"><v>46325</v></c><c r="C5"/></row>
</sheetData></worksheet>}
    set b {<worksheet><cols><col min="1" max="2"/></cols><sheetData><row><c><v>1</v></c><c t="inlineStr"><is><t>&lt;b&gt;</t></is></c></row></sheetData></worksheet>}
    set m {}
    foreach {n c} [list xl/workbook.xml $wb xl/_rels/workbook.xml.rels $rels xl/sharedStrings.xml $ss \
            xl/worksheets/a.xml $a xl/worksheets/b.xml $b] {
        lappend m [dict create name $n content [encoding convertto utf-8 $c]]
    }
    ::tclutils::tuzip::createMembers $path $m -mtime 1262304000
    return $path
}

test tuxlsx-1.1 {writeRows: parts of a minimal workbook} -body {
    ::tclutils::tuxlsx::writeRows $xlsx {{a b} {1 2}}
    lsort [::tclutils::tuxlsx::parts $xlsx]
} -result {{[Content_Types].xml} _rels/.rels docProps/app.xml docProps/core.xml xl/_rels/workbook.xml.rels xl/styles.xml xl/workbook.xml xl/worksheets/sheet1.xml}

test tuxlsx-1.2 {round trip: text, numbers, gaps, empty row, umlauts, markup} -body {
    ::tclutils::tuxlsx::writeRows $xlsx [list {Name Wert} [list "x & <y>" -3.5] {} [list "" 1e3 "sp\u00e4t"]] -sheet Liste
    list [::tclutils::tuxlsx::sheets $xlsx] [::tclutils::tuxlsx::rows $xlsx]
} -result [list Liste [list {Name Wert} {{x & <y>} -3.5} {} [list {} 1e3 "sp\u00e4t"]]]

test tuxlsx-1.3 {-numbers auto stores numbers as numbers, -numbers 0 as text} -body {
    ::tclutils::tuxlsx::writeRows $xlsx {{007 12 1.5 1,5 -0}}
    set a [::tclutils::tuxlsx::part $xlsx xl/worksheets/sheet1.xml]
    ::tclutils::tuxlsx::writeRows $xlsx {{12}} -numbers 0
    set b [::tclutils::tuxlsx::part $xlsx xl/worksheets/sheet1.xml]
    list [regexp -all {<v>} $a] [string match {*<c r="A1" t="inlineStr">*007*} $a] \
         [string match {*<c r="D1" t="inlineStr">*} $a] [regexp -all {<v>} $b]
} -result {3 1 1 0}

test tuxlsx-1.6 {text that looks like a number stays as written: 007, 1,5, sheet 007} -body {
    ::tclutils::tuxlsx::writeRows $xlsx {{007 1,5 0x1F}} -sheet 007
    list [::tclutils::tuxlsx::sheets $xlsx] [::tclutils::tuxlsx::rows $xlsx]
} -result {007 {{007 1,5 0x1F}}}

test tuxlsx-1.4 {bad sheet names and options are errors} -body {
    set r {}
    foreach n [list "" a:b "x\[1\]" 'q [string repeat x 32]] {
        catch {::tclutils::tuxlsx::writeRows $xlsx {{1}} -sheet $n} m o
        lappend r [lindex [dict get $o -errorcode] 2]
    }
    catch {::tclutils::tuxlsx::writeRows $xlsx {{1}} -bogus 1} m o
    lappend r [lindex [dict get $o -errorcode] 2]
} -result {VALUE VALUE VALUE VALUE VALUE OPTION}

test tuxlsx-1.5 {column letters beyond Z} -body {
    set row [lrepeat 28 x]
    ::tclutils::tuxlsx::writeRows $xlsx [list $row]
    list [string match {*r="AB1"*} [::tclutils::tuxlsx::part $xlsx xl/worksheets/sheet1.xml]] \
         [llength [lindex [::tclutils::tuxlsx::rows $xlsx] 0]]
} -result {1 28}

test tuxlsx-2.1 {reading Excel XML: shared strings, rich text, phonetics, types, gaps} -body {
    ::tclutils::tuxlsx::rows [excelLike [file join $tmp e.xlsx]]
} -result [list {Name Anzahl} {{Drucker & Co} 3 12.5} {} [list \u6f22 {} {} 1 6 Name #DIV/0!] {{} 46325 {}}]

test tuxlsx-2.2 {sheets in workbook order; -sheet by name and by number} -body {
    set f [file join $tmp e.xlsx]
    list [::tclutils::tuxlsx::sheets $f] [::tclutils::tuxlsx::rows $f -sheet Zwei] \
         [::tclutils::tuxlsx::rows $f -sheet 2]
} -result [list [list "Ger\u00e4te" Zwei] {{1 <b>}} {{1 <b>}}]

test tuxlsx-2.3 {unknown sheet and missing part are errors} -body {
    set f [file join $tmp e.xlsx]
    catch {::tclutils::tuxlsx::rows $f -sheet Drei} m o
    set a [lrange [dict get $o -errorcode] 0 3]
    catch {::tclutils::tuxlsx::part $f xl/nix.xml} m o
    list $a [lrange [dict get $o -errorcode] 0 2]
} -result {{TCLUTILS TUXLSX SHEET Drei} {TCLUTILS TUXLSX PART}}

test tuxlsx-2.4 {text: tab between cells, newline between rows, empty line between sheets} -body {
    ::tclutils::tuxlsx::writeRows $xlsx {{a b} {c}}
    list [::tclutils::tuxlsx::text $xlsx] \
         [lindex [split [::tclutils::tuxlsx::text [file join $tmp e.xlsx]] \n] end]
} -result [list "a\tb\nc" "1\t<b>"]

test tuxlsx-2.5 {element names with a prefix, as the Open XML SDK writes them} -body {
    set ns http://schemas.openxmlformats.org/spreadsheetml/2006/main
    set m {}
    foreach {n c} [list \
        xl/workbook.xml "<x:workbook xmlns:x=\"$ns\"><x:sheets><x:sheet name=\"Daten\" sheetId=\"1\" r:id=\"R1\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"/></x:sheets></x:workbook>" \
        xl/_rels/workbook.xml.rels "\ufeff<?xml version=\"1.0\"?><pr:Relationships xmlns:pr=\"http://schemas.openxmlformats.org/package/2006/relationships\"><pr:Relationship Type=\"x/worksheet\" Target=\"/xl/worksheets/s.xml\" Id=\"R1\"/></pr:Relationships>" \
        xl/sharedStrings.xml "<x:sst xmlns:x=\"$ns\"><x:si><x:t>geteilt</x:t></x:si></x:sst>" \
        xl/worksheets/s.xml "<x:worksheet xmlns:x=\"$ns\"><x:sheetData><x:row r=\"1\"><x:c r=\"A1\" t=\"str\"><x:v>ID</x:v></x:c><x:c r=\"B1\" t=\"s\"><x:v>0</x:v></x:c><x:c r=\"C1\" t=\"n\"><x:v>10</x:v></x:c></x:row></x:sheetData></x:worksheet>"] {
        lappend m [dict create name $n content [encoding convertto utf-8 $c]]
    }
    set f [file join $tmp sdk.xlsx]
    ::tclutils::tuzip::createMembers $f $m -mtime 1262304000
    list [::tclutils::tuxlsx::sheets $f] [::tclutils::tuxlsx::rows $f]
} -result {Daten {{ID geteilt 10}}}

removeDirectory tuxlsx
cleanupTests
